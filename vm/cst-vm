#!/usr/bin/python3 -I
# SPDX-License-Identifier: MPL-2.0
"""cst-vm: copies of a libvirt VM (disks, UEFI variables, TPM state) taken
before a risky change, such as a Fedora major upgrade. It is the program
behind `cst vm` (vm-setup.sh).

Usage:
  backup [VM] --nas [--keep-tag NAME] [--no-quiesce]
                         (root) the default backup: to the NAS, with restic,
                         into the repository of the /home NAS backup (set up
                         by `cst btrfs snapshots nas setup`). A running VM
                         keeps running: a short-lived external snapshot (an
                         overlay file next to each disk) holds the guest's
                         writes while restic reads the disks, then
                         `virsh blockcommit` merges it back. With the QEMU
                         guest agent answering, the guest's file systems are
                         frozen for that instant (--quiesce); else, or with
                         --no-quiesce, the copy is crash-consistent (as after
                         a power cut). A shut-off VM is read directly.
                         Backs up the disks, the UEFI variables, the TPM
                         state, the definition and a manifest; then keeps
                         VM_NAS_KEEP_WEEKLY (4) weekly and VM_NAS_KEEP_MONTHLY
                         (3) monthly restic snapshots of the VM (restic
                         forget; the /home NAS job prunes). --keep-tag NAME:
                         tags it cst-keep and NAME, kept until you forget it
  backup [VM] [--full]   (root) copy the VM while it is shut off (not
                         saved; checked again after the copy):
                         every file disk, the UEFI variables (NVRAM), the
                         software TPM state, the definition (XML) and a
                         manifest, to
                         /var/lib/libvirt/cst-backups/VM/YYYYmmddTHHMMSSZ/.
                         Default: reflink copies (instant on btrfs; they
                         share blocks with the originals, so they protect
                         against a repair tool or an upgrade writing to the
                         image, NOT against losing the disks or the
                         filesystem). --full: real copies (needs free space
                         for the allocated size). Prints how to restore;
                         never restores by itself
  backup-timer on|off|status [VM]
                         the weekly `backup VM --nas` (Saturday 04:30):
                         on/off (root) install or remove
                         cst-vm-backup@.service/.timer and the program copy
                         /usr/local/sbin/cst-vm; status: whether it is on,
                         up to date, and when it runs next
  list [VM]              the backups, from /var/lib/cst/vm-backups.json
                         (readable by every user)
  status [VM]            the VM's state, its CPU mode and whether the CET/MBEC
                         features are disabled, whether its disks and network
                         card match `tune`, the last backup, whether the
                         virtualization packages changed since then, and the
                         NOCOW state of the VM image folders
  tune plan [VM] [--guest-has-virtio]
                         the changes to the definition that give the VM the
                         recommended virtual hardware: disks on virtio-scsi,
                         cache='none' io='native' discard='unmap'
                         detect_zeroes='unmap', network card virtio (same
                         MAC). For a Windows guest (or one not known to be
                         Linux), the bus and network card changes need
                         --guest-has-virtio: the virtio drivers must be in
                         the guest first. Changes nothing
  tune apply [VM] [--guest-has-virtio]
                         (root) the same, asks, saves the old definition and
                         runs `virsh define`: effective at the VM's next start
  nocow plan [--root]    the VM image folders (libvirt system and session,
                         GNOME Boxes RPM and Flatpak): btrfs, NOCOW mark (+C),
                         and the images in them still copy-on-write, with the
                         commands to convert each. --root: through sudo, to
                         read the root-only system folder. Changes nothing
  nocow apply            sets +C on those folders (sudo for the system one;
                         creates /var/lib/libvirt/images when libvirt is
                         installed). Never converts an existing image
  help

VM defaults to VM_NAME in /etc/cpu-setup/cpu-setup.conf (win11-devbox).
Settings (all optional): /etc/cst/vm.conf with VM_NOCOW, VM_TUNE_DISK_BUS,
VM_TUNE_DISK_DRIVER, VM_TUNE_NIC (yes or no, default yes), and for the NAS
backup VM_NAS_KEEP_WEEKLY (4), VM_NAS_KEEP_MONTHLY (3), VM_NAS_TIMEOUT_HOURS (6).
Exit status: 0 fine, 1 refused or failed, 2 usage.
"""

import os.path as _cst_path
import sys as _cst_sys

# CST bootstrap (the same in every entry point; tests/test_entrypoints.py checks
# it): from a checkout, cst_core and the module packages are in the folder above
# this file, and Python writes no bytecode there (no __pycache__ in the checkout,
# even for a program run by its shebang as root); inside an installed zipapp,
# sys.path already holds the archive.
_cst_root = _cst_path.dirname(_cst_path.dirname(_cst_path.realpath(__file__)))
if not _cst_path.isfile(_cst_path.dirname(__file__)) and _cst_root not in _cst_sys.path:
    _cst_sys.dont_write_bytecode = True
    _cst_sys.path.insert(0, _cst_root)

import sys

from vm import cli


def main() -> int:
    """Run `cst vm` with this program's arguments."""
    return cli.main(sys.argv[1:], doc=__doc__ or "", entry_file=__file__)


if __name__ == "__main__":
    sys.exit(main())
