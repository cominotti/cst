    return now, datetime.datetime.fromtimestamp(now, datetime.UTC).strftime("%Y%m%dT%H%M%SZ")


# ---- what the domain is made of -----------------------------------------------------------------
def domain_parts(xml_text):
    """From the inactive definition: {uuid, disks: [path], nvram, tpm, skipped,
    problems}. problems are disks a file copy cannot back up (block, network,
    pool volumes): the backup refuses then, rather than leaving one out."""
    root = ET.fromstring(xml_text)
    out = {
        "uuid": (root.findtext("uuid") or "").strip(),
        "disks": [],
        "nvram": "",
        "tpm": False,
        "skipped": [],
        "problems": [],
    }
    for disk in root.findall("devices/disk"):
        device = disk.get("device", "disk")
        kind = disk.get("type", "file")
        target = disk.find("target")
        dev = target.get("dev") if target is not None else "?"
        src = disk.find("source")
        if device in ("cdrom", "floppy"):
            out["skipped"].append(f"{dev} ({device}, not copied)")
            continue
        if kind != "file":
            where = ""
            if src is not None:
                where = src.get("dev") or src.get("name") or src.get("volume") or src.get("dir") or ""
            out["problems"].append(
                f"{dev}: a {kind} disk{f' ({where})' if where else ''}: only file disks "
                "can be copied; back it up by hand"
            )
            continue
        path = src.get("file") if src is not None else None
        if not path:
            out["skipped"].append(f"{dev} (no source file)")
            continue
        if path not in out["disks"]:
            out["disks"].append(path)
    nv = root.find("os/nvram")
    if nv is not None:
        path = (nv.text or "").strip()
        s = nv.find("source")
        if not path and s is not None:
            path = s.get("file") or ""
        out["nvram"] = path
    out["tpm"] = any(b.get("type") == "emulator" for b in root.findall("devices/tpm/backend"))
    return out


def qcow2_backing_file(path):
    """True when path is a qcow2 image with a backing file (an overlay: the
    copy would be useless without the base), False otherwise."""
    try:
        with open(path, "rb") as f:
            head = f.read(16)
    except OSError:
        return False
    return len(head) == 16 and head[:4] == b"QFI\xfb" and struct.unpack(">Q", head[8:16])[0] != 0


def fingerprint(path):
    """What changes when something writes to a file or a folder tree, or when
    libvirt relabels it on start (ctime): compared before and after the copy."""

    def one(p):
        st = os.lstat(p)
        return (st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)

    if os.path.isdir(path) and not os.path.islink(path):
        out = [("", one(path))]
        for d, dirs, files in os.walk(path):
            dirs.sort()
            for n in sorted(dirs + files):
                q = os.path.join(d, n)
                try:
                    out.append((os.path.relpath(q, path), one(q)))
                except OSError:
                    out.append((os.path.relpath(q, path), None))
        return tuple(out)
    return one(path)


def tree_sizes(path):
    """(allocated, apparent) bytes of a file or a folder tree."""
    alloc = apparent = 0
    if os.path.isdir(path) and not os.path.islink(path):
        for d, _, files in os.walk(path):
            for n in files:
                try:
                    st = os.lstat(os.path.join(d, n))
                except OSError:
                    continue
                alloc += st.st_blocks * 512
                apparent += st.st_size
        return alloc, apparent
    st = os.stat(path)
    return st.st_blocks * 512, st.st_size


def package_versions():
    """{package: name-version-release.arch or "not installed"}, one rpm -q each
    (its exit code tells whether it is installed)."""
    out = {}
    for p in VIRT_PACKAGES:
        rc, so, _ = run(["rpm", "-q", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\\n", p], timeout=30)
        out[p] = first_line(so) if rc == 0 and first_line(so) else NOT_INSTALLED
    return out


def booted_deployment():
    """{version, checksum, timestamp} of the booted rpm-ostree deployment, or None."""
    rc, so, _ = run(["rpm-ostree", "status", "--json"], timeout=60)
    if rc != 0:
        return None
    try:
        deps = json.loads(so).get("deployments") or []
        d = next(x for x in deps if isinstance(x, dict) and x.get("booted"))
    except ValueError, StopIteration, AttributeError:
        return None
    return {"version": d.get("version"), "checksum": d.get("checksum"), "timestamp": d.get("timestamp")}


# ---- the index (world-readable, no secrets) ------------------------------------------------------
def read_index(path=None):
    path = path or INDEX
    try:
        with open(path) as f:
            data = json.load(f)
    except OSError, ValueError:
        return []
    entries = data.get("backups") if isinstance(data, dict) else None
    return [
        e
        for e in entries or []
        if isinstance(e, dict) and e.get("vm") and (e.get("path") or e.get("mode") == "nas" and e.get("snapshot"))
    ]


def write_index(entries, path=None):
    """Atomically (temporary file + rename), mode 0644, folder 0755."""
    path = path or INDEX
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    os.chmod(d, 0o755)
    fd, tmp = tempfile.mkstemp(prefix=".vm-backups.", suffix=".tmp", dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({"version": 1, "backups": entries}, f, indent=2, sort_keys=True)
            f.write("\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def index_entry(manifest, path):
    return {
        "vm": manifest["vm"],
        "timestamp": manifest["timestamp"],
        "epoch": manifest["epoch"],
        "path": path,
        "mode": manifest["mode"],
        "versions": manifest["versions"],
        "deployment": manifest["deployment"],
    }


# ---- backup ----------------------------------------------------------------------------------
def nocow(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return False
    try:
        buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("l", 0))
        return bool(struct.unpack("l", buf)[0] & FS_NOCOW_FL)
    except OSError:
        return False
    finally:
        os.close(fd)


def precreate_nocow(dest):
    """btrfs clones only between files with the same NOCOW flag: an empty
    destination with the flag set, which cp then fills. Best effort."""
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("l", 0))
        flags = struct.unpack("l", buf)[0] | FS_NOCOW_FL
        fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("l", flags))
    except OSError:
        pass
    finally:
        os.close(fd)


def copy(src, dest, mode, big):
    """Copy src (a file or a folder) to dest with cp -a. Disks (big) follow
    the mode; the small parts (UEFI variables, TPM state) are plain copies."""
    os.makedirs(os.path.dirname(dest), mode=0o700, exist_ok=True)
    if not big:
        flags = ["--reflink=never"] if mode == "full" else []
    elif mode == "reflink":
        flags = ["--reflink=always"]  # cp allows --reflink only with --sparse=auto
        if os.path.isfile(src) and nocow(src):
            precreate_nocow(dest)
    else:
        # --sparse=auto keeps the source's holes only. --sparse=always also turns
        # every run of zero blocks inside the data into a hole: a 92 GiB image
        # became 1.05 million extents (the source had 0.6 million), and the guest
        # writing into those holes allocates new extents even on a NOCOW file.
        flags = ["--reflink=never", "--sparse=auto"]
    rc, _, err = run(["cp", *flags, "-a", "--", src, dest], timeout=6 * 3600)
    if rc != 0:
        raise Refused(
            f"cp {' '.join(flags)} {src}: {first_line(err) or f'exit {rc}'}"
            + (
                f"\nReflink copies need the backup folder on the same btrfs filesystem as the "
                f"disks. Use real copies instead: {PROG} backup VM --full"
                if big and mode == "reflink"
                else ""
            )
        )


def stored(dest_dir, src):
    """Where a source path is kept inside the backup: its absolute path
    under files/, so names never collide and restoring is one cp each."""
    return os.path.join(dest_dir, "files", src.lstrip("/"))


def restore_lines(vm, dest_dir, copied, tpm_dir):
    q = shlex.quote
    lines = [
        f"# 1. the VM must be shut off: virsh -c {URI} domstate {q(vm)}",
        "# 2. the files back (each line replaces the current file):",
    ]
    for src, _ in copied:
        if src == tpm_dir:
            lines.append(f"sudo rm -rf {q(src)} && sudo cp -a {q(stored(dest_dir, src))} {q(os.path.dirname(src))}/")
        else:
            lines.append(f"sudo cp --reflink=auto -a {q(stored(dest_dir, src))} {q(src)}")
    lines += [
        "# 3. the definition (CPU, pinning, devices) as it was:",
        f"sudo virsh -c {URI} define {q(os.path.join(dest_dir, 'domain.xml'))}",
    ]
    return lines


def check_shut_off(vm):
    """Refused unless the VM is shut off AND has no managed-save image: after
    `virsh managedsave` (virt-manager's Save) domstate also says "shut off",
    but the guest's disks are only consistent with the saved RAM."""
    rc, so, err = virsh("domstate", vm)
    if rc != 0:
        raise Refused(f"virsh domstate {vm}: {first_line(err) or f'exit {rc}'}")
    state = first_line(so)
    if state != "shut off":
        raise Refused(
            f"{vm} is {state or 'in an unknown state'}: shut it down first (a copy of a running "
            f"VM is not consistent). From Windows, or: virsh -c {URI} shutdown {vm}"
        )
    if has_managed_save(vm):
        raise Refused(
            f"{vm} was saved (managed save), not shut down: its disks are only consistent with "
            f"the saved memory. Start it and shut Windows down, then run the backup again "
            f"(or drop the saved memory: virsh -c {URI} managedsave-remove {vm})"
        )


def cmd_backup(vm, full):
    if os.geteuid() != 0 and not os.environ.get("CST_VM_NONROOT_OK"):
        raise Refused("backup needs root: run it as `cst vm backup` (it calls sudo by itself)")
    check_shut_off(vm)
    rc, xml_text, err = virsh("dumpxml", "--inactive", "--security-info", vm)
    if rc != 0:
        raise Refused(f"virsh dumpxml {vm}: {first_line(err) or f'exit {rc}'}")
    parts = domain_parts(xml_text)
    if parts["problems"]:
        raise Refused(f"{vm}: nothing copied:\n  " + "\n  ".join(parts["problems"]))
    if not parts["disks"]:
        raise Refused(f"{vm}: no file disk in its definition: nothing to back up")
    notes = list(parts["skipped"])

    def real(path, what):
        # cp -a copies a symbolic link as a link (no data): the file it points
        # to is what gets copied, and restored, instead.
        r = os.path.realpath(path)
        if r != path:
            notes.append(f"{what} {path} is a symbolic link: copied (and restored) through it: {r}")
        return r

    sources = []
    for p in parts["disks"]:
        if not os.path.isfile(p):
            raise Refused(f"{vm}: disk {p} not found")
        p = real(p, "disk")
        if qcow2_backing_file(p):
            raise Refused(
                f"{vm}: {p} is a qcow2 overlay with a backing file: back up the chain by hand "
                "(qemu-img info --backing-chain)"
            )
        if (p, True) not in sources:
            sources.append((p, True))
    if parts["nvram"]:
        if os.path.isfile(parts["nvram"]):
            sources.append((real(parts["nvram"], "UEFI variables"), False))
        else:
            notes.append(f"UEFI variables {parts['nvram']} not there yet (the VM never started?): not copied")
    tpm_dir = ""
    if parts["tpm"]:
        tpm_dir = os.path.join(SWTPM_DIR, parts["uuid"])
        if parts["uuid"] and os.path.isdir(tpm_dir):
            tpm_dir = real(tpm_dir, "TPM state")
            sources.append((tpm_dir, False))
        else:
            notes.append(
                f"TPM state {tpm_dir} not found: not copied (BitLocker may then ask for its "
                "recovery key after a restore)"
            )
    mode = "full" if full else "reflink"
    epoch, stamp = utc_now()
    vm_dir = os.path.join(BACKUP_DIR, vm)
    dest_dir = os.path.join(vm_dir, stamp)
    if os.path.exists(dest_dir):
        raise Refused(f"{dest_dir} already exists: wait a second and run it again")
    sizes = {p: tree_sizes(p) for p, _ in sources}
    if full:
        need = sum(a for a, _ in sizes.values())
        margin = max(FULL_MARGIN[0], int(need * FULL_MARGIN[1]))
        probe = BACKUP_DIR
        while not os.path.exists(probe):
            probe = os.path.dirname(probe)
        st = os.statvfs(probe)
        free = st.f_bavail * st.f_frsize
        if free < need + margin:
            raise Refused(
                f"--full needs {human(need)} (allocated size) + {human(margin)} margin, but "
                f"{probe} has {human(free)} free: free space first, or use the default reflink copy"
            )
    for d in (BACKUP_DIR, vm_dir):
        os.makedirs(d, mode=0o700, exist_ok=True)
        os.chmod(d, 0o700)
    os.mkdir(dest_dir, 0o700)
    print(f"{vm}: {mode} backup to {dest_dir}")
    copied = []
    try:
        before = {p: fingerprint(p) for p, _ in sources}
        for src, big in sources:
            a, s = sizes[src]
            print(f"  copying {src} ({human(a)} allocated, {human(s)} apparent)", flush=True)
            copy(src, stored(dest_dir, src), mode, big)
            copied.append((src, big))
        # Nothing stops the VM from starting during a long copy: check again,
        # and that no source changed while it was read.
        try:
            check_shut_off(vm)
        except Refused as e:
            raise Refused(f"the VM's state changed during the copy, the copy is not consistent: {e}") from e

        def now_fp(p):
            try:
                return fingerprint(p)
            except OSError:
                return None  # removed during the copy: changed as well

        changed = [p for p, _ in sources if now_fp(p) != before[p]]
        if changed:
            raise Refused(
                "changed during the copy (the VM was started?), the copy is not consistent: "
                + ", ".join(changed)
                + ". Shut the VM off and run the backup again"
            )
        # The definition holds --security-info secrets (graphics passwords): 0600 from the start.
        with os.fdopen(
            os.open(os.path.join(dest_dir, "domain.xml"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w"
        ) as f:
            f.write(xml_text)
        manifest = {
            "vm": vm,
            "uuid": parts["uuid"],
            "timestamp": stamp,
            "epoch": int(epoch),
            "mode": mode,
            "files": [
                {
                    "source": src,
                    "stored": os.path.relpath(stored(dest_dir, src), dest_dir),
                    "kind": "disk" if big else ("tpm" if src == tpm_dir else "nvram"),
                    "allocated": sizes[src][0],
                    "apparent": sizes[src][1],
                }
                for src, big in copied
            ],
            "versions": package_versions(),
            "deployment": booted_deployment(),
            "notes": notes,
        }
        with os.fdopen(
            os.open(os.path.join(dest_dir, "manifest.json"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w"
        ) as f:
            json.dump(manifest, f, indent=2, sort_keys=True)
            f.write("\n")
    except BaseException:
        shutil.rmtree(dest_dir, ignore_errors=True)
        print(f"  incomplete backup removed: {dest_dir}", file=sys.stderr)
        raise
    # Entries whose folder was removed by hand leave the index here.
    entries = [e for e in read_index() if e.get("mode") == "nas" or os.path.isdir(e["path"]) and e["path"] != dest_dir]
    entries.append(index_entry(manifest, dest_dir))
    entries.sort(key=lambda e: (e["vm"], e.get("epoch") or 0))
    write_index(entries)
    for n in notes:
        print(f"  note: {n}")
    print(f"Done: {len(copied)} item(s), definition and manifest in {dest_dir}")
    if mode == "reflink":
        print(
            "Reflink copies share disk blocks with the VM: they protect against changes to the image "
            "(a repair tool, an upgrade), not against losing the disks. For that: --full, or a copy "
            "on another machine."
        )
    print("\nTo restore (never done automatically; read each line first):")
    for line in restore_lines(vm, dest_dir, copied, tpm_dir):
        print(f"  {line}")
    print(
        f"\nRemove an old backup by hand: sudo rm -r {shlex.quote(vm_dir)}/TIMESTAMP "
        f"(the next backup drops it from {CST} vm list)"
    )
    return 0


# ---- backup to the NAS (restic) ---------------------------------------------------------------
class Stop(Exception):
    """SIGTERM/SIGHUP/SIGINT (systemd stopping the unit, a closed terminal,
    Ctrl-C): raised so the overlays are always committed back before the
    program ends."""


class Uncertain(Refused):
    """virsh snapshot-create-as did not answer in time and libvirt's result
    stayed unclear: the overlay files are kept, an alert is sent."""


STOP_SIGNALS = (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)


def on_signal(signum, _frame):
    # A second signal must not cut the cleanup short: ignored from here on.
    for s in STOP_SIGNALS:
        signal.signal(s, signal.SIG_IGN)
    raise Stop(f"stopped by signal {signal.Signals(signum).name}")


class signals_held:
    """SIGTERM, SIGHUP and SIGINT wait (blocked) until the block ends, so a
    stop never kills `virsh snapshot-create-as` while libvirt goes on making
    the snapshot: the run then always knows what the VM runs on."""

    def __enter__(self):
        self.old = signal.pthread_sigmask(signal.SIG_BLOCK, STOP_SIGNALS)
        return self

    def __exit__(self, *_):
        signal.pthread_sigmask(signal.SIG_SETMASK, self.old)


class SafeStream:
    """stdout/stderr of a NAS backup: a closed terminal (EIO) or a reader
    that went away (EPIPE: `| head`) must never cut the merge back or the
    alert short. On the first failed write both fds go to /dev/null."""

    def __init__(self, inner):
        self.inner = inner

    def write(self, text):
        try:
            return self.inner.write(text)
        except OSError, ValueError:
            mute()
            return len(text)

    def flush(self):
        try:
            self.inner.flush()
        except OSError, ValueError:
            mute()

    def __getattr__(self, name):
        return getattr(self.inner, name)


def mute():
    try:
        fd = os.open(os.devnull, os.O_WRONLY)
    except OSError:
        return
    for n in (1, 2):
        try:
            os.dup2(fd, n)
        except OSError:
            pass
    os.close(fd)


def safe_output():
    if not isinstance(sys.stdout, SafeStream):
        sys.stdout, sys.stderr = SafeStream(sys.stdout), SafeStream(sys.stderr)


def conf_number(key, path=None):
    """A whole number of /etc/cst/vm.conf (NAS_DEFAULTS when missing or not a number >= 0)."""
    v = read_conf(path or VM_CONF).get(key, "")
    return int(v) if v.isdigit() else NAS_DEFAULTS[key]


def nas_settings():
    """{host, env, repo} for restic, from the /home NAS backup's settings.
    Refused when that backup is not set up: its setup creates the
    repository, the SSH key and the password file this one reuses."""
    conf = read_conf(NAS_CONF)
    setup = f"{CST} btrfs snapshots nas setup"
    if conf.get("NAS_ENABLED") != "1" or not conf.get("NAS_PATH"):
        raise Refused(
            f"the NAS backup is not set up ({NAS_CONF}: NAS_ENABLED=1 and NAS_PATH are needed). "
            f"Set it up first: {setup} (the VM backup shares its restic repository)"
        )
    try:
        if os.path.getsize(RESTIC_PASSWORD) == 0:
            raise OSError
    except OSError:
        raise Refused(
            f"{RESTIC_PASSWORD} is missing or empty: run {setup} again (or put the saved repository password there)"
        ) from None
    host = conf.get("NAS_RESTIC_HOST") or socket.gethostname().split(".")[0]
    repo = f"sftp:{NAS_SSH_ALIAS}:{conf['NAS_PATH']}"
    return {
        "host": host,
        "repo": repo,
        "env": {"RESTIC_REPOSITORY": repo, "RESTIC_PASSWORD_FILE": RESTIC_PASSWORD, "RESTIC_CACHE_DIR": RESTIC_CACHE},
    }


def restic(nas, *args, timeout=1800):
    return run(["restic", *args], timeout=timeout, extra_env=nas["env"])


def restic_ready(nas):
    """Refused unless the repository opens (NAS reachable, password right):
    checked before any snapshot, so an unreachable NAS never leaves the VM
    on an overlay."""
    # --no-lock: it only proves the repository opens, also while the /home
    # NAS job holds the lock (its prune), which the backup waits for.
    rc, _, err = restic(nas, "cat", "config", "--no-lock", timeout=300)
    if rc == 0:
        return
    why = {
        127: "restic is not installed (it comes with the NAS setup; after rpm-ostree, active at the next reboot)",
        124: "the NAS did not answer within 5 minutes",
        10: f"no restic repository at {nas['repo']}",
        11: "the repository is locked (try again later)",
        12: f"{RESTIC_PASSWORD} does not open the repository",
    }.get(rc, first_line(err) or f"restic exit {rc}")
    raise Refused(f"NAS repository not usable: {why}. Nothing was changed (no snapshot taken)")


def restic_backup(nas, args, timeout):
    """restic backup --json: stderr goes through, the status lines become a
    progress line every minute, the summary is kept. (rc, summary or {})."""
    env = {**os.environ, "LC_ALL": "C", **nas["env"]}
    try:
        p = subprocess.Popen(["restic", *args], stdout=subprocess.PIPE, stdin=subprocess.DEVNULL, text=True, env=env)
    except FileNotFoundError:
        return 127, {}
    timer = threading.Timer(timeout, p.kill)
    timer.start()
    summary, shown = {}, 0.0
    try:
        for line in p.stdout:
            try:
                msg = json.loads(line)
            except ValueError:
                print(f"  restic: {line.rstrip()}", flush=True)
                continue
            if not isinstance(msg, dict):
                continue
            kind = msg.get("message_type")
            if kind == "summary":
                summary = msg
            elif kind == "status" and time.monotonic() - shown >= 60:
                shown = time.monotonic()
                done, total = msg.get("bytes_done") or 0, msg.get("total_bytes") or 0
                print(
                    f"  restic: {100 * float(msg.get('percent_done') or 0):.0f} % ({human(done)} of "
                    f"{human(total)} read)",
                    flush=True,
                )
            elif kind == "error":
                err = msg.get("error") or {}
                print(f"  restic error: {msg.get('item') or ''} {err.get('message') or err}", file=sys.stderr)
        rc = p.wait()
    except BaseException:
        p.terminate()
        try:
            p.wait(60)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
        raise
    finally:
        timer.cancel()
    if rc == -signal.SIGKILL:
        rc = 124
    return rc, summary


def live_disks(xml_text):
    """[{target, device, type, source, backing}] of a definition's disks;
    backing: the live definition shows a backing chain (an overlay)."""
    out = []
    for disk in ET.fromstring(xml_text).findall("devices/disk"):
        t, s, bs = disk.find("target"), disk.find("source"), disk.find("backingStore")
        src = ""
        if s is not None:
            src = s.get("file") or s.get("dev") or s.get("name") or s.get("volume") or ""
        out.append(
            {
                "target": t.get("dev") if t is not None else "",
                "device": disk.get("device", "disk"),
                "type": disk.get("type", "file"),
                "source": src,
                "backing": bs is not None and bs.find("source") is not None,
            }
        )
    return out


def agent_state(xml_text):
    """ "connected", "disconnected" or "none": the guest agent channel
    (org.qemu.guest_agent.0) of the live definition."""
    for ch in ET.fromstring(xml_text).findall("devices/channel"):
        t = ch.find("target")
        if t is not None and t.get("name") == "org.qemu.guest_agent.0":
            return "connected" if t.get("state") == "connected" else "disconnected"
    return "none"


def blklist(vm, inactive=False):
    """({target: source}, problem) from virsh domblklist --details."""
    rc, so, err = virsh("domblklist", vm, "--details", *(["--inactive"] if inactive else []))
    if rc != 0:
        return None, first_line(err) or f"exit {rc}"
    out = {}
    for ln in so.splitlines():
        parts = ln.split(None, 3)
        if len(parts) == 4 and parts[0] != "Type" and not parts[0].startswith("-"):
            out[parts[2]] = parts[3].strip()
    return out, ""


def overlay_kind(state, live_src, base):
    """How a disk left on an overlay is put back by hand:
    live: QEMU still runs on the overlay (running, paused, pmsuspended);
    definition: the running VM is back on the image, only its persistent
    definition names the overlay, which is now stale: never commit it;
    offline: shut off before any merge (this run knows none happened), so
    the overlay holds the guest's last writes;
    unknown: the state could not be read."""
    if state in LIVE_STATES:
        return "definition" if live_src == base else "live"
    if state in ("shut off", "crashed"):
        return "offline"
    return "unknown"


def overlay_recovery(vm, items, how):
    """The commands that put a disk back on its image by hand."""
    q = shlex.quote
    v = f"sudo virsh -c {URI}"
    lines = []
    for t, (base, overlay) in items:
        kind = how.get(t, "unknown")
        if kind == "live":
            lines += [
                f"# {t}: the VM still runs on {overlay}",
                f"{v} blockjob {q(vm)} {t} --info     # a commit still running? let it finish",
                f"{v} blockjob {q(vm)} {t} --pivot     # only if --info shows the commit ready (100 %) "
                "and nothing waits on it",
                f"{v} blockcommit {q(vm)} {t} --active --pivot --wait --verbose     # only if no block job is listed",
                f"{v} domblklist {q(vm)} --details     # {t} must show {base}",
                f"{v} domblklist {q(vm)} --details --inactive     # here too",
                f"sudo rm {q(overlay)}     # only once both show {base}",
            ]
        elif kind == "definition":
            lines += [
                f"# {t}: the VM is back on {base}; only its definition still names {overlay}, which is "
                "stale now: do NOT qemu-img commit it (that would overwrite newer data in the image)",
                f"{v} edit {q(vm)}     # disk {t}: <source file='{base}'/>, and remove its <backingStore> element",
                f"{v} domblklist {q(vm)} --details --inactive     # {t} must show {base}",
                f"sudo rm {q(overlay)}     # only once it shows {base}",
            ]
        elif kind == "offline":
            lines += [
                f"# {t}: {vm} is shut off on {overlay}, which holds the guest's last writes: merge it "
                "offline, then point the definition back",
                f"sudo qemu-img commit -p {q(overlay)}     # writes its changes into {base}",
                f"{v} edit {q(vm)}     # disk {t}: <source file='{base}'/>, and remove its <backingStore> element",
                f"{v} domblklist {q(vm)} --details --inactive     # {t} must show {base}",
                f"sudo rm {q(overlay)}",
            ]
        else:
            lines += [
                f"# {t}: the VM's state or the files could not be read: look first, then follow "
                'vm/README.md in CST, "If a backup left an overlay"',
                f"{v} domstate {q(vm)}",
                f"{v} domblklist {q(vm)} --details",
                f"{v} domblklist {q(vm)} --details --inactive",
                f"sudo ls -l --time-style=full-iso {q(base)} {q(overlay)}",
            ]
    return lines


def notify(urgency, title, body):
    """A CST desktop alert (btrfs-notify keeps it for the next login when no
    session shows it). Sent first, then printed (best effort)."""
    if os.access(NOTIFY, os.X_OK):
        run([NOTIFY, "-u", urgency, "-a", NAME, title, body], timeout=60, detach=True)
    print(f"{title}: {body}", file=sys.stderr)


def commit_back(vm, overlaid):
    """virsh blockcommit --active --pivot for each overlay (also on a paused
    VM), then a check of the live and the persistent definition, then the
    overlay file removed. Returns (problems, {target: how to recover}); no
    problems: every disk is back on its image."""
    problems, how = [], {}
    state = domain_state_or_none(vm)
    if state not in LIVE_STATES:
        problems.append(
            f"{vm} stopped during the backup: its disks still point to the overlay files"
            if state in ("shut off", "crashed")
            else f"the state of {vm} could not be read ({state or 'virsh domstate failed'}): nothing merged"
        )
        for t, (base, _overlay) in overlaid.items():
            how[t] = overlay_kind(state, None, base)
        return problems, how
    if state != "running":
        print(f"  {vm} is {state}: merging back anyway (a block job works on it)", flush=True)
    deadline = time.monotonic() + COMMIT_TIMEOUT
    for t, (base, _overlay) in overlaid.items():
        left = max(60, int(deadline - time.monotonic()))
        print(f"  merging the overlay of {t} back into {base} (virsh blockcommit --active --pivot)", flush=True)
        # --timeout: virsh aborts the job itself (the disk stays on the overlay, no job
        # left half done) before the timer's TimeoutStopSec could kill it.
        rc, so, err = virsh(
            "blockcommit",
            vm,
            t,
            "--active",
            "--pivot",
            "--wait",
            "--verbose",
            "--timeout",
            str(left),
            timeout=left + 300,
        )
        if rc != 0:
            problems.append(f"{t}: virsh blockcommit: {first_line(err) or first_line(so) or f'exit {rc}'}")
    live, lerr = blklist(vm)
    persistent, perr = blklist(vm, inactive=True)
    for t, (base, overlay) in overlaid.items():
        live_src = live.get(t) if live is not None else None
        if live is None:
            problems.append(f"{t}: virsh domblklist: {lerr}")
        elif live_src != base:
            problems.append(f"{t}: the running VM still uses {live_src or '?'} (expected {base})")
        elif persistent is not None and persistent.get(t) != base:
            problems.append(
                f"{t}: the definition still names {persistent.get(t) or '?'} (expected {base}): "
                "the VM would start on that stale overlay"
            )
        elif persistent is None:
            problems.append(
                f"{t}: the persistent definition was not readable ({perr}): the overlay is kept "
                "until both listings show the image"
            )
        else:
            try:
                os.unlink(overlay)
            except FileNotFoundError:
                pass
            except OSError as e:
                print(f"  note: {overlay}: not removed ({e.strerror}); {t} is back on {base}: remove it by hand")
            continue
        how[t] = overlay_kind(state, live_src, base)
    return problems, how


def find_overlays(vm, specs):
    """{target: (image, overlay)} of this run's overlays that the running VM
    or its definition names, or whose file exists when neither is readable."""
    live, _ = blklist(vm)
    persistent, _ = blklist(vm, inactive=True)
    out = {}
    for t, (base, overlay) in specs.items():
        named = [m.get(t) == overlay for m in (live, persistent) if m is not None]
        if any(named) or not named and os.path.exists(overlay):
            out[t] = (base, overlay)
    return out


def domain_state_or_none(vm):
    rc, so, _ = virsh("domstate", vm)
    return first_line(so) if rc == 0 else None


class VmLock:
    """One NAS backup per VM at a time (the timer and a manual run). The
    lock file holds the pid: cst doctor reads it to tell a backup in
    progress from an overlay left behind."""

    def __init__(self, vm):
        self.path = os.path.join(RUN_DIR, f"nas-{vm}.lock")
        self.fd = None

    def __enter__(self):
        os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(self.fd)
            raise Refused(f"another NAS backup of this VM is running ({self.path})") from None
        os.ftruncate(self.fd, 0)
        os.write(self.fd, f"{os.getpid()}\n".encode())
        return self

    def __exit__(self, *_):
        os.ftruncate(self.fd, 0)
        os.close(self.fd)


def stage_files(vm, xml_text, manifest):
    """domain.xml (with --security-info: graphics passwords; restic stores it
    encrypted) and manifest.json, 0600 in a 0700 folder. Returns the folder."""
    d = os.path.join(NAS_STAGE, vm)
    for x in (NAS_STAGE, d):
        os.makedirs(x, mode=0o700, exist_ok=True)
        os.chmod(x, 0o700)
    for name, text in (
        ("domain.xml", xml_text),
        ("manifest.json", json.dumps(manifest, indent=2, sort_keys=True) + "\n"),
    ):
        path = os.path.join(d, name)
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            f.write(text)
    return d


def unstage(d):
    for name in ("domain.xml", "manifest.json"):
        try:
            os.unlink(os.path.join(d, name))
        except OSError:
            pass


def nas_sources(vm, parts, notes):
    """[(path, kind)] restic reads: the disks, the UEFI variables, the TPM folder."""
    out = []
    for p in parts["disks"]:
        if not os.path.isfile(p):
            raise Refused(f"{vm}: disk {p} not found")
        if OVERLAY_MARK in p:
            raise Refused(
                f"{vm}: disk {p} is an overlay a NAS backup left behind (its blockcommit did not "
                f"finish). Put the disk back first; `{CST} doctor` shows the commands"
            )
        r = os.path.realpath(p)
        if r != p:
            notes.append(f"disk {p} is a symbolic link: read through it: {r}")
        if qcow2_backing_file(r):
            raise Refused(
                f"{vm}: {r} is a qcow2 overlay with a backing file: back up the chain by hand "
                "(qemu-img info --backing-chain)"
            )
        out.append((r, "disk"))
    if parts["nvram"]:
        if os.path.isfile(parts["nvram"]):
            out.append((os.path.realpath(parts["nvram"]), "nvram"))
        else:
            notes.append(f"UEFI variables {parts['nvram']} not there yet: not backed up")
    if parts["tpm"]:
        tpm_dir = os.path.join(SWTPM_DIR, parts["uuid"])
        if parts["uuid"] and os.path.isdir(tpm_dir):
            out.append((os.path.realpath(tpm_dir), "tpm"))
        else:
            notes.append(
                f"TPM state {tpm_dir} not found: not backed up (BitLocker may then ask for its "
                "recovery key after a restore)"
            )
    return out


def valid_keep(name):
    return (
        bool(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name or ""))
        and not name.startswith(("cst-", "vm:"))
        and name not in ("btrfs-setup", "home", "Workspace")
    )


def cmd_backup_nas(vm, keep, quiesce):
    if os.geteuid() != 0 and not os.environ.get("CST_VM_NONROOT_OK"):
        raise Refused("backup --nas needs root: run it as `cst vm backup --nas` (it calls sudo by itself)")
    if "," in vm or not vm.strip():
        raise Refused(f"VM name {vm!r}: a comma cannot be part of a restic tag")
    nas = nas_settings()
    state = domain_state(vm)
    if state not in ("running", "shut off"):
        raise Refused(
            f"{vm} is {state or 'in an unknown state'}: the NAS backup reads a running VM (through a "
            f"snapshot) or a shut-off one. Resume it or shut it down first"
        )
    if state == "shut off":
        check_shut_off(vm)
    for sig in STOP_SIGNALS:
        signal.signal(sig, on_signal)
    with VmLock(vm):
        return nas_run(vm, keep, quiesce, nas, state == "running")


def nas_run(vm, keep, quiesce, nas, live):
    rc, xml_text, err = virsh("dumpxml", "--inactive", "--security-info", vm)
    if rc != 0:
        raise Refused(f"virsh dumpxml {vm}: {first_line(err) or f'exit {rc}'}")
    parts = domain_parts(xml_text)
    if parts["problems"]:
        raise Refused(f"{vm}: nothing backed up:\n  " + "\n  ".join(parts["problems"]))
    if not parts["disks"]:
        raise Refused(f"{vm}: no file disk in its definition: nothing to back up")
    notes = list(parts["skipped"])
    sources = nas_sources(vm, parts, notes)
    epoch, stamp = utc_now()
    specs, others = {}, []  # target -> (image, overlay); targets left out of the snapshot
    if live:
        rc, live_xml, err = virsh("dumpxml", vm)
        if rc != 0:
            raise Refused(f"virsh dumpxml {vm}: {first_line(err) or f'exit {rc}'}")
        disks = live_disks(live_xml)
        for d in disks:
            if d["device"] != "disk" or d["type"] != "file":
                others.append(d["target"])
                continue
            if OVERLAY_MARK in d["source"] or d["backing"]:
                raise Refused(
                    f"{vm}: disk {d['target']} runs on {d['source']} with a backing chain (an overlay "
                    f"left by an earlier backup?). Put it back first; `{CST} doctor` shows the commands"
                )
            base = os.path.realpath(d["source"])
            specs[d["target"]] = (
                base,
                os.path.join(os.path.dirname(base), f"{os.path.basename(base)}{OVERLAY_MARK}{stamp}"),
            )
        if sorted(b for b, _ in specs.values()) != sorted(p for p, k in sources if k == "disk"):
            raise Refused(
                f"{vm}: the running VM's disks differ from its definition (changed since it started): "
                "restart it, then back up"
            )
        for _t, (_, overlay) in specs.items():
            if os.path.lexists(overlay):
                raise Refused(f"{overlay} already exists: wait a second and run it again")
        agent = agent_state(live_xml)
    versions, deployment = package_versions(), booted_deployment()
    restic_ready(nas)
    print(f"{vm}: backup to the NAS ({nas['repo']}), {'running: live snapshot' if live else 'shut off'}", flush=True)
    overlaid, consistency, failure = {}, "shut-off", None
    before = {}
    try:
        if live:
            # The UEFI variables and the TPM state have no snapshot: read live, checked after.
            before = {p: fingerprint(p) for p, k in sources if k != "disk"}
            consistency = take_snapshot(vm, stamp, specs, others, quiesce, agent, overlaid, notes)
        else:
            before = {p: fingerprint(p) for p, _ in sources}
        tags = [TAG, f"vm:{vm}"] + ([KEEP_TAG, keep] if keep else [])
        manifest = {
            "vm": vm,
            "uuid": parts["uuid"],
            "timestamp": stamp,
            "epoch": int(epoch),
            "mode": "nas",
            "consistency": consistency,
            "keep": keep,
            "tags": tags,
            "files": [
                {"source": p, "kind": k, "allocated": tree_sizes(p)[0], "apparent": tree_sizes(p)[1]}
                for p, k in sources
            ],
            "versions": versions,
            "deployment": deployment,
            "notes": notes,
        }
        stage = stage_files(vm, xml_text, manifest)
        paths = [p for p, _ in sources] + [stage]
        timeout = conf_number("VM_NAS_TIMEOUT_HOURS") * 3600 or 6 * 3600
        for p, k in sources:
            a, s = tree_sizes(p)
            print(f"  reading {p} ({k}, {human(a)} allocated, {human(s)} apparent)")
        try:
            rc, summary = restic_backup(
                nas,
                [
                    "backup",
                    "--json",
                    "--host",
                    nas["host"],
                    "--tag",
                    ",".join(tags),
                    "--retry-lock",
                    RETRY_LOCK,
                    *paths,
                ],
                timeout,
            )
        finally:
            unstage(stage)
        snap = summary.get("snapshot_id") or ""
        if rc != 0 or not snap:
            if snap:
                restic(nas, "forget", "--retry-lock", RETRY_LOCK, snap)  # incomplete (rc 3): not a backup
            why = {
                3: "some files could not be read",
                124: "stopped at the time limit (VM_NAS_TIMEOUT_HOURS)",
                127: "restic not found",
                11: "the repository stayed locked",
            }.get(rc, f"restic exit {rc}")
            raise Refused(f"restic backup failed: {why}; no backup recorded")
        if live:
            for p in before:
                try:
                    same = fingerprint(p) == before[p]
                except OSError:
                    same = False
                if not same:
                    notes.append(
                        f"{p} changed while restic read it (the VM wrote it): that copy may be torn; "
                        "the next backup reads it again"
                    )
        if not live:
            try:
                check_shut_off(vm)
            except Refused as e:
                restic(nas, "forget", "--retry-lock", RETRY_LOCK, snap)
                raise Refused(
                    f"the VM's state changed during the backup, the copy is not consistent "
                    f"(restic snapshot {snap[:8]} forgotten): {e}"
                ) from None

            def now_fp(p):
                try:
                    return fingerprint(p)
                except OSError:
                    return None

            changed = [p for p, _ in sources if now_fp(p) != before[p]]
            if changed:
                restic(nas, "forget", "--retry-lock", RETRY_LOCK, snap)
                raise Refused(
                    "changed during the backup (the VM was started?), the copy is not consistent "
                    f"(restic snapshot {snap[:8]} forgotten): {', '.join(changed)}"
                )
    except BaseException as e:  # noqa: BLE001 - the overlays are merged back first, then it is raised again
        failure = e
    # From here on no signal may cut the cleanup short, and no child may get one.
    old = {s: signal.signal(s, signal.SIG_IGN) for s in STOP_SIGNALS}
    DETACH["on"] = True
    problems, how = [], {}
    try:
        if live:
            # What the VM really runs on, not only what take_snapshot saw.
            try:
                overlaid.update(find_overlays(vm, specs))
            except Exception as e:  # noqa: BLE001 - the merge back still runs for what is known
                problems.append(f"the disks could not be listed: {e!r}")
        if overlaid:
            try:
                more, how = commit_back(vm, overlaid)
                problems += more
            except Exception as e:  # noqa: BLE001 - reported loudly below
                problems.append(f"the merge back failed: {e!r}")
    finally:
        DETACH["on"] = False
        for s, h in old.items():
            signal.signal(s, h)
    if isinstance(failure, Uncertain) and not problems:
        problems.append(str(failure))
        overlaid.update({t: spec for t, spec in specs.items() if os.path.lexists(spec[1])})
    if problems:
        body = (
            f"{vm}: a disk was not merged back after the NAS backup, or may not be: "
            + "; ".join(problems)
            + f". Check what the VM runs on; see `{CST} doctor`."
        )
        notify("critical", "VM backup: disk left on a snapshot overlay", body)
        if not overlaid:  # nothing known: the files this run could have made
            overlaid.update({t: spec for t, spec in specs.items() if os.path.lexists(spec[1])})
        lines = overlay_recovery(vm, overlaid.items(), how)
        msg = (
            "DISK NOT MERGED BACK:\n  "
            + "\n  ".join(problems)
            + "\nNothing was undone or removed. Put each disk back by hand (read each line first):\n  "
            + "\n  ".join(lines)
        )
        if failure is not None and not isinstance(failure, Uncertain):
            msg += f"\n(the backup itself: {failure})"
        raise Refused(msg)
    if failure is not None:
        raise failure
    print(
        f"  restic snapshot {snap[:8]}: {human(summary.get('total_bytes_processed') or 0)} read, "
        f"{human(summary.get('data_added') or 0)} new on the NAS ({consistency})"
    )
    retention(vm, nas)
    entries = [e for e in read_index() if not (e.get("mode") == "nas" and e.get("snapshot") == snap)]
    entries.append(
        {
            "vm": vm,
            "timestamp": stamp,
            "epoch": int(epoch),
            "mode": "nas",
            "snapshot": snap,
            "repository": nas["repo"],
            "host": nas["host"],
            "consistency": consistency,
            "keep": keep,
            "versions": versions,
            "deployment": deployment,
        }
    )
    alive = nas_snapshot_ids(vm, nas)
    if alive is not None:
        alive.add(snap)
        entries = [
            e
            for e in entries
            if not (
                e["vm"] == vm
                and e.get("mode") == "nas"
                and e.get("repository") == nas["repo"]
                and not any(a.startswith(e["snapshot"]) or e["snapshot"].startswith(a) for a in alive)
            )
        ]
    entries.sort(key=lambda e: (e["vm"], e.get("epoch") or 0))
    write_index(entries)
    for n in notes:
        print(f"  note: {n}")
    print(
        f"Done: restic snapshot {snap[:8]} of {vm} ({consistency}"
        f"{f'; kept until removed by hand: tags {KEEP_TAG},{keep}' if keep else ''})."
    )
    print(
        'Restore: vm/README.md in CST, section "Restore from the NAS" (restic restore '
        f"{snap[:8]} --sparse --target <a NOCOW folder>)."
    )
    return 0


def take_snapshot(vm, stamp, specs, others, quiesce, agent, overlaid, notes):
    """The external disk-only snapshot; fills overlaid {target: (image,
    overlay)} from what domblklist shows, also after a failure. Returns the
    consistency: quiesced or crash-consistent. Raises Uncertain when virsh
    did not answer and libvirt's result stayed unclear."""

    def attempt(with_quiesce):
        args = ["snapshot-create-as", vm, "--name", f"cst-nas-{stamp}", "--disk-only", "--atomic", "--no-metadata"]
        if with_quiesce:
            args.append("--quiesce")
        for t, (_, overlay) in specs.items():
            args += ["--diskspec", f"{t},snapshot=external,file={overlay.replace(',', ',,')}"]
        for t in others:
            args += ["--diskspec", f"{t},snapshot=no"]
        # Signals wait until the outcome is known (virsh is never killed by a stop);
        # its own session keeps a Ctrl-C or a closed terminal away from it.
        with signals_held():
            rc, so, err = virsh(*args, timeout=SNAPSHOT_TIMEOUT, detach=True)
            settled = rc != 124 and rc >= 0  # not a timeout, and virsh not killed by a signal
            deadline = time.monotonic() + (0 if settled else SNAPSHOT_SETTLE)
            while True:
                # The truth is what the VM runs on, also when virsh failed or timed out.
                cur, _ = blklist(vm)
                for t, (base, overlay) in specs.items():
                    if (cur.get(t) == overlay) if cur is not None else os.path.exists(overlay):
                        overlaid[t] = (base, overlay)
                if settled or len(overlaid) == len(specs) or time.monotonic() >= deadline:
                    break
                time.sleep(5)
        if not settled and len(overlaid) != len(specs):
            if with_quiesce:
                virsh("domfsthaw", vm)  # best effort: never leave the guest frozen
            kept = ", ".join(o for t, (_, o) in specs.items() if t not in overlaid and os.path.lexists(o))
            raise Uncertain(
                f"virsh snapshot-create-as {vm} did not answer within {SNAPSHOT_TIMEOUT} s and, "
                f"{SNAPSHOT_SETTLE} s later, the VM's disks still do not all show the overlay: libvirt "
                f"may still switch to it. Nothing was removed{f' (kept: {kept})' if kept else ''}"
            )
        if not settled and with_quiesce:
            virsh("domfsthaw", vm)
            notes.append(
                "virsh did not answer in time; the snapshot is in place, but whether the guest was frozen is unknown"
            )
            return 0, "", True
        return rc, first_line(err) or first_line(so) or f"exit {rc}", False

    def drop_strays():
        # Only after a definite error from libvirt: those files are not in use.
        for t, (_, overlay) in specs.items():
            if t not in overlaid:
                try:
                    os.unlink(overlay)
                except OSError:
                    pass

    why = (
        "--no-quiesce"
        if not quiesce
        else "no guest agent channel (org.qemu.guest_agent.0) in the definition"
        if agent == "none"
        else "the guest agent is not connected"
        if agent != "connected"
        else ""
    )
    if not why:
        rc, err, unsure = attempt(True)
        if overlaid:
            if rc != 0 or unsure:
                if rc != 0:
                    notes.append(f"virsh reported an error but the snapshot is in place: {err}")
                    virsh("domfsthaw", vm)  # best effort: never leave the guest frozen
                return "crash-consistent"
            print("  snapshot taken with the guest's file systems frozen (quiesced, QEMU guest agent)")
            return "quiesced"
        drop_strays()
        why = f"quiesce failed: {err}"
    print(f"  crash-consistent snapshot ({why})", flush=True)
    rc, err, _ = attempt(False)
    if not overlaid:
        drop_strays()
        raise Refused(f"virsh snapshot-create-as {vm}: {err} (nothing changed)")
    if rc != 0:
        notes.append(f"virsh reported an error but the snapshot is in place: {err}")
    notes.append(f"crash-consistent: {why}")
    return "crash-consistent"


def nas_snapshot_ids(vm, nas):
    """The ids of the VM's restic snapshots, or None when not readable."""
    rc, so, _ = restic(
        nas, "snapshots", "--json", "--no-lock", "--host", nas["host"], "--tag", f"{TAG},vm:{vm}", timeout=300
    )
    try:
        return {s["id"] for s in json.loads(so) if isinstance(s, dict) and s.get("id")} if rc == 0 else None
    except ValueError, TypeError:
        return None


def forget_args(vm, host, weekly, monthly):
    """restic forget for this VM only: --host and both tags, so the /home
    backup's snapshots (tag btrfs-setup) and hand-made ones (without the
    cst-vm tag) are never considered; --group-by host: one group per VM even
    when its disks change. Never --prune (the /home NAS job prunes)."""
    return [
        "forget",
        "--host",
        host,
        "--tag",
        f"{TAG},vm:{vm}",
        "--group-by",
        "host",
        "--keep-weekly",
        str(weekly),
        "--keep-monthly",
        str(monthly),
        "--keep-tag",
        KEEP_TAG,
        "--retry-lock",
        RETRY_LOCK,
    ]


def retention(vm, nas):
    weekly, monthly = conf_number("VM_NAS_KEEP_WEEKLY"), conf_number("VM_NAS_KEEP_MONTHLY")
    if weekly + monthly == 0:
        print(f"  retention: VM_NAS_KEEP_WEEKLY and VM_NAS_KEEP_MONTHLY are 0 in {VM_CONF}: nothing forgotten")
        return
    rc, so, err = restic(nas, *forget_args(vm, nas["host"], weekly, monthly))
    if rc != 0:
        print(
            f"  note: restic forget failed ({first_line(err) or f'exit {rc}'}): the backup is fine, the "
            "retention runs again next time"
        )
        return
    gone = len(re.findall(r"^remove \d+ snapshots?:", so, re.M))
    print(
        f"  retention: {weekly} weekly + {monthly} monthly kept, and those tagged {KEEP_TAG}"
        f"{'; older ones forgotten' if gone else ''} (space is freed by the /home NAS job's weekly prune)"
    )


# ---- the weekly timer ------------------------------------------------------------------------------
def render_service():
    return f"""{UNIT_MARKER}: installed by `cst vm backup-timer on`; not edited by hand.
# The weekly backup of the libvirt VM %i to the NAS (restic): a live
# snapshot while restic reads the disks, then merged back. Why and how:
# vm/README.md in CST.
[Unit]
Description=CST: backup of the VM %i to the NAS (cst vm backup --nas)
Wants=network-online.target
After=network-online.target virtqemud.service libvirtd.service
ConditionPathExists={SBIN_COPY}

[Service]
Type=oneshot
Environment="CST_PROG=cst vm"
ExecStart=/usr/bin/python3 -I {SBIN_COPY} backup %i --nas
Nice=19
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
# On stop, SIGTERM reaches the program only: it stops restic and merges the
# snapshot back before it ends (KillMode=mixed). TimeoutStopSec covers a held
# snapshot call plus the merge's own limit (virsh blockcommit --timeout) plus
# a margin, so systemd never kills a merge half done. No start limit: every step has its own (restic:
# VM_NAS_TIMEOUT_HOURS in /etc/cst/vm.conf).
KillMode=mixed
TimeoutStartSec=infinity
TimeoutStopSec={stop_timeout()}
"""


def stop_timeout():
    """A stop may arrive while the snapshot call is held (SNAPSHOT_TIMEOUT +
    SNAPSHOT_SETTLE), then the merge runs (COMMIT_TIMEOUT, plus virsh's own
    300 s), then the checks and the alert: 30 minutes of margin."""
    return f"{(SNAPSHOT_TIMEOUT + SNAPSHOT_SETTLE + COMMIT_TIMEOUT + 300 + 1800 + 59) // 60}min"


def render_timer():
    return f"""{UNIT_MARKER}: installed by `cst vm backup-timer on`; not edited by hand.
# Saturday morning: the /home NAS job starts between 00:00 and 01:00 every
# day, the btrfs scrub runs on Sunday at 02:00.
[Unit]
Description=CST: weekly backup of the VM %i to the NAS

[Timer]
OnCalendar={ON_CALENDAR}
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
"""


def program_text():
    with open(os.path.realpath(__file__)) as f:
        return f.read()


def timer_files():
    """{path: (wanted text, mode)}."""
    return {
        SBIN_COPY: (program_text(), 0o755),
        os.path.join(UNIT_DIR, SERVICE): (render_service(), 0o644),
        os.path.join(UNIT_DIR, TIMER): (render_timer(), 0o644),
    }


def file_state(path, wanted):
    """ok | stale (ours, differs) | foreign (not ours, or a link) | missing."""
    try:
        if os.path.islink(path):
            return "foreign"
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except FileNotFoundError:
        return "missing"
    except OSError:
        return "foreign"
    if text == wanted:
        return "ok"
    ours = UNIT_MARKER in text or path == SBIN_COPY and text.startswith('#!/usr/bin/python3 -I\n"""cst-vm:')
    return "stale" if ours else "foreign"


def instance(vm):
    if not re.fullmatch(r"[A-Za-z0-9_.:-]+", vm) or vm.startswith("-"):
        raise Refused(f"VM name {vm!r}: the timer takes names of letters, digits and _ . : - only")
    return f"cst-vm-backup@{vm}.timer"


def wants_links():
    d = os.path.join(UNIT_DIR, "timers.target.wants")
    try:
        return sorted(n for n in os.listdir(d) if n.startswith("cst-vm-backup@") and n.endswith(".timer"))
    except OSError:
        return []


def systemctl(*args):
    rc, so, err = run(["systemctl", *args], timeout=120)
    return rc, so.strip(), first_line(err)


def write_file(path, text, mode):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def cmd_timer(sub, vm):
    unit = instance(vm)
    if sub != "status" and os.geteuid() != 0 and not os.environ.get("CST_VM_NONROOT_OK"):
        raise Refused(f"backup-timer {sub} needs root: run it as `{PROG} backup-timer {sub}` (it calls sudo)")
    files = timer_files()
    states = {p: file_state(p, t) for p, (t, _) in files.items()}
    if sub == "status":
        on = unit in wants_links()
        print(f"weekly NAS backup of {vm}: {'on' if on else 'off'} ({unit}; {ON_CALENDAR}, up to 30 min later)")
        words = {
            "ok": "installed, up to date",
            "missing": "not installed",
            "foreign": "not CST's file",
            "stale": f"installed, OLDER than this copy of CST: {PROG} backup-timer on {vm} updates it",
        }
        for p, st in states.items():
            print(f"  {p}: {words[st]}")
        if on:
            rc, nxt, _ = systemctl("show", "-p", "NextElapseUSecRealtime", "--value", unit)
            rc2, last, _ = systemctl("show", "-p", "Result", "--value", unit.replace(".timer", ".service"))
            if rc == 0 and nxt:
                print(f"  next run: {nxt}")
            if rc2 == 0 and last:
                print(f"  last run of the service: {last}")
        nas = [e for e in read_index() if e["vm"] == vm and e.get("mode") == "nas"]
        print(f"  last NAS backup: {describe_entry(max(nas, key=lambda e: e.get('epoch') or 0)) if nas else 'none'}")
        conf = read_conf(NAS_CONF)
        if conf.get("NAS_ENABLED") != "1" or not conf.get("NAS_PATH"):
            print(f"  the NAS backup is not set up: {CST} btrfs snapshots nas setup")
        return 0
    foreign = [p for p, st in states.items() if st == "foreign"]
    if foreign:
        raise Refused("not CST's files, left as they are: " + ", ".join(foreign))
    if sub == "on":
        nas_settings()
        for p, (text, mode) in files.items():
            if states[p] != "ok":
                write_file(p, text, mode)
                print(f"  {'updated' if states[p] == 'stale' else 'installed'}: {p}")
        for args in (("daemon-reload",), ("enable", "--now", unit)):
            rc, _, err = systemctl(*args)
            if rc != 0:
                raise Refused(f"systemctl {' '.join(args)}: {err or f'exit {rc}'}")
        print(
            f"On: {unit} ({ON_CALENDAR}, then {CST} vm backup {vm} --nas). Run one now with: "
            f"sudo systemctl start {unit.replace('.timer', '.service')}"
        )
        return 0
    rc, _, err = systemctl("disable", "--now", unit)
    if rc != 0 and unit in wants_links():
        raise Refused(f"systemctl disable --now {unit}: {err or f'exit {rc}'}")
    print(f"Off: {unit}")
    if not wants_links():
        for p, st in states.items():
            if st != "missing":
                os.unlink(p)
                print(f"  removed: {p}")
        systemctl("daemon-reload")
    else:
        print(f"  kept the units and {SBIN_COPY}: still used by {', '.join(wants_links())}")
    print(f"The backups on the NAS stay (list: {CST} vm list).")
    return 0


# ---- list and status ---------------------------------------------------------------------------
def describe_entry(e):
    dep = e.get("deployment") or {}
    qemu = next(
        (
            v
            for k, v in (e.get("versions") or {}).items()
            if k.startswith(("qemu-kvm", "qemu-system-x86")) and v != NOT_INSTALLED
        ),
        "?",
    )
    if e.get("mode") == "nas":
        keep = f", kept: {e['keep']}" if e.get("keep") else ""
        return (
            f"{e['vm']:<16} {e['timestamp']}  nas      deployment {dep.get('version') or '?'}"
            f"  {qemu}  restic {str(e.get('snapshot'))[:8]} ({e.get('consistency') or '?'}{keep})"
        )
    gone = ""
    try:
        os.stat(e["path"])
    except FileNotFoundError:
        gone = "  (folder gone)"
    except OSError:
        pass  # not visible to this user (the folders are root's, 0700)
    return (
        f"{e['vm']:<16} {e['timestamp']}  {e.get('mode', '?'):<7}  deployment {dep.get('version') or '?'}"
        f"  {qemu}  {e['path']}{gone}"
    )


def cmd_list(vm):
    entries = [e for e in read_index() if vm is None or e["vm"] == vm]
    if not entries:
        print(f"no VM backups{f' of {vm}' if vm else ''} in {INDEX} (make one: {CST} vm backup)")
        return 0
    for e in sorted(entries, key=lambda e: (e["vm"], e.get("epoch") or 0)):
        print(describe_entry(e))
    return 0


def version_changes(old, new):
    """['pkg: old -> new'] for every virtualization package that differs."""
    out = []
    for p in VIRT_PACKAGES:
        a, b = (old or {}).get(p), (new or {}).get(p)
        if a is not None and b is not None and a != b:
            out.append(f"{p}: {a} -> {b}")
    return out


def cmd_status(vm):
    rc, so, err = virsh("domstate", vm)
    if rc == 127:
        print(f"{vm}: virsh not found (libvirt not installed here)")
    elif rc != 0:
        print(f"{vm}: state not readable ({first_line(err) or f'exit {rc}'})")
    else:
        print(f"{vm}: {first_line(so)}")
        rc, xml_text, err = virsh("dumpxml", "--inactive", vm)
        try:
            cpu = ET.fromstring(xml_text).find("cpu") if rc == 0 else None
        except ET.ParseError:
            cpu = None
        names = cpu_disable_list()
        if cpu is None:
            print("  cpu: no <cpu> element (or not readable)")
        else:
            mode = cpu.get("mode", "custom")
            off = {f.get("name") for f in cpu.findall("feature") if f.get("policy") == "disable"}
            missing = [n for n in names if n not in off]
            if mode != "host-passthrough":
                print(f"  cpu mode {mode}: the CET/MBEC disables are only for host-passthrough")
            elif not names:
                print(f"  cpu mode {mode}: CPU features not managed (VM_CPU_DISABLE is empty)")
            elif missing:
                print(
                    f"  cpu mode {mode}: NOT disabled: {' '.join(missing)} (Windows may bootloop under "
                    f"QEMU 11; fix: {CST} cpu vm-pin plan)"
                )
            else:
                print(f"  cpu mode {mode}: disabled {' '.join(names)}")
        if rc == 0:
            print(f"  {tune_line(xml_text)}")
    entries = sorted((e for e in read_index() if e["vm"] == vm), key=lambda e: e.get("epoch") or 0)
    if not entries:
        print(
            f"  last backup: none (to the NAS, also while it runs: {CST} vm backup --nas; "
            f"a local copy with the VM shut off: {CST} vm backup)"
        )
    else:
        last = entries[-1]
        print(f"  last backup: {describe_entry(last)}")
        changes = version_changes(last.get("versions"), package_versions())
        if changes:
            print("  virtualization packages changed since then (back up again once the VM works on them):")
            for c in changes:
                print(f"    {c}")
        else:
            print("  virtualization packages: unchanged since the last backup")
    nas = [e for e in entries if e.get("mode") == "nas"]
    if nas and nas[-1] is not entries[-1]:
        print(f"  last NAS backup: {describe_entry(nas[-1])}")
    try:
        print(
            f"  weekly NAS backup timer: {'on' if instance(vm) in wants_links() else 'off'}"
            f" ({CST} vm backup-timer status {vm})"
        )
    except Refused:
        pass
    if knobs()["VM_NOCOW"]:
        print("VM image folders (NOCOW):")
        for d in image_dirs():
            for ln in nocow_lines(probe_dir(d), verbose=False):
                print(f"  {ln}")
    return 0


# ---- settings ------------------------------------------------------------------------------------
def knobs(path=None):
    """{knob: bool} from /etc/cst/vm.conf; a missing file or knob is yes."""
    conf = read_conf(path or VM_CONF)
    return {k: conf.get(k, "yes").strip().lower() not in ("no", "0", "false", "off") for k in KNOBS}


def user_home():
    """The home of the user who runs CST: under sudo, SUDO_USER's (sudo may
    set HOME to /root), else HOME."""
    if os.geteuid() == 0 and os.environ.get("SUDO_USER"):
        try:
            return pwd.getpwnam(os.environ["SUDO_USER"]).pw_dir
        except KeyError:
            pass
    return os.path.expanduser("~")


# ---- NOCOW of the VM image folders -----------------------------------------------------------------
def is_btrfs(path):
    """True/False, or None when statfs fails (statfs needs only search
    permission, so a root folder of mode 0711 still answers)."""
    buf = ctypes.create_string_buffer(256)
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.statfs(os.fsencode(path), buf) != 0:
            return None
    except OSError, AttributeError:
        return None
    return struct.unpack_from("l", buf.raw, 0)[0] == BTRFS_MAGIC


def inode_flags(path):
    """The inode flags (FS_IOC_GETFLAGS), or None when this user may not read
    them: the system folder is root's (0711) and the images are qemu's (0600).
    Unreadable is not "copy-on-write": callers say "not readable"."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("l", 0))
        return struct.unpack("l", buf)[0]
    except OSError:
        return None
    finally:
        os.close(fd)


def set_nocow(path):
    """Set +C on a folder this user owns (files created in it later inherit
    it). Raises OSError."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY)
    try:
        buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("l", 0))
        flags = struct.unpack("l", buf)[0] | FS_NOCOW_FL
        fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("l", flags))
    finally:
        os.close(fd)


def image_dirs(home=None):
    """[{scope, path, what}] of every known VM image folder."""
    home = home or user_home()
    out = [{"scope": "system", "path": SYSTEM_IMAGES, "what": "libvirt qemu:///system: virt-manager, virsh"}]
    out += [{"scope": "user", "path": os.path.join(home, rel), "what": what} for rel, what in USER_IMAGES]
    return out


def flag_state(flags):
    return None if flags is None else bool(flags & FS_NOCOW_FL)


def probe_dir(d, readable=lambda p: p):
    """What a VM image folder looks like. readable maps a path to where this
    process reads it (the doctor in a toolbox: under /run/host). Adds:
    present, link (the target when the path is a symbolic link: never
    created, marked or listed; present is then False), btrfs (None: unknown), nocow (True/False/None: not readable),
    listed (False: the folder cannot be listed by this user), images
    [{name, path, alloc, size, nocow}] (regular files, not .iso, not the
    *.cow-old leftovers of a conversion) and leftovers [names]."""
    d = dict(d)
    rp = readable(d["path"])
    link = os.readlink(rp) if os.path.islink(rp) else None
    d.update(
        present=link is None and os.path.isdir(rp),
        link=link,
        btrfs=None,
        nocow=None,
        listed=False,
        images=[],
        leftovers=[],
    )
    if not d["present"]:
        return d
    d["btrfs"] = is_btrfs(rp)
    if d["btrfs"] is False:
        return d
    d["nocow"] = flag_state(inode_flags(rp))
    try:
        entries = sorted(os.scandir(rp), key=lambda e: e.name)
    except OSError:
        return d
    d["listed"] = True
    for e in entries:
        try:
            if not e.is_file(follow_symlinks=False):
                continue
            st = e.stat(follow_symlinks=False)
        except OSError:
            continue
        if e.name.endswith(".cow-old"):
            d["leftovers"].append(e.name)
            continue
        if e.name.lower().endswith(".iso"):
            continue  # read-only installers: nothing to gain
        d["images"].append(
            {
                "name": e.name,
                "path": os.path.join(d["path"], e.name),
                "alloc": st.st_blocks * 512,
                "size": st.st_size,
                "nocow": flag_state(inode_flags(os.path.join(rp, e.name))),
            }
        )
    return d


def convert_lines(img, system):
    """The commands that make an existing image NOCOW (never run by CST)."""
    q = shlex.quote
    s = "sudo " if system else ""
    f, old = q(img["path"]), q(img["path"] + ".cow-old")
    return [
        f"{s}mv {f} {old}",
        f"{s}install -m 0600 /dev/null {f}      # new empty file, private until cp -a sets the mode",
        f"{s}chattr +C {f}",
        f"{s}cp -a --reflink=never --sparse=auto {old} {f}",
        f"{s}cmp {old} {f} && echo same",
        f"# start the VM; after a good boot: {s}rm {old}",
    ]


def nocow_lines(d, verbose=True):
    """Lines describing one probed folder (plan and status)."""
    head = f"{d['path']}  [{d['what']}]"
    if d.get("link") is not None:
        return [
            f"{head}: a symbolic link to {d['link']}: not managed by CST (set the mark on the real "
            f"folder by hand if it is on btrfs: chattr +C <folder>)"
        ]
    if not d["present"]:
        return [f"{head}: not present"]
    if d["btrfs"] is False:
        return [f"{head}: not on btrfs (NOCOW does not apply)"]
    out = [head]
    root_hint = f"{PROG} nocow plan --root"
    if d["nocow"] is None:
        out.append(f"  NOCOW mark (+C): not readable as your user (root-only folder): {root_hint}")
    else:
        out.append(
            "  NOCOW mark (+C): "
            + ("yes" if d["nocow"] else f"no: {PROG} nocow apply sets it (only files created later get it)")
        )
    if not d["listed"]:
        if d["nocow"] is not None or d["scope"] != "system":
            out.append("  images: folder not listable as your user")
        return out
    cow = [i for i in d["images"] if i["nocow"] is False]
    unknown = [i for i in d["images"] if i["nocow"] is None]
    ok = [i for i in d["images"] if i["nocow"]]
    if not d["images"]:
        out.append("  images: none")
    if ok:
        out.append(f"  NOCOW images: {', '.join(i['name'] for i in ok)}")
    if unknown:
        out.append(
            f"  images whose mark is not readable as your user: {', '.join(i['name'] for i in unknown)} ({root_hint})"
        )
    for i in cow:
        out.append(f"  still copy-on-write: {i['name']}  {human(i['alloc'])} allocated, {human(i['size'])} apparent")
        if verbose:
            out.append(f"    to convert (every VM using it shut off; needs about {human(i['alloc'])} free):")
            out += [f"      {ln}" for ln in convert_lines(i, d["scope"] == "system")]
    for n in d["leftovers"]:
        out.append(f"  leftover of a conversion: {n} (remove it once the VM booted well from the new file)")
    return out


def cmd_nocow_plan(as_root=False):
    if as_root and os.geteuid() != 0 and not os.environ.get("CST_VM_NONROOT_OK"):
        raise Refused(
            f"--root reads the system folder as root: run it as `{PROG} nocow plan --root` (it calls sudo by itself)"
        )
    if not knobs()["VM_NOCOW"]:
        print(f"VM_NOCOW=no in {VM_CONF}: the VM image folders are not managed.")
        return 0
    dirs = [probe_dir(d) for d in image_dirs()]
    for d in dirs:
        for ln in nocow_lines(d):
            print(ln)
    todo = [d for d in dirs if needs_mark(d)]
    print()
    if todo:
        print(
            f"Set the mark with: {PROG} nocow apply   (folders: "
            + ", ".join(
                d["path"]
                + (
                    " (not created yet)"
                    if not d["present"]
                    else " (mark not readable here: set again, harmless)"
                    if d["nocow"] is None
                    else ""
                )
                for d in todo
            )
            + ")"
        )
    else:
        print("No folder to mark.")
    print("Existing images are never converted by CST: the commands above are for you to run.")
    return 0


def needs_mark(d):
    """True when nocow apply would act on the folder (also: unknown state of
    the system folder, or the system folder missing while libvirt is there).
    A symbolic link is never acted on (install -d and chattr would follow it)."""
    if d.get("link") is not None or os.path.lexists(d["path"]) and not d["present"]:
        return False
    if d["scope"] == "system" and not d["present"]:
        return os.path.isdir(os.path.dirname(d["path"]))
    return d["present"] and d["btrfs"] is not False and d["nocow"] is not True


def confirm(question):
    if not sys.stdin.isatty():
        raise Refused("apply asks for confirmation: run it in a terminal")
    return input(f"{question} [y/N] ").strip()[:1] in ("y", "Y", "s", "S")


def mark_system_dir(d):
    """Create (root:root 0711, as libvirt does) and mark the system folder:
    directly as root, else with sudo. Returns an error text or ""."""
    path, q = d["path"], shlex.quote(d["path"])
    if os.path.islink(path) or not d["present"] and os.path.lexists(path):
        return f"{path}: appeared or is a symbolic link: not touched"
    if os.geteuid() == 0:
        try:
            if not d["present"]:
                os.mkdir(path, 0o711)
                os.chmod(path, 0o711)
                run(["restorecon", path])
            set_nocow(path)
        except OSError as e:
            return f"{path}: {e.strerror}"
        return "" if flag_state(inode_flags(path)) else f"{path}: the mark did not stick"
    steps = []
    if not d["present"]:
        steps += [["install", "-d", "-o", "root", "-g", "root", "-m", "0711", path], ["restorecon", path]]
    steps.append(["chattr", "+C", path])
    for cmd in steps:
        print(f"  sudo {' '.join(shlex.quote(c) for c in cmd)}", flush=True)
        p = subprocess.run(["sudo", "--", *cmd], env={**os.environ, "LC_ALL": "C"})
        if p.returncode != 0:
            return f"sudo {cmd[0]} {q}: exit {p.returncode}"
    rc, so, _ = run(["sudo", "--", "lsattr", "-d", path])
    attrs = so.split()[0] if rc == 0 and so.split() else ""
    return "" if "C" in attrs else f"{path}: the mark could not be confirmed (sudo lsattr -d {q})"


def cmd_nocow_apply():
    if not knobs()["VM_NOCOW"]:
        print(f"VM_NOCOW=no in {VM_CONF}: nothing to do.")
        return 0
    dirs = [probe_dir(d) for d in image_dirs()]
    todo = [d for d in dirs if needs_mark(d)]
    if not todo:
        print(
            "Every VM image folder present on btrfs already has the NOCOW mark (+C)"
            + (" (symbolic links are not managed)." if any(d.get("link") for d in dirs) else ".")
        )
        return 0
    for d in todo:
        what = "create (root:root 0711) and mark" if not d["present"] else "mark"
        unknown = " (its mark is not readable as your user: set again, harmless)" if d["nocow"] is None else ""
        print(f"  {what} +C: {d['path']}{' (sudo)' if d['scope'] == 'system' and os.geteuid() else ''}{unknown}")
    print(
        "Only files created there later get the mark; existing images stay as they are "
        f"({PROG} nocow plan shows how to convert them)."
    )
    if not confirm("Set the NOCOW mark on these folders?"):
        print("Nothing changed.")
        return 0
    errors = []
    for d in todo:
        if d["scope"] == "system":
            err = mark_system_dir(d)
        else:
            try:
                set_nocow(d["path"])
                err = "" if flag_state(inode_flags(d["path"])) else f"{d['path']}: the mark did not stick"
            except OSError as e:
                err = f"{d['path']}: {e.strerror}"
        if err:
            errors.append(err)
        else:
            print(f"  done: {d['path']}")
    if errors:
        raise Refused("not done:\n  " + "\n  ".join(errors))
    return 0


