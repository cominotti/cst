_vm_mod: ModuleType | None = None
_vm_mod_loaded = False


def vm_module() -> ModuleType | None:
    """vm/cst-vm of this copy, loaded as a module (its tune and NOCOW logic,
    so the doctor does not keep a second copy), or None."""
    global _vm_mod, _vm_mod_loaded
    if not _vm_mod_loaded:
        _vm_mod, _vm_mod_loaded = load_vm_module(VM_TOOL), True
    return _vm_mod


def unalloc_thresholds(host: DoctorHostPort) -> tuple[int, int]:
    """(warn_gib, crit_gib) respecting module-level HEALTH_CHECK_REPO."""
    return _app.unalloc_thresholds(host, health_check_repo=HEALTH_CHECK_REPO)


