def check_vm_image_dirs(host: DoctorHostPort) -> Iterator[Result]:
    return _app.check_vm_image_dirs(host, vm_mod_fn=vm_module)


_WRAPPED: dict[CheckFn, CheckFn] = {
    _app.check_btrfs_allocation: check_btrfs_allocation,
    _app.check_vm_cpu_features: check_vm_cpu_features,
    _app.check_virt_stack_change: check_virt_stack_change,
    _app.check_vm_overlays: check_vm_overlays,
    _app.check_vm_backup_timer: check_vm_backup_timer,
    _app.check_vm_hardware: check_vm_hardware,
    _app.check_vm_image_dirs: check_vm_image_dirs,
}

CHECKS: list[tuple[str, CheckFn]] = [(area, _WRAPPED.get(fn, fn)) for area, fn in _app.CHECKS]


def check[F: CheckFn](area: str) -> Callable[[F], F]:
    """Register a check function on this facade's CHECKS list."""

    def register(fn: F) -> F:
        CHECKS.append((area, fn))
        return fn

    return register


def run_checks(host: DoctorHostPort, checks: Iterable[tuple[str, CheckFn]] | None = None) -> list[tuple[str, Result]]:
    """Run all registered checks (or a supplied subset) and catch check crashes as ERROR."""
    return _app.run_checks(host, CHECKS if checks is None else checks)


def main(argv: Sequence[str], out: TextIO = sys.stdout) -> int:
    """CLI entry point for `cst doctor`."""
    try:
        cmd, brief = parse_args(argv)
    except Usage as e:
        print(f"{PROG}: {e}\n{USAGE}", file=sys.stderr)
        return 2
    if cmd == "help":
        doc = __doc__ or ""
        print(doc.replace("doctor [--brief]", f"{PROG} [--brief]", 1), file=out)
        return 0
    host = Host()
    return render(run_checks(host), brief, out, host.container)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
