# SPDX-License-Identifier: MPL-2.0
[Unit]
Description=CST Browser Profile Overlayfs Sync for %i
RequiresMountsFor=/var/home
After=local-fs.target
Before=systemd-user-sessions.service display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStopSec=120
ExecStart=/usr/local/sbin/cst-desktop psd start --user %i --skip-busy
ExecStop=/usr/local/sbin/cst-desktop psd stop --user %i

[Install]
WantedBy=multi-user.target
