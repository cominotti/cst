#!/usr/bin/python3 -I
# SPDX-License-Identifier: MPL-2.0
"""vm-pin: keep a libvirt VM off the P-cores and the game's E-cores, and
keep the CPU features off that make Windows bootloop under QEMU 11.

Installed as /usr/local/sbin/cpu-vm-pin; run by `cst cpu vm-pin plan|apply|status [VM]`.

  plan    print the domain XML diff: <vcpu> VCPUS, every vCPU and the
          emulator threads pinned to CPUS (default 12 vCPUs on 12-23) and,
          with <cpu mode='host-passthrough'>, the features of VM_CPU_DISABLE
          (default: CET and nested MBEC) set to policy='disable'; no change
  apply   same diff, asks, then `virsh define`: takes effect at the VM's next
          start (shutting it down/starting it is left to the user)
  status  current vCPU count and pinning (live and persistent)
"""

import os.path as _cst_path
import sys as _cst_sys

# CST bootstrap (the same in every entry point; tests/test_entrypoints.py checks
# it): from a checkout, cst_core and the module packages are in the folder above
# this file; inside an installed zipapp, sys.path already holds the archive.
_cst_root = _cst_path.dirname(_cst_path.dirname(_cst_path.realpath(__file__)))
if not _cst_path.isfile(_cst_path.dirname(__file__)) and _cst_root not in _cst_sys.path:
    _cst_sys.path.insert(0, _cst_root)

import sys

from cpu import cli


def main() -> int:
    """Pin the VM (plan, apply) or show how it stands (status)."""
    return cli.vm_pin(sys.argv[1:], doc=__doc__ or "")


if __name__ == "__main__":
    sys.exit(main())
