#!/usr/bin/python3 -I
"""cpu-watch: frame-pacing telemetry for A/B comparisons (user level, read-only).

Installed by cpu-setup.sh (CST) as /usr/local/bin/cpu-watch; also run
as `cst cpu watch|report`.

  cpu-watch watch -l LABEL [--game NAME] [--seconds N] [--mangohud DIR] [-- CMD...]
      Samples once per second until CMD exits, N seconds pass or Ctrl-C:
      CPU and memory pressure of the game's cgroup (the Steam app scope, so
      the Steam client counts too) (time its threads were
      runnable but waiting, or stalled on memory), the game's involuntary
      context switches, system CPU pressure, mean P-core and E-core MHz, CPU
      used by the VM (machine.slice) and builds (builds.slice / docker
      scopes) and whether the game profile is on. With --mangohud, the newest
      MangoHud CSV written in the window is copied into the run, for frame
      times (avg FPS, 1% and 0.1% lows).
      Runs: ~/.local/state/cpu-setup/runs/<time>-<label>/
  cpu-watch report [RUN...]   one line per run (default: the last 10), to
      compare labels such as "baseline-build" vs "profile-build".
  cpu-watch quiet [--for SECONDS] [--wait MAX] [--json] [limits]
      Is the machine quiet enough for a benchmark? Samples once per second
      for SECONDS (default 60) and checks the window's means: CPU busy
      (/proc/stat), CPU/IO/memory pressure (avg10 of /proc/pressure/*),
      writes to the disks (pgpgout of /proc/vmstat), and the game profile
      off. With --wait MAX (120, 90s, 30m, 2h), the window slides until it
      is quiet or MAX passed. Exit 0 quiet, 1 not quiet, 2 usage error.
      Limits: --cpu PCT (10), --cpu-pressure PCT (5), --io-pressure PCT (5),
      --memory-pressure PCT (1), --write-mbps MB (5); or the environment
      variables QUIET_CPU_PCT, QUIET_CPU_PSI, QUIET_IO_PSI, QUIET_MEMORY_PSI,
      QUIET_WRITE_MBPS (a flag wins).
"""

from __future__ import annotations

import csv
import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from collections import deque
from collections.abc import Callable, Mapping, Sequence
from datetime import datetime
from itertools import islice
from typing import Any, NamedTuple, TextIO

RUNS = os.path.expanduser("~/.local/state/cpu-setup/runs")
CG = "/sys/fs/cgroup"
GAME_STATE = "/run/cpu-setup/game.state"  # cpu/game-profile: the profile is on


def read(path: str, default: str = "") -> str:
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def cpus_of(kind: str) -> list[int]:
    """CPU numbers of core type kind ('cpu_core' or 'cpu_atom')."""
    out: list[int] = []
    for part in read(f"/sys/devices/{kind}/cpus").strip().split(","):
        if "-" in part:
            a, b = part.split("-")
            out += range(int(a), int(b) + 1)
        elif part:
            out.append(int(part))
    return out


P_CPUS, E_CPUS = cpus_of("cpu_core"), cpus_of("cpu_atom")


def mean_mhz(cpus: Sequence[int]) -> int:
    vals = [int(read(f"/sys/devices/system/cpu/cpu{c}/cpufreq/scaling_cur_freq", "0") or 0) for c in cpus]
    vals = [v for v in vals if v]
    return round(sum(vals) / len(vals) / 1000) if vals else 0


def pressure_field(text: str, kind: str, key: str) -> str | None:
    """The KEY= value (as text) on the KIND line ('some' or 'full') of a
    pressure file's text, or None."""
    m = re.search(rf"^{kind} (?:.* )?{key}=(\d+(?:\.\d+)?)\b", text, re.M)
    return m.group(1) if m else None


def pressure_total(path: str, kind: str) -> int | None:
    """Cumulative stall microseconds ('some' or 'full') of a pressure file."""
    v = pressure_field(read(path), kind, "total")
    return int(v) if v is not None else None


def usage_usec(cg: str) -> int:
    m = re.search(r"^usage_usec (\d+)", read(os.path.join(CG, cg, "cpu.stat")), re.M)
    return int(m.group(1)) if m else 0


def find_game(name: str | None) -> int | None:
    """PID of the game: NAME if given, else a process with GameMode's client
    library loaded."""
    if name:
        r = subprocess.run(["pgrep", "-xo", name], check=False, capture_output=True, text=True)
        return int(r.stdout.split()[0]) if r.stdout.split() else None
    # Several processes of the launch chain (reaper, pressure-vessel) map it:
    # the game is the one with the most threads.
    best: int | None = None
    nthreads = 0
    for maps in glob.glob("/proc/[0-9]*/maps"):
        if "libgamemode" in read(maps):
            pid = int(maps.split("/")[2])
            n = len(glob.glob(f"/proc/{pid}/task/*"))
            if n > nthreads:
                best, nthreads = pid, n
    return best


def game_cgroup(pid: int) -> str:
    line = read(f"/proc/{pid}/cgroup").strip()
    return line.split("::", 1)[1].lstrip("/") if "::" in line else ""


def invol(pid: int) -> int:
    total = 0
    for st in glob.glob(f"/proc/{pid}/task/*/status"):
        m = re.search(r"^nonvoluntary_ctxt_switches:\s+(\d+)", read(st), re.M)
        total += int(m.group(1)) if m else 0
    return total


def build_cgroups() -> list[str]:
    out = ["builds.slice"] if os.path.isdir(os.path.join(CG, "builds.slice")) else []
    out += [os.path.relpath(p, CG) for p in glob.glob(os.path.join(CG, "system.slice", "docker-*.scope"))]
    return out


def watch(argv: Sequence[str]) -> int:
    label = "run"
    game: str | None = None
    seconds: int | None = None
    mangohud: str | None = None
    cmd: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            cmd = list(argv[i + 1 :])
            break
        if a in ("-l", "--label"):
            label = argv[i + 1]
            i += 2
        elif a == "--game":
            game = argv[i + 1]
            i += 2
        elif a == "--seconds":
            seconds = int(argv[i + 1])
            i += 2
        elif a == "--mangohud":
            mangohud = os.path.expanduser(argv[i + 1])
            i += 2
        else:
            print(f"unknown argument {a}", file=sys.stderr)
            return 2
    label = re.sub(r"[^A-Za-z0-9._-]", "_", label)
    start = time.time()
    run_dir = os.path.join(RUNS, datetime.fromtimestamp(start).strftime("%Y%m%dT%H%M%S") + "-" + label)
    os.makedirs(run_dir)
    proc = subprocess.Popen(cmd) if cmd else None
    stop: list[int] = []
    signal.signal(signal.SIGINT, lambda *_: stop.append(1))
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    print(f"recording into {run_dir} (Ctrl-C to stop)", file=sys.stderr)

    prev: dict[str, Any] = {}
    rows: list[list[object]] = []
    pid: int | None = None
    cg = ""
    fields = [
        "t",
        "profile_on",
        "game_pid",
        "game_cpu_wait_ms",
        "game_mem_stall_ms",
        "game_invol_switches",
        "sys_cpu_some_ms",
        "p_mhz",
        "e_mhz",
        "vm_cpus_used",
        "builds_cpus_used",
    ]
    with open(os.path.join(run_dir, "samples.csv"), "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(fields)
        while not stop:
            if proc and proc.poll() is not None:
                break
            if seconds and time.time() - start >= seconds:
                break
            if not pid or not os.path.exists(f"/proc/{pid}"):
                pid = find_game(game)
                cg = game_cgroup(pid) if pid else ""
                prev.pop("game", None)
            now = time.time()
            cur: dict[str, Any] = {
                "t": now,
                "sys": pressure_total("/proc/pressure/cpu", "some") or 0,
                "vm": usage_usec("machine.slice"),
                "builds": sum(usage_usec(c) for c in build_cgroups()),
            }
            if pid and cg:
                cur["game"] = (
                    pressure_total(os.path.join(CG, cg, "cpu.pressure"), "some") or 0,
                    pressure_total(os.path.join(CG, cg, "memory.pressure"), "full") or 0,
                    invol(pid),
                )
            if prev:
                dt = now - prev["t"]
                g_cur: tuple[int, int, int] | None = cur.get("game")
                g_prev: tuple[int, int, int] | None = prev.get("game")
                has_game = g_cur is not None and g_prev is not None
                row: list[object] = [
                    round(now - start, 1),
                    int(os.path.exists(GAME_STATE)),
                    pid or "",
                    # per second of wall time (samples drift a little past 1 s)
                    round((g_cur[0] - g_prev[0]) / 1000 / dt, 1) if g_cur is not None and g_prev is not None else "",
                    round((g_cur[1] - g_prev[1]) / 1000 / dt, 1) if g_cur is not None and g_prev is not None else "",
                    round((g_cur[2] - g_prev[2]) / dt) if has_game and g_cur is not None and g_prev is not None else "",
                    round((cur["sys"] - prev["sys"]) / 1000 / dt, 1),
                    mean_mhz(P_CPUS),
                    mean_mhz(E_CPUS),
                    round((cur["vm"] - prev["vm"]) / 1e6 / dt, 2),
                    round(max(0, cur["builds"] - prev["builds"]) / 1e6 / dt, 2),
                ]
                w.writerow(row)
                f.flush()
                rows.append(row)
            prev = cur
            time.sleep(1)
    end = time.time()
    if proc and proc.poll() is None:
        proc.terminate()
    meta: dict[str, object] = {
        "label": label,
        "start": start,
        "end": end,
        "cmd": cmd,
        "game": game,
        "rc": proc.returncode if proc else None,
    }
    if mangohud:
        logs = [p for p in glob.glob(os.path.join(mangohud, "*.csv")) if start - 5 <= os.path.getmtime(p) <= end + 30]
        if logs:
            newest = max(logs, key=os.path.getmtime)
            shutil.copy2(newest, os.path.join(run_dir, "mangohud.csv"))
            meta["mangohud"] = newest
    with open(os.path.join(run_dir, "meta.json"), "w") as f:
        json.dump(meta, f)
    print(summarize(run_dir))
    return proc.returncode if proc and proc.returncode else 0


def frametimes(path: str) -> list[float]:
    """Frame times (ms) from a MangoHud CSV (header row with 'frametime')."""
    out: list[float] = []
    with open(path, newline="") as f:
        rd = csv.reader(f)
        col: int | None = None
        for row in rd:
            if col is None:
                low = [c.strip().lower() for c in row]
                if "frametime" in low:
                    col = low.index("frametime")
                continue
            try:
                out.append(float(row[col]))
            except ValueError, IndexError:
                pass
    return out


def lows(ft: Sequence[float]) -> tuple[float, float, float] | None:
    """avg fps, 1% low and 0.1% low (fps of the mean of the worst frames)."""
    if not ft:
        return None
    s = sorted(ft, reverse=True)

    def low(frac: float) -> float:
        worst = s[: max(1, int(len(s) * frac))]
        return 1000 / (sum(worst) / len(worst))

    return 1000 / (sum(ft) / len(ft)), low(0.01), low(0.001)


def summarize(run_dir: str) -> str:
    # The value is not used; the line stays so that a corrupt meta.json
    # still stops the report here, as before.
    json.loads(read(os.path.join(run_dir, "meta.json"), "{}") or "{}")
    with open(os.path.join(run_dir, "samples.csv"), newline="") as f:
        rows = list(csv.DictReader(f))

    def col(name: str) -> list[float]:
        out_col: list[float] = []
        for r in rows:
            val = r.get(name)
            if val is not None and val != "":
                out_col.append(float(val))
        return out_col

    def avg(v: Sequence[float]) -> float:
        return sum(v) / len(v) if v else float("nan")

    wait, mem, inv = col("game_cpu_wait_ms"), col("game_mem_stall_ms"), col("game_invol_switches")
    game = (
        (
            f"game wait {avg(wait) / 10:5.1f}% (max {max(wait) / 10:5.1f}%)  mem stall {sum(mem):7.0f} ms"
            f"  invol/s {avg(inv):7.0f}"
        )
        if wait
        else f"{'no game found (--game NAME?)':62}"
    )
    out = (
        f"{os.path.basename(run_dir):40} {len(rows):5d}s  {game}"
        f"  P {avg(col('p_mhz')):5.0f} MHz  E {avg(col('e_mhz')):5.0f} MHz"
        f"  VM {avg(col('vm_cpus_used')):4.1f} cpu  builds {avg(col('builds_cpus_used')):4.1f} cpu"
        f"  profile {'on' if avg(col('profile_on')) > 0.5 else 'off'}"
    )
    mh = os.path.join(run_dir, "mangohud.csv")
    if os.path.exists(mh):
        r = lows(frametimes(mh))
        if r:
            out += f"\n{'':40} frames: avg {r[0]:.0f} fps, 1% low {r[1]:.0f}, 0.1% low {r[2]:.0f}"
    return out


def report(argv: Sequence[str]) -> int:
    runs = [os.path.join(RUNS, r) if not os.path.isabs(r) else r for r in argv] or sorted(
        glob.glob(os.path.join(RUNS, "*"))
    )[-10:]
    if not runs:
        print(f"no runs in {RUNS}; record one with: cst cpu watch -l <label> [-- <cmd>]")
        return 0
    print("game wait = share of time the game's threads were runnable but waiting for a CPU")
    for r in runs:
        print(summarize(r))
    return 0


# ---- quiet: is the machine quiet enough for a benchmark? ------------------------
#
# The defaults come from a 3-day `below` recording of this machine (cpu/README.md,
# "Is the machine quiet?"): the CPU and write limits pass the machine's quiet
# hours with room to spare; the pressure limits are reasoned from its quietest window.

PROC = "/proc"


def stat_cpu(text: str) -> tuple[int, int]:
    """(total, idle) jiffies of the 'cpu' line that /proc/stat starts with."""
    f = text.split("\n", 1)[0].split()
    # user nice system idle iowait irq softirq steal; guest and guest_nice
    # (after them) are already counted in user and nice.
    if f[:1] != ["cpu"] or len(f) < 9:
        raise ValueError("no 'cpu' line with 8 counters first")
    v = [int(x) for x in f[1:9]]
    return sum(v), v[3] + v[4]  # iowait is idle time too


def vmstat_pgpgout(text: str) -> int:
    """KiB written to the disks since boot (/proc/vmstat pgpgout)."""
    m = re.search(r"^pgpgout (\d+)$", text, re.M)
    if not m:
        raise ValueError("no 'pgpgout' line")
    return int(m.group(1))


def some_avg10(text: str) -> float:
    """The 'some avg10=' share (%) of a pressure file."""
    v = pressure_field(text, "some", "avg10")
    if v is None:
        raise ValueError("no 'some avg10=' line")
    return float(v)


def busy_pct(window: Sequence[Mapping[str, Any]], name: str) -> float:
    """CPU busy (%) from the counters at both ends of the window."""
    (total0, idle0), (total1, idle1) = window[0]["v"][name], window[-1]["v"][name]
    if total1 <= total0:
        raise ValueError("/proc/stat: the CPU counters did not advance")
    return 100.0 * ((total1 - total0) - (idle1 - idle0)) / (total1 - total0)


def write_mbps(window: Sequence[Mapping[str, Any]], name: str) -> float:
    """MB written per second, from the counters at both ends of the window."""
    elapsed = window[-1]["t"] - window[0]["t"]
    if elapsed <= 0:
        raise ValueError("the clock did not advance")
    # KiB -> MB (1 MB = 1024 KiB)
    return (window[-1]["v"][name] - window[0]["v"][name]) / 1024 / elapsed


def mean_of_seconds(window: Sequence[Mapping[str, Any]], name: str) -> float:
    """Mean of each second's reading (the first reading only starts the window)."""
    return sum(s["v"][name] for s in islice(window, 1, None)) / (len(window) - 1)


# One row per test. file: under /proc; parse: its text -> one reading (or
# ValueError); value: (window of readings, name) -> the window's value.
class Limit(NamedTuple):
    name: str
    label: str
    unit: str
    flag: str
    env: str
    default: float
    file: str
    parse: Callable[[str], Any]
    value: Callable[[Sequence[Mapping[str, Any]], str], float]


QUIET_LIMITS = (
    Limit("cpu", "CPU busy", "%", "--cpu", "QUIET_CPU_PCT", 10.0, "stat", stat_cpu, busy_pct),
    Limit(
        "cpu-pressure",
        "CPU pressure",
        "%",
        "--cpu-pressure",
        "QUIET_CPU_PSI",
        5.0,
        "pressure/cpu",
        some_avg10,
        mean_of_seconds,
    ),
    Limit(
        "io-pressure",
        "IO pressure",
        "%",
        "--io-pressure",
        "QUIET_IO_PSI",
        5.0,
        "pressure/io",
        some_avg10,
        mean_of_seconds,
    ),
    Limit(
        "memory-pressure",
        "memory pressure",
        "%",
        "--memory-pressure",
        "QUIET_MEMORY_PSI",
        1.0,
        "pressure/memory",
        some_avg10,
        mean_of_seconds,
    ),
    Limit(
        "writes", "disk writes", "MB/s", "--write-mbps", "QUIET_WRITE_MBPS", 10.0, "vmstat", vmstat_pgpgout, write_mbps
    ),
)


def quiet_sample(
    proc: str = PROC, game_state: str = GAME_STATE, clock: Callable[[], float] = time.monotonic
) -> dict[str, Any]:
    """One reading of each test's file (s['v'][test name]) and whether the game
    profile is on. A file that cannot be read or parsed leaves its reason in
    s['err'][test name] instead."""
    s: dict[str, Any] = {"t": clock(), "wall": time.time(), "game": os.path.exists(game_state), "v": {}, "err": {}}
    for lim in QUIET_LIMITS:
        path = os.path.join(proc, lim.file)
        try:
            with open(path) as f:
                s["v"][lim.name] = lim.parse(f.read())
        except OSError as e:
            s["err"][lim.name] = f"{path}: {e.strerror or e}"
        except ValueError as e:
            s["err"][lim.name] = f"{path}: {e}"
    return s


def quiet_tests(window: Sequence[Mapping[str, Any]], limits: Mapping[str, float]) -> list[dict[str, Any]]:
    """The tests of one window (SECONDS + 1 readings, a second apart): CPU busy
    and writes from the counters at both ends (the window's mean), pressure as
    the mean of each second's avg10, the game profile off in every reading."""
    tests: list[dict[str, Any]] = []
    for lim in QUIET_LIMITS:
        value: float | None = None
        err = next((s["err"][lim.name] for s in window if lim.name in s["err"]), None)
        if err is None:
            try:
                # Rounded before the comparison: the verdict matches the printed value.
                value = round(lim.value(window, lim.name), 2)
            except ValueError as e:
                err = str(e)
        tests.append(
            {
                "name": lim.name,
                "label": lim.label,
                "unit": lim.unit,
                "limit": limits[lim.name],
                "value": value,
                "ok": err is None and value is not None and value < limits[lim.name],
                "error": err,
            }
        )
    on = sum(1 for s in window if s["game"])
    tests.append(
        {
            "name": "game-profile",
            "label": "game profile",
            "unit": "",
            "limit": "off",
            "value": "off" if not on else f"on in {on} of {len(window)} readings",
            "ok": not on,
            "error": None,
        }
    )
    return tests


def duration(text: str) -> float:
    """Seconds from 120, 90s, 30m or 2h."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([smh]?)", text.strip())
    if not m or float(m.group(1)) <= 0:
        raise ValueError(f"not a duration: {text!r} (examples: 120, 90s, 30m, 2h)")
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[m.group(2)]


def quiet_args(argv: Sequence[str], environ: Mapping[str, str]) -> tuple[int, float | None, bool, dict[str, float]]:
    """(seconds, wait or None, json, limits), or ValueError for a usage error."""
    limits = {
        lim.name: positive(environ[lim.env], lim.env) if environ.get(lim.env, "") != "" else lim.default
        for lim in QUIET_LIMITS
    }
    seconds = 60
    wait: float | None = None
    as_json = False
    flags = {lim.flag: lim.name for lim in QUIET_LIMITS}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            as_json = True
            i += 1
            continue
        if a not in flags and a not in ("--for", "--wait"):
            raise ValueError(f"unknown argument {a}")
        if i + 1 >= len(argv):
            raise ValueError(f"{a} needs a value")
        val = argv[i + 1]
        if a == "--for":
            if not re.fullmatch(r"\d+", val) or int(val) < 1:
                raise ValueError(f"--for: a whole number of seconds, at least 1 (got {val!r})")
            seconds = int(val)
        elif a == "--wait":
            wait = duration(val)
        else:
            limits[flags[a]] = positive(val, a)
        i += 2
    if wait is not None and wait < seconds:
        raise ValueError(f"--wait ({wait:g} s) is shorter than the window (--for {seconds})")
    return seconds, wait, as_json, limits


def positive(text: str, what: str) -> float:
    """TEXT as a finite number above 0, or ValueError naming WHAT."""
    try:
        v = float(text)
        if 0 < v < float("inf"):
            return v
    except ValueError:
        pass
    raise ValueError(f"{what}: a number above 0 (got {text!r})")


def quiet_text(result: Mapping[str, Any]) -> str:
    lines = []
    for t in result["tests"]:
        unit = f" {t['unit']}" if t["unit"] else ""
        if t["error"]:
            value = "unreadable"
        elif isinstance(t["value"], float):
            value = f"{t['value']:.2f}{unit}"
        else:
            value = t["value"]
        limit = f"< {t['limit']:g}{unit}" if t["unit"] else t["limit"]
        verdict = "ok" if t["ok"] else "FAIL" + (f" ({t['error']})" if t["error"] else "")
        lines.append(f"  {t['label']:<16} {value:<12} limit {limit:<11} {verdict}")
    span = f"{result['seconds']} s, {result['start']} to {result['end']}"
    if result.get("waited_s") is not None:
        span += f", after waiting {result['waited_s']:.0f} s"
    labels = {t["name"]: t["label"] for t in result["tests"]}
    failed = ", ".join(labels[name] for name in result["failed"])
    lines.append(f"quiet ({span})" if result["quiet"] else f"NOT quiet: {failed} ({span})")
    return "\n".join(lines)


def quiet(
    argv: Sequence[str],
    sample: Callable[[], Any] | None = None,
    sleep: Callable[[float], object] = time.sleep,
    clock: Callable[[], float] = time.monotonic,
    out: TextIO | None = None,
    environ: Mapping[str, str] | None = None,
) -> int:
    """Exit 0 if a window of SECONDS was quiet, 1 if not (or --wait ran out),
    2 for a usage error. Reads only; writes nothing but its output."""
    out_stream: TextIO = sys.stdout if out is None else out
    try:
        seconds, wait, as_json, limits = quiet_args(argv, os.environ if environ is None else environ)
    except ValueError as e:
        print(f"quiet: {e}", file=sys.stderr)
        return 2
    sample_fn: Callable[[], Any] = (lambda: quiet_sample(clock=clock)) if sample is None else sample
    if wait is not None:
        print(f"waiting up to {wait:g} s for {seconds} quiet seconds in a row", file=sys.stderr)
    window: deque[Any] = deque(maxlen=seconds + 1)
    try:
        start = clock()
        window.append(sample_fn())
        n = 0
        while True:
            n += 1
            sleep(max(0.0, start + n - clock()))
            window.append(sample_fn())
            if len(window) <= seconds:
                continue
            tests = quiet_tests(window, limits)
            ok = all(t["ok"] for t in tests)
            # A file that cannot be read stays so: waiting longer cannot help.
            if ok or wait is None or clock() - start >= wait or any(t["error"] for t in tests):
                break
    except KeyboardInterrupt:
        print("quiet: interrupted", file=sys.stderr)
        return 130

    def stamp(s: Mapping[str, Any]) -> str:
        return datetime.fromtimestamp(s["wall"]).isoformat(sep=" ", timespec="seconds")

    result: dict[str, Any] = {
        "quiet": ok,
        "seconds": seconds,
        "start": stamp(window[0]),
        "end": stamp(window[-1]),
        "waited_s": None if wait is None else round(clock() - start, 1),
        "tests": tests,
        "failed": [t["name"] for t in tests if not t["ok"]],
    }
    print(json.dumps(result) if as_json else quiet_text(result), file=out_stream)
    return 0 if ok else 1


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] not in ("watch", "report", "quiet"):
        print(__doc__)
        return 2
    cmd = sys.argv[1]
    if cmd == "watch":
        return watch(sys.argv[2:])
    if cmd == "report":
        return report(sys.argv[2:])
    return quiet(sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
