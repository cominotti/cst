#!/usr/bin/env bash
#
# cst-pending-alerts
#
# Installed by btrfs-setup.sh (CST) as /usr/local/bin/cst-pending-alerts.
# Runs as the user, at each graphical login (cst-pending-alerts.service, a
# global systemd user unit): shows the alerts btrfs-notify kept because no
# desktop session could show them when they happened (at boot, before the
# login, or while nobody was logged in), each with the time it happened.
#
#   cst-pending-alerts          show the ones not shown to this user yet
#   cst-pending-alerts --list   print all pending alerts, and whether this user
#                               has seen them (`cst btrfs status`)
#
# The pending files belong to root and stay where they are (btrfs-notify drops
# them after 7 days, or when the same alert is later shown live); entries older
# than 7 days are ignored here too, in case nothing has cleaned up yet. What
# this user has seen is recorded in ~/.local/state/cst-alerts/delivered, one
# line per pending file: "<file name> <mtime> <shown|summarized> <count>
# <first>". A repeat rewrites the file (new mtime), so a problem that came back
# is shown again; count and first tell how many of its occurrences this user
# has already seen, so the text then only counts the new ones.
#
# At one login, every critical alert comes one by one, and the newest normal
# ones up to MAX_SHOWN in total; older normal ones are folded into one summary
# notification ("summarized": counted, but their text was not on screen).
#
# Nothing a user could plant is trusted: the directory and every file must be
# root's and not writable by others, no symlinks, file names are hashes,
# sizes and fields are bounded and checked.
#
# Earlier versions were named f44-tools: their record in
# ~/.local/state/f44-alerts is read when the new one does not exist yet, and
# moved to the new place at the next login (so nothing seen is shown again).
# Pending files of the old format (first line "f44-alert 1") are still read.
#
# Paths can be overridden for tests: CST_ALERTS_DIR, CST_ALERTS_OWNER (uid of
# the expected owner), CST_ALERTS_WAIT (seconds to wait for the desktop).

set -uo pipefail

ALERTS_DIR="${CST_ALERTS_DIR:-/var/lib/cst-alerts}"
PENDING="${ALERTS_DIR}/pending"
OWNER="${CST_ALERTS_OWNER:-0}"
WAIT="${CST_ALERTS_WAIT:-90}"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/cst-alerts"
DELIVERED="${STATE_DIR}/delivered"
# Where versions named f44-tools kept the record (see the top).
OLD_STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/f44-alerts"
MAX_FILE=16384          # bytes; btrfs-notify writes far less
MAX_FILES=50
MAX_SHOWN=8             # at one login; older normal ones are summed up in one notification
KEEP_DAYS=7             # same as btrfs-notify

log() { echo "<$1>cst-pending-alerts: $2" >&2; }

# trusted PATH: owned by OWNER, not a symlink, not writable by group/others.
trusted() {
    local owner mode
    [[ ! -L "$1" ]] || return 1
    read -r owner mode < <(stat -c '%u %a' -- "$1" 2>/dev/null) || return 1
    [[ "${owner}" == "${OWNER}" ]] && (( (8#${mode} & 8#022) == 0 ))
}

# Fields of the alert being read (set by parse).
A_URGENCY="" A_APP="" A_TITLE="" A_BODY="" A_FIRST=0 A_LAST=0 A_COUNT=1

# parse FILE: read one pending alert into A_*; fails on anything unexpected.
parse() {
    local line key val header=1 body=() first_line=1
    A_URGENCY="" A_APP="" A_TITLE="" A_BODY="" A_FIRST=0 A_LAST=0 A_COUNT=1
    while IFS= read -r line || [[ -n "${line}" ]]; do
        if (( first_line )); then
            [[ "${line}" == "cst-alert 1" || "${line}" == "f44-alert 1" ]] || return 1
            first_line=0
            continue
        fi
        if (( header )); then
            [[ -n "${line}" ]] || { header=0; continue; }
            key="${line%%=*}"
            val="${line#*=}"
            case "${key}" in
                urgency) A_URGENCY="${val}" ;;
                app) A_APP="${val}" ;;
                title) A_TITLE="${val}" ;;
                first) A_FIRST="${val}" ;;
                last) A_LAST="${val}" ;;
                count) A_COUNT="${val}" ;;
            esac
        else
            body+=("${line}")
        fi
    done < <(head -c "${MAX_FILE}" -- "$1")
    [[ "${A_URGENCY}" == critical || "${A_URGENCY}" == normal ]] || return 1
    [[ "${A_APP}" =~ ^[A-Za-z0-9._-]{1,40}$ ]] || return 1
    [[ "${A_FIRST}" =~ ^[0-9]{1,12}$ && "${A_LAST}" =~ ^[0-9]{1,12}$ && "${A_COUNT}" =~ ^[0-9]{1,9}$ ]] || return 1
    A_FIRST=$((10#${A_FIRST})) A_LAST=$((10#${A_LAST})) A_COUNT=$((10#${A_COUNT}))
    [[ -n "${A_TITLE}" ]] || return 1
    A_TITLE="${A_TITLE:0:200}"
    A_BODY="$(printf '%s\n' "${body[@]}")"
    A_BODY="${A_BODY:0:4000}"
}

# when EPOCH: "Mon 13 Oct 03:12", or "at boot, Mon 13 Oct 03:12" within the
# first 10 minutes of the running boot (the units that run before the login).
when() {
    local btime
    btime="$(awk '$1 == "btime" {print $2}' /proc/stat 2>/dev/null)"
    if [[ "${btime}" =~ ^[0-9]+$ ]] && (( $1 >= btime && $1 - btime < 600 )); then
        date -d "@$1" '+at boot, %a %d %b %H:%M'
    else
        date -d "@$1" '+%a %d %b %H:%M'
    fi
}

# old_record: the record of a version named f44-tools, when there is no new
# one yet. Read as it is by --list (which changes nothing); moved to the new
# place by migrate_record at a login.
old_record() {
    [[ ! -e "${STATE_DIR}" && -d "${OLD_STATE_DIR}" && ! -L "${OLD_STATE_DIR}" ]]
}
migrate_record() {
    old_record || return 0
    if mv -T -- "${OLD_STATE_DIR}" "${STATE_DIR}" 2>/dev/null; then
        log 6 "moved ${OLD_STATE_DIR} to ${STATE_DIR}"
    fi
}

# What this user saw of each pending file (load_seen): name -> "<mtime>
# <shown|summarized> <count> <first>", the newest entry only.
declare -A rec=()
load_seen() {
    local name mtime how count first delivered="${DELIVERED}"
    old_record && delivered="${OLD_STATE_DIR}/delivered"
    [[ -f "${delivered}" && ! -L "${delivered}" ]] || return 0
    while read -r name mtime how count first; do
        [[ "${name}" =~ ^[0-9a-f]{32}\.alert$ && "${mtime}" =~ ^[0-9]{1,12}(\.[0-9]{1,10})?$ ]] || continue
        # Lines of the first version had only "<name> <mtime>": shown, count unknown.
        [[ "${how:-shown}" == summarized ]] && how=summarized || how=shown
        [[ "${count:-}" =~ ^[0-9]{1,9}$ ]] || count=0
        [[ "${first:-}" =~ ^[0-9]{1,12}$ ]] || first=0
        # Several lines for one file only in records of the first version.
        if [[ -z "${rec["${name}"]:-}" ]] || (( 10#${mtime%.*} >= 10#${rec["${name}"]%%[. ]*} )); then
            rec["${name}"]="${mtime} ${how} $((10#${count})) $((10#${first}))"
        fi
    done < <(head -c 65536 -- "${delivered}")
}

# seen_as NAME MTIME: "shown" or "summarized" if this user had this very
# version of the file at a login; nothing otherwise.
seen_as() {
    local r="${rec["$1"]:-}" m
    [[ -n "${r}" ]] || return 0
    m="${r%% *}"
    # Full precision: a repeat kept within the same second is a new version.
    # Records of the first version had whole seconds only.
    if [[ "${m}" == *.* ]]; then
        [[ "${m}" == "$2" ]] || return 0
    else
        [[ "${m}" == "${2%.*}" ]] || return 0
    fi
    r="${r#* }"
    echo "${r%% *}"
}

# describe NAME: the text shown (A_* parsed): when it happened, then the
# original body. If this user saw an earlier version of the same file
# (same first occurrence), only the occurrences since then are counted.
describe() {
    local at="" p_how p_count p_first new
    if [[ -n "${rec["$1"]:-}" ]]; then
        read -r _ p_how p_count p_first <<<"${rec["$1"]}"
        if [[ "${p_how}" == shown ]] && (( p_first == A_FIRST && p_count > 0 && p_count < A_COUNT )); then
            new=$((A_COUNT - p_count))
            if (( new == 1 )); then
                at="Happened again $(when "${A_LAST}"), while no desktop session could show it."
            else
                at="Happened ${new} more times since you last saw it, while no desktop session could show it: last $(when "${A_LAST}")."
            fi
        fi
    fi
    if [[ -z "${at}" ]]; then
        if (( A_COUNT > 1 )); then
            at="Happened ${A_COUNT} times while no desktop session could show it: first $(when "${A_FIRST}"), last $(when "${A_LAST}")."
        else
            at="Happened $(when "${A_LAST}"), while no desktop session could show it."
        fi
    fi
    printf '%s\n\n%s' "${at}" "${A_BODY}"
}

# The pending files of the last KEEP_DAYS, oldest first, as "<mtime> <name>"
# (names already checked; mtime with its fraction, as find prints it).
pending_files() {
    trusted "${ALERTS_DIR}" && [[ -d "${PENDING}" ]] && trusted "${PENDING}" || return 0
    find "${PENDING}" -maxdepth 1 -type f -regextype posix-extended -regex '.*/[0-9a-f]{32}\.alert' \
        -size -$((MAX_FILE + 1))c -mmin -$((KEEP_DAYS * 1440)) -printf '%T@ %f\n' 2>/dev/null |
        sort -n | tail -n "${MAX_FILES}"
}

notification_server_up() {
    busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
        NameHasOwner s org.freedesktop.Notifications 2>/dev/null | grep -q true
}

list() {
    local mtime name file n=0 mark
    load_seen
    while read -r mtime name; do
        file="${PENDING}/${name}"
        trusted "${file}" && parse "${file}" || continue
        n=$((n + 1))
        if (( EUID == 0 )); then
            mark=""
        else
            case "$(seen_as "${name}" "${mtime}")" in
                shown) mark="  [shown to you]" ;;
                summarized) mark="  [only counted in the summary at login; text not shown]" ;;
                *) mark="  [NOT shown to you yet: next login]" ;;
            esac
        fi
        printf '%s  %-8s %s: %s%s%s\n' "$(when "${A_LAST}")" "${A_URGENCY}" "${A_APP}" "${A_TITLE}" \
            "$( (( A_COUNT > 1 )) && echo " (${A_COUNT} times)")" "${mark}"
    done < <(pending_files)
    (( n )) || echo "none"
}

show() {
    local mtime name file waited=0 i todo=() crit=() norm=() count=() first=() pick=() skip=() done_rec=()
    migrate_record
    load_seen
    # Oldest first. Parsed once here: urgency decides what comes one by one.
    while read -r mtime name; do
        [[ -z "$(seen_as "${name}" "${mtime}")" ]] || continue
        file="${PENDING}/${name}"
        trusted "${file}" && parse "${file}" || { log 4 "${name}: not a valid pending alert; skipped"; continue; }
        i=${#todo[@]}
        todo+=("${mtime} ${name}")
        count+=("${A_COUNT}")
        first+=("${A_FIRST}")
        if [[ "${A_URGENCY}" == critical ]]; then crit+=("${i}"); else norm+=("${i}"); fi
    done < <(pending_files)
    (( ${#todo[@]} )) || exit 0
    # Started with the session: give the desktop's notification server time to come up.
    until notification_server_up; do
        (( waited >= WAIT )) && { log 4 "no notification server after ${WAIT} s; trying at the next login"; exit 0; }
        sleep 2
        waited=$((waited + 2))
    done
    # So the login is not buried after a long night: every critical alert
    # comes one by one (never hidden behind harmless ones), then the newest
    # normal ones up to MAX_SHOWN; older normal ones become one summary.
    local room=$(( MAX_SHOWN - ${#crit[@]} ))
    (( room > 0 )) || room=0
    local nskip=$(( ${#norm[@]} > room ? ${#norm[@]} - room : 0 ))
    skip=("${norm[@]:0:${nskip}}")
    mapfile -t pick < <(printf '%s\n' "${crit[@]}" "${norm[@]:${nskip}}" | grep . | sort -n)
    if (( nskip )) && notify-send -u normal -a cst-pending-alerts -i drive-harddisk -- \
        "${nskip} more storage alert(s) while nobody was logged in" \
        "Older and not critical (critical ones are always shown). Read them: cst-pending-alerts --list (or cst btrfs status)."; then
        for i in "${skip[@]}"; do
            done_rec+=("${todo[i]#* } ${todo[i]%% *} summarized ${count[i]} ${first[i]}")
        done
    fi
    for i in "${pick[@]}"; do
        mtime="${todo[i]%% *}"
        name="${todo[i]#* }"
        file="${PENDING}/${name}"
        trusted "${file}" && parse "${file}" || { log 4 "${name}: not a valid pending alert; skipped"; continue; }
        if notify-send -u "${A_URGENCY}" -a "${A_APP}" -i drive-harddisk -- "${A_TITLE}" "$(describe "${name}")"; then
            done_rec+=("${name} ${mtime} shown ${count[i]} ${first[i]}")
            log 5 "shown: ${A_APP}: ${A_TITLE} (last $(when "${A_LAST}"))"
        fi
    done
    (( ${#done_rec[@]} )) || exit 0
    # Rewrite the record: one line per pending file that is still there (the
    # others are gone for good, so the record stays small), the newest wins.
    local tmp entry
    for entry in "${done_rec[@]}"; do
        rec["${entry%% *}"]="${entry#* }"
    done
    mkdir -p "${STATE_DIR}" && chmod 0700 "${STATE_DIR}" || exit 1
    tmp="$(mktemp "${STATE_DIR}/.delivered.XXXXXX")" || exit 1
    for name in "${!rec[@]}"; do
        [[ -f "${PENDING}/${name}" ]] && echo "${name} ${rec["${name}"]}"
    done | sort >"${tmp}" && mv -f "${tmp}" "${DELIVERED}" || rm -f "${tmp}"
}

case "${1:-}" in
    "") show ;;
    --list) list ;;
    *) echo "usage: cst-pending-alerts [--list]" >&2; exit 2 ;;
esac
