#!/usr/bin/python3 -I
# SPDX-License-Identifier: MPL-2.0
#
# btrfs-stall-report
#
# Installed by btrfs-setup.sh (CST). Summarises what
# btrfs-stall-monitord (and, if installed, below) recorded for a time window:
# was storage the bottleneck, and if so why. No root needed.
#
#   btrfs-stall-report                        last 30 minutes
#   btrfs-stall-report --since '20 min ago'   (anything `date -d` accepts, or @epoch)
#   btrfs-stall-report --since 10:30 --until 10:45 -v
#   btrfs-stall-report --since '1 day ago' --json
#
# Run the workload normally (cargo test, docker compose up, ...); query the
# window afterwards. Nothing has to wrap the command. Data reaches disk about
# every 10 s, so query ~15 s after the slow part ends.

import os.path as _cst_path
import sys as _cst_sys

# CST bootstrap (the same in every entry point; tests/test_entrypoints.py checks
# it): from a checkout, cst_core and the module packages are in the folder above
# this file, and Python writes no bytecode there (no __pycache__ in the checkout,
# even for a program run by its shebang as root); inside an installed zipapp,
# sys.path already holds the archive.
_cst_root = _cst_path.dirname(_cst_path.dirname(_cst_path.realpath(__file__)))
if not _cst_path.isfile(_cst_path.dirname(__file__)) and _cst_root not in _cst_sys.path:
    _cst_sys.dont_write_bytecode = True
    _cst_sys.path.insert(0, _cst_root)

from btrfs.stall_report import cli


def main() -> None:
    """Run btrfs-stall-report with this program's arguments."""
    cli.main()


if __name__ == "__main__":
    main()
