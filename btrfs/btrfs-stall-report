LOG_DIR = "/var/log/btrfs-stall-monitor"
GAP_MAX = 30.0        # s; a larger gap between samples means the daemon was not running
HUNG_SECONDS = 30             # the daemon's threshold for hung / busy waits
FRESH_MAX = 25.0      # s; newer data may still be buffered in the daemon
PAGE = 4096

DISK_FIELDS = ("rd_ios", "rd_merges", "rd_sectors", "rd_ticks", "wr_ios", "wr_merges",
               "wr_sectors", "wr_ticks", "inflight", "io_ticks", "time_in_queue",
               "dc_ios", "dc_merges", "dc_sectors", "dc_ticks", "fl_ios", "fl_ticks")
DI = {k: i for i, k in enumerate(DISK_FIELDS)}
DISK_SUM = ("rd_ios", "wr_ios", "rd_ticks", "wr_ticks", "rd_sectors", "wr_sectors",
            "io_ticks", "time_in_queue", "fl_ios", "fl_ticks")

# Rules that look at the whole stack first: the reason a task waits is often
# several frames below the innermost wait (a commit waiting for ordered extents
# is still a commit; a page fault waiting for swap-in is reclaim, not a read).
# A FUSE filesystem (gvfs network shares, document portal) answers from a
# userspace daemon: the wait is on that daemon / the network, not the disks.
FUSE_RE = re.compile(r"^(?:request_wait_answer|fuse_\w+)$")
# btrfs housekeeping (fstrim/FITRIM, async discard workers, scrub, balance):
# background work that sits in D state for minutes by design. Same frame list
# as MAINT_FRAME in btrfs-stall-monitord (daemon v5+ tags these waits
# "maintenance"); matching it here also re-classifies older recordings.
MAINT_RE = re.compile(
    r"^(?:btrfs_ioctl_fitrim|btrfs_trim_\w+|do_trimming|trim_bitmaps|trim_no_bitmap"
    r"|btrfs_discard_workfn|btrfs_ioctl_scrub|btrfs_scrub_dev|scrub_\w+|flush_scrub_stripes"
    r"|btrfs_ioctl_balance|btrfs_balance\w*|btrfs_relocate_\w+|relocate_\w+|btrfs_reclaim_bgs_work)$")
# Old "hung" events/alerts (daemon <= v4) of maintenance tasks, for records
# without a usable stack (v2 events, alerts): the task's comm or its systemd
# unit. Alerts carry the same text as their event.
MAINT_TEXT = re.compile(r"(?:^|task )fstrim:\d+|cgroup (?:fstrim|btrfs-scrub|btrfs-balance)[\w@.-]*\.service")
STACK_RULES = [
    ("fuse", FUSE_RE),
    ("maintenance", MAINT_RE),
    ("reclaim", re.compile(r"^(?:do_swap_page|swap_read_folio|swap_cluster_readahead|__swap_writepage)$")),
    # A log sync can fall back to a full commit: then commit_transaction is on the stack.
    ("commit", re.compile(r"^(?:btrfs_commit_transaction|btrfs_wait_for_commit)$")),
    ("log-sync", re.compile(r"^btrfs_sync_log$")),
]
# Then the innermost meaningful frame, first match wins.
CATEGORIES = [
    ("maintenance", r"^(?:btrfs_ioctl_fitrim|btrfs_trim_\w+|do_trimming|trim_bitmaps|trim_no_bitmap"
                    r"|btrfs_discard_workfn|btrfs_ioctl_scrub|btrfs_scrub_dev|scrub_\w+|flush_scrub_stripes"
                    r"|btrfs_ioctl_balance|btrfs_balance\w*|btrfs_relocate_\w+|relocate_\w+"
                    r"|btrfs_reclaim_bgs_work)$",
     "btrfs maintenance (fstrim/discard, scrub, balance)"),
    ("zstd-workspace", r"zstd|get_workspace|find_workspace",
     "waiting for a btrfs zstd compression workspace"),
    ("dirty-throttle", r"^balance_dirty_pages",
     "writers throttled by the dirty-page limit (vm.dirty_bytes)"),
    ("commit", r"commit_transaction|transaction_kthread|wait_current_trans|wait_for_commit|btrfs_sync_fs|join_transaction"
               r"|start_transaction",
     "btrfs transaction commit"),
    ("log-sync", r"tree_log|sync_log|wait_log_commit|wait_for_writer",
     "fsync log-tree sync (btrfs_sync_log)"),
    ("flush", r"barrier_all_devices|write_dev_flush|wait_dev_flush|wait_dev_supers|blkdev_issue_flush"
              r"|write_all_supers",
     "disk cache flushes (fsync / commit barriers on every RAID1 member)"),
    ("space", r"reserve_metadata|reserve_data|reserve_ticket|flush_space|btrfs_reserve|reserve_space"
              r"|delalloc_reserve",
     "btrfs space reservation / flushing"),
    ("writeback", r"ordered_extent|wait_ordered|lock_and_flush|folio_wait_writeback|page_writeback|fdatawait"
                  r"|wait_sb_inodes|writeback_inodes|wb_wait|sync_inodes",
     "waiting for data writeback (btrfs ordered extents / fsync)"),
    ("wbt", r"wbt_wait|rq_qos_wait", "block-layer writeback throttling (WBT)"),
    ("metadata-read", r"read_extent_buffer_pages|read_tree_block|btrfs_read_extent_buffer|read_block_for_search"
                      r"|btrfs_readahead_tree_block",
     "reading btrfs metadata from disk (cold cache)"),
    ("btrfs-locks", r"btrfs_tree_lock|btrfs_tree_read_lock|__btrfs_tree|btrfs_lock_root|btrfs_search_slot"
                    r"|lock_extent|btrfs_inode_lock|btrfs_read_lock",
     "btrfs b-tree / extent / inode lock contention"),
    ("reclaim", r"shrink_|try_to_free|alloc_pages|swap|zswap|mem_cgroup_handle_over_high"
                r"|throttle_direct_reclaim",
     "memory reclaim / swap"),
    ("discard", r"discard", "async discard (discard=async)"),
    ("overlayfs", r"^ovl_", "overlayfs copy-up (containers)"),
    ("device", r"blk_mq_get_tag|submit_bio_wait|^blk_|nvme|^dm_|kcryptd|dmcrypt|^crypt_|^bio_",
     "block device queue (device or dm-crypt)"),
    ("page-read", r"filemap_read|filemap_get_pages|folio_wait_locked|folio_lock|filemap_fault|readahead"
                  r"|read_folio|do_readpage",
     "reading data not in the page cache"),
]
# Waits that are not about storage at all (D state is used by more than IO).
# worker_thread/kthread here only matter for daemon v2 data, where a task that
# woke up between its stat and stack reads was still sampled.
IDLE_SIG = re.compile(r"^(?:futex_\w+|__futex_\w+|ep_poll|do_epoll_wait|do_select|do_sys_poll|usb_\w+"
                      r"|worker_thread|kthread|do_nanosleep|hrtimer_nanosleep|pipe_\w+"
                      r"|unix_\w+|n_tty_\w+|tty_\w+|wait_for_partner|do_wait|kernel_wait4|rcu_\w+"
                      r"|poll_schedule_timeout\w*|intel_\w+|drm_\w+|i915_\w+|xe_\w+|pci_\w+)$")
# "maintenance" replaces the former "scrub" category (scrub is maintenance too).
NON_STORAGE = ("fuse", "idle", "maintenance")
V2_HUNG_SIG = re.compile(r" at (\S+)")
CAT_RE = [(k, re.compile(rx)) for k, rx, _ in CATEGORIES]
CAT_DESC = {k: d for k, _, d in CATEGORIES}
CAT_DESC["other"] = "other kernel waits"
CAT_DESC["no-stack"] = "unknown (no kernel stack captured)"
CAT_DESC["fuse"] = "FUSE filesystem (gvfs share / document portal; usually network or the FUSE daemon)"
CAT_DESC["idle"] = "non-storage waits (futex, epoll, USB, GPU / PCI power management)"

