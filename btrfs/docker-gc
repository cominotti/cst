#!/usr/bin/python3 -I
"""docker-gc: conservative garbage collection for the Docker engine.

Installed by `cst btrfs docker-gc enable` (CST) as
/usr/local/sbin/docker-gc. Runs as root.

  docker-gc record      (docker-gc-recorder.service) follows `docker events`
                        and records when each image was last used (container
                        created, started or stopped; image pulled, built,
                        tagged, loaded). Docker itself keeps no "last used"
                        time, and its `until` filters look at the build date.
  docker-gc run [--dry-run]  (docker-gc.timer, weekly) removes:
      * ephemeral containers stopped for KEEP_CONTAINER_DAYS: a name Docker
        generated (its own word lists) or a Testcontainers label, and no
        compose/k3d/kind/devcontainer label and no restart policy;
      * anonymous volumes no container references (named volumes: never);
      * images no remaining container references and not used for
        KEEP_IMAGE_DAYS; never images of PROTECTED registries (corporate:
        re-pulling needs the tunnel, and a build's FROM image leaves no
        event), and none at all unless the recorder is running;
      * build cache unused for KEEP_BUILD_CACHE_DAYS.
  docker-gc cleanup-now  one-off, interactive: everything unused that was not
                        seen in use in the window, listed in full; protected
                        images only after a second, separate confirmation.
  docker-gc status      what a run would remove now, and the tracking state.
"""

import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime

STATE_DIR = os.environ.get("DOCKER_GC_STATE", "/var/lib/docker-gc")   # override: tests
LAST_USED = os.path.join(STATE_DIR, "last-used.json")
LAST_RUN = os.path.join(STATE_DIR, "last-run.json")
LOCK = "/run/docker-gc.lock"
DAY = 86400
KEEP_CONTAINER_DAYS = int(os.environ.get("KEEP_CONTAINER_DAYS", 7))
KEEP_IMAGE_DAYS = int(os.environ.get("KEEP_IMAGE_DAYS", 14))
KEEP_BUILD_CACHE_DAYS = int(os.environ.get("KEEP_BUILD_CACHE_DAYS", 14))
PROTECTED = tuple(r.strip() + "/" for r in
                  os.environ.get("DOCKER_GC_PROTECT", "harbor-dev.matera.com").split(",") if r.strip())
FLUSH_SECONDS = int(os.environ.get("DOCKER_GC_FLUSH", 30))
HEARTBEAT_SECONDS = 300
MIN_UPTIME = 600   # after boot, restart-policy containers are still coming up
# Containers that belong to something the user manages as a unit.
KEEP_LABEL_PREFIXES = ("com.docker.compose.", "k3d.", "io.x-k8s.kind.", "dev.containers.",
                       "devcontainer.", "com.docker.desktop.")
TESTCONTAINERS_LABEL = "org.testcontainers"

