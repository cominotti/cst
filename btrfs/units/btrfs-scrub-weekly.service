# Managed by btrfs-setup.sh (CST).
[Unit]
Description=Weekly btrfs scrub of the root and cache filesystems
After=local-fs.target
# Scrub errors (exit 3) or a failed scrub still end in an alert.
OnFailure=btrfs-health-check.service

[Service]
Type=oneshot
# -B: stay in foreground so systemd sees the result; scrub covers every device.
ExecStart=/usr/sbin/btrfs scrub start -B /var
ExecStart=/usr/bin/sh -c 'if /usr/bin/findmnt -rn -t btrfs -M /var/mnt/cache >/dev/null 2>&1; then exec /usr/sbin/btrfs scrub start -B /var/mnt/cache; fi'
ExecStartPost=-/usr/local/sbin/btrfs-health-check
Nice=19
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
