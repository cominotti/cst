# SPDX-License-Identifier: MPL-2.0
# Managed by btrfs-setup.sh (CST). Enabled only by 'cst btrfs docker-gc enable'.
[Unit]
Description=Remove stale Docker containers, images, anonymous volumes and build cache
After=docker.service docker-gc-recorder.service

[Service]
Type=oneshot
# Never start a socket-activated daemon just to clean it.
ExecCondition=/usr/bin/systemctl -q is-active docker.service
ExecStart=/usr/local/sbin/docker-gc run
Nice=19
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=1h
# Sandbox: it needs only the docker CLI over /run/docker.sock (owned by root, so
# no capability), `systemctl is-active` and writes in /var/lib/docker-gc (its
# state, StateDirectory=) and /run/docker-gc (the run lock, RuntimeDirectory=),
# the only writable places. The lock folder stays after the run: a cleanup-now
# that holds the lock then keeps its file.
# No NoNewPrivileges=: Fedora's SELinux policy labels /usr/local/sbin/docker*
# container_runtime_exec_t (like dockerd), and the program reaches
# /run/docker.sock only after the exec moves it into that domain; with
# NoNewPrivileges the kernel blocks that move, the program stays in init_t and
# every docker call fails with "permission denied". The other settings below
# do not switch it on (checked on Fedora: NoNewPrivs stays 0 in
# /proc/PID/status).
CapabilityBoundingSet=
ProtectSystem=strict
StateDirectory=docker-gc
RuntimeDirectory=docker-gc
RuntimeDirectoryPreserve=yes
# The docker CLI reads its settings from /root/.docker.
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# `docker builder prune` goes through the buildx plugin, which keeps its
# state in ~/.docker/buildx by default: read-only here, so in the state folder.
Environment=BUILDX_CONFIG=/var/lib/docker-gc/buildx
