[Unit]
Description=Record btrfs / IO stall telemetry (read-only)
Documentation=file:///usr/local/sbin/btrfs-stall-monitord
After=local-fs.target

[Service]
# The daemon says READY=1 once it is sampling, and WATCHDOG=1 at every pass of
# its loop (at least every 5 s). When those stop for WatchdogSec= (a deadlock, a
# read stuck for minutes), systemd logs "Watchdog timeout", kills it and
# Restart= starts it again: "active" means "still sampling". 2 min is far above
# the loop's longest pass and leaves room for reads the stall slows down. The
# program is installed before this unit (an older daemon never sends READY=1).
# NotifyAccess=main is Type=notify's default, spelled out: only the daemon sends.
Type=notify
NotifyAccess=main
WatchdogSec=2min
# The watchdog kills with SIGABRT: no core dump of the Python daemon written
# to the disks during the stall it was recording (it would help nobody).
LimitCORE=0
ExecStart=/usr/bin/python3 -I /usr/local/sbin/btrfs-stall-monitord
# Journal lines under its own name (journalctl -t btrfs-stall-monitord), not "python3".
SyslogIdentifier=btrfs-stall-monitord
Restart=on-failure
RestartSec=10
# Data holds kernel messages and process names: readable by wheel only.
Group=wheel
LogsDirectory=btrfs-stall-monitor
LogsDirectoryMode=0750
RuntimeDirectory=btrfs-stall-monitor
RuntimeDirectoryMode=0700
# Alerts queued there (alert-*.txt, drained by btrfs-stall-alert.service and the
# hourly health check) survive a restart, also an automatic one after a crash;
# a stop still removes the folder.
RuntimeDirectoryPreserve=restart
UMask=0027
# Must keep sampling while everything else is stalled.
Nice=-5
MemoryMax=192M
CPUQuota=25%
TasksMax=8
# Only what reading other tasks' kernel stacks (/proc/PID/stack: SYS_ADMIN +
# SYS_PTRACE), /proc/PID/io and /dev/kmsg (SYSLOG) needs. No writes outside
# the logs/runtime directories.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYSLOG
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
DevicePolicy=closed
DeviceAllow=/dev/kmsg r

[Install]
WantedBy=multi-user.target
