# SPDX-License-Identifier: MPL-2.0
# Managed by btrfs-setup.sh (CST). Enabled only by 'cst btrfs docker-gc enable'.
# Follows `docker events` and records when each image was last used: Docker
# keeps no such time, and docker-gc must not delete what a test used yesterday.
[Unit]
Description=Record Docker image use for docker-gc
After=docker.service
BindsTo=docker.service

[Service]
ExecStart=/usr/local/sbin/docker-gc record
Restart=on-failure
RestartSec=10
# 65: a record of a newer docker-gc (after going back to an older CST). Restarting would only read the
# same file again every 10 s; the unit stays failed instead, which cst doctor lists.
# 76: a docker inspect record without a key docker-gc relies on: Docker answers the same at every start.
# Only docker-gc's own refusals: when `docker events` itself ends with 65 or 76, record exits 1 (restarted).
RestartPreventExitStatus=65 76
Nice=10
# Sandbox: it needs only the docker CLI over /run/docker.sock (owned by root, so
# no capability), `systemctl is-active` and writes in /var/lib/docker-gc (its
# state), the one writable place (StateDirectory=). It takes no run lock.
# No NoNewPrivileges=: Fedora's SELinux policy labels /usr/local/sbin/docker*
# container_runtime_exec_t (like dockerd), and the program reaches
# /run/docker.sock only after the exec moves it into that domain; with
# NoNewPrivileges the kernel blocks that move, the program stays in init_t and
# every docker call fails with "permission denied". The other settings below
# do not switch it on (checked on Fedora: NoNewPrivs stays 0 in
# /proc/PID/status).
CapabilityBoundingSet=
ProtectSystem=strict
StateDirectory=docker-gc
# The docker CLI reads its settings from /root/.docker.
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=docker.service
