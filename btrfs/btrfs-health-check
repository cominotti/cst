# SPDX-License-Identifier: MPL-2.0
"""btrfs-health-check

Hourly check installed by btrfs-setup.sh (CST); alerts through
/usr/local/sbin/btrfs-notify. Never changes the filesystem; the only
writes are btrfs-degraded-boot markers in /var/lib/btrfs-degraded-boot
(records complete_since=, deletes the marker once RAID1 is verified restored)
and the journal cursor and reclaim error counts in /var/lib/btrfs-health-check.
It also asks btrfs-notify to drop alerts kept for a login that are older than
7 days (/var/lib/cst-alerts/pending), so they expire even when no new alert
comes, and to deliver stall-monitor alerts still waiting in its queue.
The NVMe health log (SMART) is read for the btrfs member disks and for the
disks under every swap device in /proc/swaps (swap has no second copy).
Exit 0 = healthy, 1 = at least one problem was alerted.

CST_HEALTH_ROOT (tests only): a folder every file path is read and written
under (/proc, /sys, /etc, /run, /var, /usr), instead of /. Commands still
come from PATH.
"""

import os.path as _cst_path
import sys as _cst_sys

# CST bootstrap (the same in every entry point; tests/test_entrypoints.py checks
# it): from a checkout, cst_core and the module packages are in the folder above
# this file; inside an installed zipapp, sys.path already holds the archive.
_cst_root = _cst_path.dirname(_cst_path.dirname(_cst_path.realpath(__file__)))
if not _cst_path.isfile(_cst_path.dirname(__file__)) and _cst_root not in _cst_sys.path:
    _cst_sys.path.insert(0, _cst_root)

import sys

from btrfs.health_check import cli


def main() -> int:
    """Run btrfs-health-check (it takes no arguments)."""
    return cli.main(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
