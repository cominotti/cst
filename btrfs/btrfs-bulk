class Unexpected(Exception):
    """A state this tool does not change by itself."""


def log(msg):
    print(msg, flush=True)


# ---- filesystem primitives (replaced by fakes in btrfs/tests/test_btrfs_bulk.py) ----
def flags(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        return struct.unpack("l", fcntl.ioctl(fd, GET, struct.pack("l", 0)))[0]
    finally:
        os.close(fd)


def is_nocow(path):
    return bool(flags(path) & NOCOW)


def set_nocow(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        cur = struct.unpack("l", fcntl.ioctl(fd, GET, struct.pack("l", 0)))[0]
        if not cur & NOCOW:
            fcntl.ioctl(fd, SET, struct.pack("l", cur | NOCOW))
    finally:
        os.close(fd)


def is_subvol(path):
    """A btrfs subvolume root: inode 256 on btrfs (lstat: a symlink is not one)."""
    try:
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode) or st.st_ino != 256:
            return False
        return _fs_magic(path) == BTRFS_MAGIC
    except OSError:
        return False


def _fs_magic(path):
    # statfs f_type is not in os.statvfs: ask stat(1).
    r = subprocess.run(["stat", "-f", "-c", "%t", path], capture_output=True, text=True)
    try:
        return int(r.stdout.strip(), 16)
    except ValueError:
        return 0


def subvol_create(path):
    """Create PATH as a subvolume, as the calling (unprivileged) user: btrfs
    allows that wherever the user may create a folder."""
    parent, name = os.path.split(path)
    fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        # struct btrfs_ioctl_vol_args is 4096 bytes: a mutable buffer (an
        # immutable argument is limited to 1024 bytes by fcntl.ioctl).
        fcntl.ioctl(fd, SUBVOL_CREATE, bytearray(struct.pack("q4088s", 0, name.encode())))
    finally:
        os.close(fd)
    os.chmod(path, 0o755)


def mounts():
    """Mount points of this namespace."""
    out = []
    try:
        with open("/proc/self/mountinfo") as f:
            for line in f:
                p = line.split()[4]
                out.append(p.replace("\\040", " "))
    except OSError:
        pass
    return out


def busy_paths(paths, home):
    """The subset of PATHS some process uses (open file, cwd, root, binary,
    mapped file, or a container's bind mount of the path, of something below
    it, or of a folder between it and HOME, e.g. -v ~/.m2:/root/.m2), from
    btrfs-snapshot's own detection. If it cannot be asked, all are busy."""
    if not paths:
        return set()
    try:
        r = subprocess.run(["bash", SNAPSHOT, "busy", "--home", home, *paths],
                           capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"  cannot check open files ({e}): treated as busy")
        return set(paths)
    if r.returncode != 0:
        log(f"  cannot check open files ({r.stderr.strip()[:200]}): treated as busy")
        return set(paths)
    return {line for line in r.stdout.splitlines() if line}


def du_bytes(path):
    r = subprocess.run(["du", "-sxb", "--", path], capture_output=True, text=True)
    try:
        return int(r.stdout.split()[0])
    except (IndexError, ValueError):
        return 0


def free_bytes(path):
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


def flatpak_installed(app):
    r = subprocess.run(["flatpak", "info", app], capture_output=True, text=True)
    return r.returncode == 0


def flatpak_has_fs(app, path):
    r = subprocess.run(["flatpak", "override", "--user", "--show", app], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if line.startswith("filesystems="):
            return path in line.split("=", 1)[1].split(";")
    return False


def flatpak_add_fs(app, path):
    r = subprocess.run(["flatpak", "override", "--user", f"--filesystem={path}", app],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"flatpak override failed: {r.stderr.strip()[:200]}")


def copy_tree(src, dst, nocow):
    """cp src/. into the empty folder dst. NOCOW: a real copy (+C applies
    only to empty files: every file is created inside dst, which has +C, and
    inherits it before data is written). Otherwise reflink clones where
    possible (same filesystem: no data written)."""
    reflink = "--reflink=never" if nocow else "--reflink=auto"
    r = subprocess.run(["cp", "-a", reflink, "--sparse=auto", "--", src + "/.", dst + "/"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"copy failed: {r.stderr.strip()[:300]}")


# ---- running as the user --------------------------------------------------------------
class Ctx:
    def __init__(self, home, pw=None):
        self.home = os.path.realpath(home)
        self.bulk = os.path.join(self.home, "Bulk")
        self.pw = pw            # None: already the user (tests, non-root runs)

    def target(self, item):
        return os.path.join(self.bulk, item.target)

    def link(self, item):
        return os.path.join(self.home, item.link) if item.link else None

    def short(self, path):
        return "~" + path[len(self.home):] if path.startswith(self.home + "/") else path


def as_user(ctx, fn, *args):
    """fn(*args) in a child process with the user's uid, gids and HOME.
    Returns its JSON-able result; an exception there is raised here again."""
    if ctx.pw is None:
        return fn(*args)
    sys.stdout.flush()
    sys.stderr.flush()
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        code = 0
        try:
            os.close(r)
            pw = ctx.pw
            os.setgroups(os.getgrouplist(pw.pw_name, pw.pw_gid))
            os.setresgid(pw.pw_gid, pw.pw_gid, pw.pw_gid)
            os.setresuid(pw.pw_uid, pw.pw_uid, pw.pw_uid)
            os.umask(0o022)
            os.chdir(ctx.home)
            for k in [k for k in os.environ if k.startswith("XDG_")]:
                del os.environ[k]
            os.environ.update(HOME=pw.pw_dir, USER=pw.pw_name, LOGNAME=pw.pw_name)
            out = {"ok": fn(*args)}
        except Unexpected as e:
            out = {"unexpected": str(e)}
        except BaseException as e:   # noqa: BLE001 - reported to the parent
            out = {"error": f"{type(e).__name__}: {e}"}
            code = 1
        try:
            os.write(w, json.dumps(out).encode())
        finally:
            sys.stdout.flush()
            sys.stderr.flush()
            os._exit(code)
    os.close(w)
    data = b""
    while True:
        chunk = os.read(r, 65536)
        if not chunk:
            break
        data += chunk
    os.close(r)
    os.waitpid(pid, 0)
    try:
        out = json.loads(data or b"{}")
    except ValueError:
        out = {}
    if "unexpected" in out:
        raise Unexpected(out["unexpected"])
    if "ok" not in out:
        raise RuntimeError(out.get("error", "child process died"))
    return out["ok"]


# ---- inspection (read-only; fine as root: lstat never follows a link) -------------------
def kind(path):
    """absent | link | dir | other (lstat)."""
    try:
        st = os.lstat(path)
    except (FileNotFoundError, NotADirectoryError):
        return "absent"
    if stat.S_ISLNK(st.st_mode):
        return "link"
    return "dir" if stat.S_ISDIR(st.st_mode) else "other"


def chain(base, rel):
    """Every component of base/rel: ok (real folders), absent (one is
    missing), or 'symlink:<path>' / 'file:<path>'."""
    path = base
    for part in [p for p in rel.split("/") if p]:
        path = os.path.join(path, part)
        k = kind(path)
        if k == "absent":
            return "absent"
        if k == "link":
            return "symlink:" + path
        if k == "other":
            return "file:" + path
    return "ok"


def empty_dir(path):
    with os.scandir(path) as it:
        return next(it, None) is None


def link_target(path):
    """Where the symlink PATH points, made absolute and normalized (no lookup)."""
    t = os.readlink(path)
    return os.path.normpath(t if os.path.isabs(t) else os.path.join(os.path.dirname(path), t))


def has_mount(path):
    return any(m == path or m.startswith(path + "/") for m in mounts())


def cow_data(top):
    """Regular files with data and without +C below top, and whether top or a
    folder below it lacks +C (new files there would be copy-on-write)."""
    files, dirs_cow = 0, not is_nocow(top)
    dev = os.lstat(top).st_dev
    for root, dirs, names in os.walk(top):
        keep = []
        for d in dirs:
            st = os.lstat(os.path.join(root, d))
            if stat.S_ISDIR(st.st_mode) and st.st_dev == dev:
                keep.append(d)
                if not is_nocow(os.path.join(root, d)):
                    dirs_cow = True
        dirs[:] = keep
        for n in names:
            p = os.path.join(root, n)
            st = os.lstat(p)
            if stat.S_ISREG(st.st_mode) and st.st_size and not is_nocow(p):
                files += 1
    return files, dirs_cow


def tree_stats(top, uid=None):
    """(entries, bytes of regular files, foreign, others): foreign is True if
    a folder below is another subvolume or filesystem (cp would copy it);
    others counts entries not owned by uid (None: not counted)."""
    entries = size = others = 0
    foreign = False
    dev = os.lstat(top).st_dev
    for root, dirs, names in os.walk(top):
        entries += len(dirs) + len(names)
        keep = []
        for d in dirs:
            st = os.lstat(os.path.join(root, d))
            if uid is not None and st.st_uid != uid:
                others += 1
            if not stat.S_ISDIR(st.st_mode):
                continue
            if st.st_dev != dev or is_subvol(os.path.join(root, d)):
                foreign = True
                continue
            keep.append(d)
        dirs[:] = keep
        for n in names:
            st = os.lstat(os.path.join(root, n))
            if uid is not None and st.st_uid != uid:
                others += 1
            if stat.S_ISREG(st.st_mode):
                size += st.st_size
    return entries, size, foreign, others


def changed_since(top, stamp, mindepth=0):
    """True if anything at/below top has a ctime >= stamp (ns). ctime cannot
    be set back by programs; >= also counts a change in the same clock tick."""
    if mindepth == 0 and os.lstat(top).st_ctime_ns >= stamp:
        return True
    for root, dirs, names in os.walk(top):
        for n in dirs + names:
            try:
                if os.lstat(os.path.join(root, n)).st_ctime_ns >= stamp:
                    return True
            except FileNotFoundError:
                return True
    return False


def target_state(ctx, item):
    """absent | empty | data | bad:<reason> for ~/Bulk/<target>."""
    c = chain(ctx.bulk, item.target)
    if c.startswith(("symlink:", "file:")):
        what, p = c.split(":", 1)
        return f"bad:{ctx.short(p)} is a {'symlink' if what == 'symlink' else 'file'}"
    if c == "absent":
        return "absent"
    return "empty" if empty_dir(ctx.target(item)) else "data"


def bulk_state(ctx):
    k = kind(ctx.bulk)
    if k == "absent":
        return "create"
    if k != "dir":
        return "bad"
    return "ok" if is_subvol(ctx.bulk) else "plain"


def tag_state(ctx):
    p = os.path.join(ctx.bulk, "CACHEDIR.TAG")
    k = kind(p)
    if k == "absent":
        return "create"
    if k != "other" or not stat.S_ISREG(os.lstat(p).st_mode):
        return "bad"
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        head = os.read(fd, len(TAG_SIGNATURE))
    finally:
        os.close(fd)
    return "ok" if head == TAG_SIGNATURE.encode() else "bad"


def classify(ctx, item, done, kept=None):
    """(state, detail). done: ids already in place this run (for `after`);
    kept: ids kept in /home by choice (None: read from KEEP).
    States: kept, ok, mkdir, link, move, move-subvol, nocow, wait, unexpected;
    ok and mkdir carry 'nolink' in detail when the tool's parent folder is
    absent; kept carries 'linked' when the link into ~/Bulk is still there."""
    if kept is None:
        kept = read_keep()[0]
    if item.id in kept:
        L = ctx.link(item)
        linked = bool(L) and kind(L) == "link" and link_target(L) == ctx.target(item)
        return "kept", "linked" if linked else ""
    if item.after and item.after in kept:
        why = f"~/{BY_ID[item.after].link} is kept in /home (by choice)"
        L = ctx.link(item)
        if L and chain(ctx.home, item.link) == "ok" and not is_subvol(L) and not empty_dir(L):
            # Its data would stay in /home snapshots without anyone deciding so.
            return "unexpected", (f"{why}, so this cannot move into ~/Bulk and its data stays in /home: "
                                  f"'bulk keep {item.id}' too, or 'bulk unkeep {item.after}'")
        return "wait", f"{why}: keep {item.id} too, or 'bulk unkeep {item.after}'"
    if item.after and item.after not in done:
        return "wait", f"after ~/{BY_ID[item.after].link} is in place"
    ts = target_state(ctx, item)
    if ts.startswith("bad:"):
        return "unexpected", ts[4:]
    T = ctx.target(item)
    if item.link is None:
        return ("mkdir" if ts == "absent" else "ok"), ""
    L = ctx.link(item)
    parent = os.path.dirname(item.link)
    c = chain(ctx.home, parent)
    if c == "absent":
        if ts == "absent":
            return "mkdir", "nolink"
        return nocow_check(ctx, item, ts) or ("ok", "nolink")
    if c != "ok":
        what, p = c.split(":", 1)
        return "unexpected", f"{ctx.short(p)} is a {'symlink' if what == 'symlink' else 'file'}, not a folder"
    k = kind(L)
    if k == "absent":
        return "link", ""
    if k == "link":
        if link_target(L) != T:
            return "unexpected", f"symlink to {os.readlink(L)} (expected {ctx.short(T)})"
        if ts == "absent":
            return "mkdir", ""
        return nocow_check(ctx, item, ts) or ("ok", "")
    if k == "other":
        return "unexpected", "a file, not a folder"
    if has_mount(L):
        return "unexpected", "is or contains a mount point"
    if not is_subvol(L) and empty_dir(L):
        return "move", "empty"       # nothing to lose, also next to a filled target
    if ts == "data":
        if item.disposable and not is_subvol(L):
            return "move", "stale"   # the tool replaced its link: the ~/Bulk side is stale
        return "unexpected", f"data in both ~/{item.link} and {ctx.short(T)}"
    if is_subvol(L):
        return ("move", "subvolume") if item.nocow else ("move-subvol", "")
    return "move", ""


def nocow_check(ctx, item, ts):
    """For a NOCOW item whose target exists (ts: empty or data): ('nocow',
    why) when it, a folder or file in it, or a folder above it up to
    ~/Bulk/NOCOW_TOP lacks +C; None when all is in place (or not NOCOW)."""
    if not item.nocow:
        return None
    T = ctx.target(item)
    if ts == "data":
        files, dirs_cow = cow_data(T)
        if files:
            return "nocow", f"{files} file(s) still copy-on-write"
        if dirs_cow:
            return "nocow", "folders without +C"
    elif not is_nocow(T):
        return "nocow", "folder without +C"
    parents = nocow_parents(ctx, item)
    if parents:
        return "nocow", f"folder {ctx.short(parents[0])} without +C"
    return None


# ---- changes (run as the user) -----------------------------------------------------------
def u_mkdirs(bulk, rel, nocow):
    """Create bulk/rel folder by folder; a symlink or file on the way stops it.
    nocow: every folder from bulk/NOCOW_TOP down to bulk/rel gets +C (also
    one that exists already: it affects only files created later)."""
    path = bulk
    for n, part in enumerate([p for p in rel.split("/") if p]):
        path = os.path.join(path, part)
        k = kind(path)
        if k == "absent":
            os.mkdir(path, 0o755)
        elif k != "dir":
            raise Unexpected(f"{path} is not a folder")
        if nocow and (n > 0 or part == NOCOW_TOP):
            set_nocow(path)
    return path


def nocow_parents(ctx, item):
    """The folders between ~/Bulk/NOCOW_TOP (included) and the item's target
    (excluded) that exist without +C."""
    out, path = [], ctx.bulk
    for part in os.path.dirname(item.target).split("/"):
        path = os.path.join(path, part)
        if kind(path) != "dir":
            break                    # absent, or a symlink/file: nothing real below it
        if not is_nocow(path):
            out.append(path)
    return out


def u_rmtree(path):
    """Delete a tree we own; read-only folders (Go's module cache) are made
    writable first. Never follows symlinks (shutil.rmtree works on fds)."""
    def fix(func, p, exc):
        if isinstance(exc, PermissionError):
            parent = os.path.dirname(p)
            os.chmod(parent, stat.S_IMODE(os.lstat(parent).st_mode) | stat.S_IRWXU)
            if os.path.isdir(p) and not os.path.islink(p):
                os.chmod(p, stat.S_IMODE(os.lstat(p).st_mode) | stat.S_IRWXU)
                shutil.rmtree(p, onexc=fix)
            else:
                func(p)
        elif not isinstance(exc, FileNotFoundError):
            raise exc
    if kind(path) == "dir":
        shutil.rmtree(path, onexc=fix)
    elif kind(path) != "absent":
        os.unlink(path)


def u_create_bulk(bulk):
    subvol_create(bulk)
    return True


def u_relabel(path):
    """A new subvolume root has no SELinux label (unlabeled_t), and files
    created in it would inherit that: give it the policy's label (as the
    user; ~/Bulk only, not recursive). Best effort: no SELinux, no error."""
    try:
        subprocess.run(["restorecon", path], capture_output=True)
    except OSError:
        pass
    return True


def u_write_tag(bulk):
    p = os.path.join(bulk, "CACHEDIR.TAG")
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w") as f:
        f.write(TAG_TEXT)
    return True


def u_symlink(L, T):
    if kind(L) != "absent":
        raise Unexpected(f"{L} appeared meanwhile")
    os.symlink(T, L)
    return True


def u_prepare(src, new, nocow):
    """Copy src into new (a fresh folder next to the target) and check it.
    Returns the ctime stamp (ns) taken before the copy."""
    if kind(new) != "absent":
        u_rmtree(new)
    # Timestamps advance in clock ticks (a few ms): wait one out, so nothing
    # done before the stamp (by us, e.g. a recovery rename) shares its tick,
    # and ">=" below then means "changed after the copy started".
    time.sleep(0.05)
    os.mkdir(new, 0o700)
    if nocow:
        set_nocow(new)
    stamp = os.lstat(new).st_ctime_ns
    e_src, b_src, foreign, others = tree_stats(src, os.getuid())
    if foreign or others:
        u_rmtree(new)
    if foreign:
        raise Unexpected("contains another subvolume or a mount")
    if others:
        # cp would make them yours, but the old tree could not be deleted
        # afterwards (a folder owned by root, e.g. from a container's -v).
        me = pwd.getpwuid(os.getuid()).pw_name
        raise Unexpected(f"{others} entries there are not yours (made by a container or sudo?): "
                         f"'sudo chown -R {me}: {src}', then run bulk apply again")
    try:
        copy_tree(src, new, nocow)
        e_new, b_new, _, _ = tree_stats(new)
        if (e_new, b_new) != (e_src, b_src):
            raise RuntimeError(f"copy check failed (entries {e_src} vs {e_new}, bytes {b_src} vs {b_new})")
        if nocow:
            files, dirs_cow = cow_data(new)
            if files or dirs_cow:
                raise RuntimeError(f"copy is not NOCOW ({files} copy-on-write file(s))")
    except BaseException:
        u_rmtree(new)
        raise
    return stamp


def u_clock(near):
    """A ctime stamp (ns) of the filesystem's clock, taken one clock tick
    after anything done before (see u_prepare)."""
    time.sleep(0.05)
    probe = near + ".bulk-stamp"
    if kind(probe) != "absent":
        os.unlink(probe)         # left by a kill
    fd = os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        return os.fstat(fd).st_ctime_ns
    finally:
        os.close(fd)
        os.unlink(probe)


def u_commit(j):
    """The switch: src -> old, new -> target, link. j["stamp2"] (taken just
    before, and in the journal already) is for u_new_written. Returns False
    (nothing changed) if src was written to since the copy started."""
    src, T, new, old, L = j["src"], j["target"], j["new"], j["old"], j["link"]
    if changed_since(src, j["stamp"]):
        u_rmtree(new)
        return False
    os.rename(src, old)
    try:
        os.rename(new, T)   # T: absent or an empty folder (replaced atomically)
    except OSError:
        os.rename(old, src)
        raise
    if L:
        try:
            os.symlink(T, L)
        except OSError:
            os.rename(T, new)
            os.rename(old, src)
            raise
    return True


def u_late_write(j):
    """After the switch: was the old tree written to meanwhile? Entries below
    it, or its own list of entries (mtime: an entry added or deleted directly
    in it; the rename to the old name changes only its ctime). Not covered: a
    process that resolved a path before the rename and opens the file after
    the busy check and this walk (microseconds)."""
    old = j["old"]
    return os.lstat(old).st_mtime_ns >= j["stamp"] or changed_since(old, j["stamp"], mindepth=1)


def u_new_written(j):
    """After the switch: was the target (the copy, now in use through the
    link) written to? Entries below it, or its own list of entries (mtime;
    the rename onto the target changes only its ctime)."""
    T, stamp2 = j["target"], j["stamp2"]
    if kind(T) != "dir":
        return False
    return os.lstat(T).st_mtime_ns >= stamp2 or changed_since(T, stamp2, mindepth=1)


def u_rollback(j):
    """Undo a switch, or the part of one an interruption left. Also the
    in-place NOCOW rewrite (src is the target: no link). If the old path
    was created again meanwhile (by an app, while the data waited in old),
    nothing is deleted: Unexpected, and the journal stays."""
    src, T, new, old, L = j["src"], j["target"], j["new"], j["old"], j["link"]
    if L and kind(L) == "link" and link_target(L) == T:
        os.unlink(L)
    if kind(old) == "dir":
        if src == T:
            # In place: the target holds the copy (if the switch got that far).
            if kind(T) == "dir" and kind(new) == "absent":
                os.rename(T, new)    # the copy goes back out of the way
        elif kind(src) == "absent" and kind(new) == "absent" and kind(T) == "dir":
            os.rename(T, new)
        if kind(src) != "absent":
            raise Unexpected(
                f"{src} was created again while the data waited in {old}: move what you need from "
                f"{src} into {old}, delete {src}, then run bulk apply again (it puts the data back)")
        os.rename(old, src)
    if kind(new) != "absent":
        # The copy may have been written to through the link (a kill after
        # the undo was decided while the user kept working, or a tool that
        # removed the link): then it is kept, not deleted.
        if "stamp2" in j and kind(new) == "dir" and (
                os.lstat(new).st_mtime_ns >= j["stamp2"] or changed_since(new, j["stamp2"], mindepth=1)):
            raise Unexpected(
                f"the data is back at {src}, but the copy {new} was written to as well: copy what you "
                f"need from it into {src}, delete {new}, then run bulk apply again")
        u_rmtree(new)
    return True


def u_finish(j):
    """Delete the old tree of a completed switch."""
    if kind(j["old"]) != "absent":
        u_rmtree(j["old"])
    if kind(j["new"]) != "absent":
        u_rmtree(j["new"])
    return True


def u_move_subvol(L, T):
    """An old subvolume (from an earlier snapshots setup) is renamed into
    ~/Bulk: instant, same data; it stays a nested subvolume there."""
    if kind(T) == "dir":
        os.rmdir(T)          # the empty placeholder
    os.rename(L, T)
    os.symlink(T, L)
    return True


def u_flatpak(app, path):
    if not flatpak_installed(app):
        return "absent"
    if flatpak_has_fs(app, path):
        return "ok"
    flatpak_add_fs(app, path)
    return "added"


def u_flatpak_state(app, path):
    if not flatpak_installed(app):
        return "absent"
    return "ok" if flatpak_has_fs(app, path) else "missing"


# ---- journal (root-owned; the user cannot fake it) ----------------------------------------
def jpath(ident):
    return os.path.join(STATE, f"journal-{ident}.json")


def jwrite(ident, j):
    os.makedirs(STATE, mode=0o755, exist_ok=True)
    tmp = jpath(ident) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(j, f)
        f.flush()
        os.fsync(f.fileno())
    os.rename(tmp, jpath(ident))
    # The rename itself is durable before anything it protects is done.
    fd = os.open(STATE, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def jread(ident):
    try:
        with open(jpath(ident)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def jdrop(ident):
    try:
        os.remove(jpath(ident))
    except FileNotFoundError:
        pass


def journals():
    """Ids with a journal (a move not finished or undone yet); a Steam game's
    is "steam-<appid>"."""
    return [i.id for i in ITEMS if os.path.exists(jpath(i.id))] + steam_journal_ids()


def committed(j):
    """Did the switch of journal j complete (the target holds the data)?"""
    if j["kind"] == "subvol":
        return kind(j["link"]) == "link"
    if j["link"]:
        return kind(j["link"]) == "link" and link_target(j["link"]) == j["target"]
    # In-place rewrite of the target (no link): new renamed onto it, old kept.
    return kind(j["new"]) == "absent" and kind(j["target"]) == "dir" and kind(j["old"]) != "absent"


def conflict_text(ctx, j):
    return (f"written to on both sides during the move: compare {ctx.short(j['old'])} (the old "
            f"tree) with {ctx.short(j['target'])} (in use now), copy what you need into the "
            f"second, delete the first, then run bulk apply again" +
            ("; both inside ~/Bulk, no data of it in /home: snapshots do not wait for it"
             if j.get("bulk_only") else ""))


def recover(ctx):
    """Finish or undo what an interrupted run left (kill, power loss).
    Returns the ids whose journal stays (they need a look)."""
    stuck = []
    for item in ITEMS:
        j = jread(item.id)
        if not j:
            if os.path.exists(jpath(item.id)):
                stuck.append(item.id)
                log(f"NEEDS A LOOK: {item.id}: unreadable journal {jpath(item.id)}")
            continue
        try:
            if j.get("conflict"):
                if kind(j["old"]) != "absent":
                    raise Unexpected(conflict_text(ctx, j))
                log(f"  {item.id}: the old tree is gone: the move is complete")
            elif j.get("finishing"):
                # The last check had passed and the old tree was being deleted:
                # what is left of it is a partial copy (each deletion changes
                # ctimes there, so the late-write check cannot be made again).
                as_user(ctx, u_finish, j)
                log(f"  {item.id}: deleted the old copy left by an interrupted run (its deletion was cut short)")
            elif j["kind"] == "subvol":
                L, T = j["link"], j["target"]
                if kind(L) == "absent" and kind(T) == "dir":
                    as_user(ctx, u_symlink, L, T)
                    log(f"  {item.id}: finished an interrupted move")
                elif not (kind(L) == "link" and link_target(L) == T) and kind(T) == "dir" and os.listdir(T):
                    # Moved, then the old path was created again (an app)
                    # before the link: the moved subvolume is the full data.
                    raise Unexpected(
                        f"{L} was created again after its data was moved to {T}: move what you need "
                        f"from {L} into {T}, delete {L}, then run bulk apply again (it makes the link)")
            elif not j.get("undo") and committed(j):
                # The same last check as right after a switch (migrate): a
                # write into the old tree in the instant of the switch (or the
                # crash) must not be deleted with it.
                if busy_paths([j["old"]], ctx.home) or as_user(ctx, u_late_write, j):
                    if "stamp2" not in j or as_user(ctx, u_new_written, j):
                        # Both sides written (or a journal of an older
                        # version, without stamp2: cannot tell): keep both.
                        j["conflict"] = True
                        jwrite(item.id, j)
                        raise Unexpected(conflict_text(ctx, j))
                    j["undo"] = True
                    jwrite(item.id, j)
                    as_user(ctx, u_rollback, j)
                    log(f"  {item.id}: undid an interrupted move: the old folder was written to during the "
                        f"switch (the data is back at {ctx.short(j['src'])})")
                else:
                    j["finishing"] = True    # a kill now: the next repair goes on deleting
                    jwrite(item.id, j)
                    as_user(ctx, u_finish, j)
                    log(f"  {item.id}: deleted the old copy left by an interrupted run")
            else:
                as_user(ctx, u_rollback, j)
                log(f"  {item.id}: undid an interrupted move (the data is back at {ctx.short(j['src'])})")
            jdrop(item.id)
        except (OSError, RuntimeError, Unexpected) as e:
            stuck.append(item.id)
            wait = "" if j.get("bulk_only") else "; snapshots wait until it is gone"
            log(f"NEEDS A LOOK: {item.id}: an interrupted move: {e} (journal kept in {jpath(item.id)}{wait})")
    return stuck + steam_recover_all(ctx)


# ---- the actions ------------------------------------------------------------------------------
def migrate(ctx, item, src, link):
    """Move src into the item's target by copy + switch; with link, src then
    becomes a symlink to it. Returns ok | busy | changed."""
    T = ctx.target(item)
    new = T + ".bulk-new"
    old = f"{src}.bulk-old-{time.strftime('%Y%m%dT%H%M%S')}"
    if busy_paths([src], ctx.home):
        return "busy"
    if item.nocow:
        # A real copy: the data exists twice until the old tree is deleted.
        need = du_bytes(src) + MARGIN
        if free_bytes(ctx.bulk) < need:
            raise RuntimeError(f"not enough free space for a {gib(need - MARGIN)} copy (plus {gib(MARGIN)} kept free)")
    as_user(ctx, u_mkdirs, ctx.bulk, os.path.dirname(item.target), item.nocow)
    stamp = as_user(ctx, u_prepare, src, new, item.nocow)
    j = {"kind": "copy", "src": src, "target": T, "new": new, "old": old, "link": link, "stamp": stamp,
         # All inside ~/Bulk (the in-place NOCOW rewrite): no data of it in /home.
         "bulk_only": all(p.startswith(ctx.bulk + "/") for p in (src, T, new, old))}
    # Race guard, last moment before the switch (as convert_one in btrfs-snapshot).
    if busy_paths([src], ctx.home):
        as_user(ctx, u_rmtree, new)
        return "busy"
    # The boot service must run if this is interrupted (it recovers before
    # login, before apps recreate the old path), and snapshots wait meanwhile.
    flag_add(item.id)
    # The clock before the switch, kept in the journal: a repair after a crash
    # makes the same last check as below (was the copy written to since?).
    j["stamp2"] = as_user(ctx, u_clock, new)
    jwrite(item.id, j)
    if not as_user(ctx, u_commit, j):
        jdrop(item.id)
        return "changed"
    # Anything that wrote into the old tree in the instant of the switch: undo,
    # unless the copy (in use through the link now) was written to as well.
    if busy_paths([old], ctx.home) or as_user(ctx, u_late_write, j):
        if as_user(ctx, u_new_written, j):
            j["conflict"] = True
            jwrite(item.id, j)
            raise Unexpected(conflict_text(ctx, j))
        j["undo"] = True         # a kill now: the recovery goes on undoing
        jwrite(item.id, j)
        as_user(ctx, u_rollback, j)
        jdrop(item.id)
        as_user(ctx, u_mkdirs, ctx.bulk, item.target, item.nocow)
        return "changed"
    # Past the last check: from here on the old tree is only being deleted (a
    # kill in the middle must not make a repair take the half-deleted tree for
    # a late write and roll back onto it).
    j["finishing"] = True
    jwrite(item.id, j)
    as_user(ctx, u_finish, j)
    jdrop(item.id)
    return "ok"


def act(ctx, item, state, detail):
    """Apply one item; returns ok | busy | changed | unexpected:<why> | wait."""
    T, L = ctx.target(item), ctx.link(item)
    if state == "kept":
        return "kept"
    if state in ("ok", "mkdir"):
        as_user(ctx, u_mkdirs, ctx.bulk, item.target, item.nocow)
        return "ok"
    if state == "link":
        as_user(ctx, u_mkdirs, ctx.bulk, item.target, item.nocow)
        as_user(ctx, u_symlink, L, T)
        return "ok"
    if state == "move":
        if detail == "empty":
            if busy_paths([L], ctx.home):
                return "busy"
            as_user(ctx, u_mkdirs, ctx.bulk, item.target, item.nocow)
            as_user(ctx, os.rmdir, L)
            as_user(ctx, u_symlink, L, T)
            return "ok"
        if detail == "stale":
            if busy_paths([L, T], ctx.home):
                return "busy"
            log(f"  {item.id}: ~/{item.link} is a real folder again (its tool's clean command removed the "
                f"link): deleting the stale copy in {ctx.short(T)} (a cache: downloaded again when needed)")
            as_user(ctx, u_rmtree, T)
        as_user(ctx, u_mkdirs, ctx.bulk, item.target, item.nocow)
        return migrate(ctx, item, L, L)
    if state == "move-subvol":
        if busy_paths([L], ctx.home):
            return "busy"
        as_user(ctx, u_mkdirs, ctx.bulk, os.path.dirname(item.target), False)
        flag_add(item.id)
        jwrite(item.id, {"kind": "subvol", "src": L, "target": T, "new": "", "old": "", "link": L, "stamp": 0})
        as_user(ctx, u_move_subvol, L, T)
        jdrop(item.id)
        return "ok"
    if state == "nocow":
        # The folders above it (~/Bulk/emulators...) get +C in any case.
        as_user(ctx, u_mkdirs, ctx.bulk, os.path.dirname(item.target), True)
        if detail.startswith("folder"):   # no data: +C set in place
            as_user(ctx, u_set_nocow_dirs, T)
            return "ok"
        return migrate(ctx, item, T, None)
    if state == "wait":
        return "wait"
    return "unexpected:" + detail


def u_set_nocow_dirs(top):
    set_nocow(top)
    dev = os.lstat(top).st_dev
    for root, dirs, _ in os.walk(top):
        dirs[:] = [d for d in dirs if os.lstat(os.path.join(root, d)).st_dev == dev
                   and stat.S_ISDIR(os.lstat(os.path.join(root, d)).st_mode)]
        for d in dirs:
            set_nocow(os.path.join(root, d))
    return True


def convert_bulk_dir(ctx):
    """~/Bulk exists as a plain folder: btrfs-snapshot turns it into a
    subvolume (its convert_one: reflink clone + switch, busy -> later)."""
    r = subprocess.run(["bash", SNAPSHOT, "convert-one", ctx.bulk], capture_output=True, text=True)
    for line in (r.stdout + r.stderr).splitlines():
        log("  " + line)
    return is_subvol(ctx.bulk)


def prune_convert_plan(ctx):
    """An older snapshots setup planned some of these paths as nested
    subvolumes: they are symlinks into ~/Bulk now, never to be converted."""
    try:
        with open(CONVERT_PLAN) as f:
            lines = f.readlines()
    except OSError:
        return
    drop = {ctx.link(i) for i in ITEMS if i.link}
    keep = [ln for ln in lines if ln.startswith("#") or not ln.strip()
            or ln.split(maxsplit=1)[-1].strip() not in drop]
    if keep != lines:
        tmp = CONVERT_PLAN + ".tmp"
        with open(tmp, "w") as f:
            f.writelines(keep)
        os.chmod(tmp, 0o644)
        os.rename(tmp, CONVERT_PLAN)
        log("  convert-plan: dropped the paths that now live in ~/Bulk")


def read_flag():
    try:
        with open(FLAG) as f:
            return [x.strip() for x in f if x.strip()]
    except OSError:
        return []


def flag_add(ident):
    ids = read_flag()
    if ident not in ids:
        write_flag(ids + [ident])


def write_flag(ids):
    if ids:
        os.makedirs(ETC, mode=0o755, exist_ok=True)
        tmp = FLAG + ".tmp"
        with open(tmp, "w") as f:
            f.write("".join(i + "\n" for i in ids))
            f.flush()
            os.fsync(f.fileno())
        os.rename(tmp, FLAG)
    else:
        try:
            os.remove(FLAG)
        except FileNotFoundError:
            pass


def read_keep():
    """(ids kept in /home by choice, unknown ids) from KEEP: one id per line,
    '#' starts a comment. Bytes that are not UTF-8 make an unknown id.
    Raises OSError if KEEP exists but cannot be read (a folder, say): then
    nobody knows what is meant to stay, and apply moves nothing."""
    known, unknown = set(), []
    try:
        with open(KEEP, encoding="utf-8", errors="replace") as f:
            for line in f:
                ident = line.split("#", 1)[0].strip()
                if ident in BY_ID:
                    known.add(ident)
                elif ident:
                    unknown.append(ident)
    except FileNotFoundError:
        pass
    return known, unknown


KEEP_HEADER = ("# Managed by btrfs-setup.sh bulk keep/unkeep (CST): ~/Bulk items kept in /home\n"
               "# by choice (one item id per line; '#' starts a comment). bulk apply leaves them alone.\n")


def edit_keep(add, remove):
    """Add/remove ids in KEEP; other lines (comments) stay as they are."""
    # surrogateescape: lines this tool cannot read are written back unchanged.
    try:
        with open(KEEP, encoding="utf-8", errors="surrogateescape") as f:
            lines = f.readlines()
    except FileNotFoundError:
        lines = [KEEP_HEADER]
    lines = [ln if ln.endswith("\n") else ln + "\n" for ln in lines]
    lines = [ln for ln in lines if ln.split("#", 1)[0].strip() not in remove]
    have = {ln.split("#", 1)[0].strip() for ln in lines}
    lines += [i + "\n" for i in add if i not in have]
    os.makedirs(ETC, mode=0o755, exist_ok=True)
    tmp = KEEP + ".tmp"
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.writelines(lines)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, 0o644)
    os.rename(tmp, KEEP)


def take_lock():
    fd = os.open(LOCK, os.O_WRONLY | os.O_CREAT, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def gib(n):
    return f"{n / BIG:.1f} GiB" if n >= BIG / 10 else f"{n >> 20} MiB"


def kept_text(item, detail):
    where = "kept in /home (by choice)" if item.link else "left out (by choice)"
    if detail == "linked":
        return (f"{where}, but still a link into ~/Bulk: move the data back "
                "(btrfs/SNAPSHOTS.md, section 12), or 'bulk unkeep " + item.id + "'")
    return where


# Ids whose problem in the last apply() lies inside ~/Bulk only: the in-place
# +C rewrite of a folder already linked into ~/Bulk failed or was refused
# before it wrote a journal (no free space, a copy check, foreign entries).
BULK_ONLY = set()


def bulk_only_journal(ident):
    j = jread(ident)
    return bool(j and j.get("bulk_only"))


def exit_status(deferred, problems):
    """1 something needs a look, 4 only something inside ~/Bulk (the in-place
    +C rewrite: its journal, or a failure of it; no data of it in /home),
    3 only busy items, 0 done."""
    hard = [p for p in problems
            if not (problems.count(p) == 1 and (p in BULK_ONLY or bulk_only_journal(p)))]
    if hard:
        return 1
    if problems:
        return 4
    return 3 if deferred else 0


def apply(ctx):
    """Bring every item to its declared state. Returns (deferred, problems)."""
    deferred, problems = [], []
    BULK_ONLY.clear()
    # Before taking the lock: btrfs-snapshot convert-one takes it itself.
    if bulk_state(ctx) == "plain":
        log("~/Bulk is a plain folder: turning it into a subvolume first")
        if not convert_bulk_dir(ctx):
            log("~/Bulk: in use or failed (see above): everything waits for the next boot")
            write_flag(["bulk"])
            return ["bulk"], []
    lock = take_lock()
    try:
        stuck = recover(ctx)
        problems += stuck
        prune_convert_plan(ctx)
        b = bulk_state(ctx)
        if b == "bad":
            log(f"{ctx.short(ctx.bulk)} is a file or a symlink: nothing done (move it away, then run again)")
            return [], ["bulk"]
        if b == "create":
            try:
                as_user(ctx, u_create_bulk, ctx.bulk)
            except (OSError, RuntimeError) as e:
                log(f"cannot create ~/Bulk as a subvolume ({e}): nothing done")
                return [], ["bulk"]
            log("created:   ~/Bulk (a subvolume, yours: left out of /home snapshots)")
        # Every run (cheap): also a ~/Bulk made by an older run or by hand.
        as_user(ctx, u_relabel, ctx.bulk)
        if not is_subvol(ctx.bulk):
            log("~/Bulk is not a subvolume after creating it: stopped")
            return [], ["bulk"]
        t = tag_state(ctx)
        if t == "create":
            try:
                as_user(ctx, u_write_tag, ctx.bulk)
                log("created:   ~/Bulk/CACHEDIR.TAG")
            except (OSError, RuntimeError) as e:
                problems.append("CACHEDIR.TAG")
                log(f"NEEDS A LOOK: ~/Bulk/CACHEDIR.TAG: {e}")
        elif t == "bad":
            problems.append("CACHEDIR.TAG")
            log("NEEDS A LOOK: ~/Bulk/CACHEDIR.TAG is not a cache tag (left as it is)")
        done = set()
        try:
            kept, unknown = read_keep()
        except OSError as e:
            problems.append("bulk-keep")
            log(f"NEEDS A LOOK: {KEEP} cannot be read ({e}): no item touched, since what you keep in "
                "/home is unknown (fix or delete that file, then run bulk apply again)")
            return deferred, problems
        for ident in unknown:
            log(f"{KEEP}: unknown item '{ident}' (ignored; valid: {', '.join(BY_ID)})")
        for item in ITEMS:
            state, detail = "", ""
            if item.id in stuck:
                log(f"{'skipped:':<10} {describe_paths(ctx, item)}: its interrupted move needs a look (above)")
                continue
            try:
                state, detail = classify(ctx, item, done, kept)
                res = act(ctx, item, state, detail)
            except Unexpected as e:
                res = f"unexpected:{e}"
            except (OSError, RuntimeError) as e:
                res = f"failed:{e}"
            name = describe_paths(ctx, item)
            if res == "kept":
                log(f"{'kept:':<10} {name}: {kept_text(item, detail)}")
                continue
            if res == "ok":
                after, _ = classify(ctx, item, done, kept)
                if after == "ok":
                    done.add(item.id)
                if state != "ok":
                    log(f"{'done:':<10} {name}{'  (folder only: ~/' + os.path.dirname(item.link) + ' absent)' if detail == 'nolink' else ''}")
            elif res == "busy":
                deferred.append(item.id)
                log(f"{'busy:':<10} {name}: moved at the next boot, before login")
            elif res == "changed":
                deferred.append(item.id)
                log(f"{'busy:':<10} {name}: written to during the move; undone, moved at the next boot")
            elif res == "wait":
                if item.after in deferred:
                    deferred.append(item.id)
                log(f"{'waits:':<10} {name}: {detail}")
            else:
                why = res.split(":", 1)[1]
                problems.append(item.id)
                if state == "nocow":
                    BULK_ONLY.add(item.id)
                    why += "; inside ~/Bulk only, no data of it in /home: snapshots do not wait for it"
                log(f"NEEDS A LOOK: {name}: {why} (nothing touched)")
            if item.flatpak and kind(ctx.target(item)) == "dir":
                try:
                    f = as_user(ctx, u_flatpak, item.flatpak, ctx.target(item))
                    if f == "added":
                        log(f"{'done:':<10} flatpak override --user --filesystem={ctx.target(item)} {item.flatpak}")
                except (OSError, RuntimeError) as e:
                    problems.append(item.id)
                    log(f"NEEDS A LOOK: {item.flatpak}: {e}")
    finally:
        os.close(lock)
    write_flag(deferred)
    return deferred, problems


def row(name, text):
    """One line of plan/status; a long name gets its own line."""
    if len(name) > 56:
        print(f"  {name}\n  {'':<56} {text}")
    else:
        print(f"  {name:<56} {text}")


def describe_paths(ctx, item):
    t = ctx.short(ctx.target(item))
    return f"~/{item.link} -> {t}" if item.link else t


STATE_TEXT = {
    "ok": "ok",
    "mkdir": "create the folder",
    "link": "create the folder and the link",
    "move-subvol": "a subvolume (earlier setup): renamed into ~/Bulk (instant), then the link",
    "wait": "waits",
}


def item_text(ctx, item, state, detail, mode):
    T, L = ctx.target(item), ctx.link(item)
    parent = os.path.dirname(item.link or "")
    if state == "ok":
        return "ok" + (f"  (no link: ~/{parent} absent; linked once it exists)" if detail == "nolink" else "")
    if state == "mkdir" and detail == "nolink":
        return f"create the folder (no link: ~/{parent} absent)"
    if state == "move":
        if detail == "empty":
            return "empty: replaced by the link"
        how = "real copy into a +C folder" if item.nocow else "reflink clone, no data written"
        stale = (f"a real folder again (its tool's clean command removed the link): delete the stale "
                 f"{gib(du_bytes(T))} in ~/Bulk, then " if detail == "stale" else "")
        return f"{stale}move {gib(du_bytes(L))} into ~/Bulk ({how}), then the link"
    if state == "nocow":
        return f"rewrite without copy-on-write ({detail}, {gib(du_bytes(T))})"
    if state == "unexpected":
        size = du_bytes(L) if L and kind(L) == "dir" else 0
        there = f"; {gib(size)} there, still in /home snapshots" if size >= BIG else ""
        return f"NEEDS A LOOK: {detail} (nothing touched{there})"
    return STATE_TEXT.get(state, state) + (f" ({detail})" if detail else "")


def report(ctx, mode):
    """plan / status text. Returns the number of items not in place."""
    left = 0
    flagged = set(read_flag())
    b = bulk_state(ctx)
    print("~/Bulk: everything in it can be downloaded again: no snapshots, no NAS backup.")
    btxt = {"ok": "ok (subvolume)", "create": "create (a subvolume, yours)",
            "plain": "a plain folder: converted into a subvolume first",
            "bad": "NEEDS A LOOK: a file or symlink (nothing done)"}[b]
    left += b != "ok"
    row("~/Bulk", btxt)
    if b in ("ok", "plain"):
        t = tag_state(ctx)
        ttxt = {"ok": "ok", "create": "create", "bad": "NEEDS A LOOK: not a cache tag"}[t]
        row("~/Bulk/CACHEDIR.TAG", ttxt)
    for item in ITEMS:
        if not os.path.exists(jpath(item.id)):
            continue
        left += 1
        j = jread(item.id)
        if j and j.get("conflict") and kind(j["old"]) != "absent":
            print(f"  {item.id}: NEEDS A LOOK: {conflict_text(ctx, j)}")
        elif j:
            print(f"  {item.id}: an interrupted move is recorded ({ctx.short(j['old'] or j['src'])}): the next")
            print("      apply (or boot) finishes or undoes it; " +
                  ("inside ~/Bulk only, snapshots do not wait" if j.get("bulk_only") else "snapshots wait until then"))
        else:
            print(f"  {item.id}: NEEDS A LOOK: unreadable journal {jpath(item.id)}")
    for ident in steam_journal_ids():
        left += 1
        j = jread(ident)
        if j and j.get("conflict"):
            print(f"  {ident}: NEEDS A LOOK: {steam_conflict_text(ctx, j)}")
        elif j:
            print(f"  {ident}: an interrupted Steam game move is recorded (phase {j.get('phase')}): the next")
            print("      apply, 'bulk steam apply' or boot finishes or undoes it; snapshots wait until then")
        else:
            print(f"  {ident}: NEEDS A LOOK: unreadable journal {jpath(ident)}")
    try:
        kept, unknown = read_keep()
    except OSError as e:
        left += 1
        kept, unknown = set(), []
        print(f"  NEEDS A LOOK: {KEEP} cannot be read ({e}): apply touches no item until it is fixed")
    for ident in unknown:
        print(f"  {KEEP}: unknown item '{ident}' (ignored)")
    # Before ~/Bulk exists nothing waits for anything.
    done = set() if b == "ok" else {i.id for i in ITEMS}
    for item in ITEMS:
        state, detail = classify(ctx, item, done, kept)
        if state == "kept":
            row(describe_paths(ctx, item), kept_text(item, detail))
            continue
        if state == "ok":
            done.add(item.id)
        else:
            left += 1
        text = item_text(ctx, item, state, detail, mode)
        if item.id in flagged and state != "ok":
            text += "; waits for the next boot (busy)"
        row(describe_paths(ctx, item), text)
        T = ctx.target(item)
        if item.nocow and mode == "status" and chain(ctx.bulk, item.target) == "ok":
            files, dirs_cow = cow_data(T)
            parents = nocow_parents(ctx, item)
            nc = ("yes" if not files and not dirs_cow else f"NO ({files} copy-on-write file(s))") + (
                f"; NO on {', '.join(ctx.short(p) for p in parents)}" if parents else "")
            row("", f"+C (NOCOW): {nc}")
        if item.flatpak:
            try:
                f = as_user(ctx, u_flatpak_state, item.flatpak, T)
            except (OSError, RuntimeError):
                f = "?"
            ftxt = {"absent": "app not installed (nothing to do)", "ok": "ok", "?": "? (flatpak not usable here)",
                    "missing": "add" if mode == "plan" else "MISSING (run bulk apply)"}[f]
            row(f"  flatpak override: {item.flatpak} may use it", ftxt)
    if "steam" not in kept:
        old_steam(ctx)
    if "bulk" in flagged:
        print("  ~/Bulk itself was busy: converted at the next boot, before login")
    return left


def old_steam(ctx):
    """The default Steam library stays in /home (snapshotted) until its games
    move into the Bulk library (`bulk steam apply`, or Steam's settings)."""
    p = os.path.join(ctx.home, STEAMAPPS, "common")
    if kind(p) != "dir" or chain(ctx.home, STEAMAPPS + "/common") != "ok":
        return
    if is_subvol(os.path.dirname(p)):
