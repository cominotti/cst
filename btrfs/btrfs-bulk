        return
    size = du_bytes(p)
    if size >= BIG:
        row("~/" + STEAMAPPS, f"still {gib(size)} of games here, in /home snapshots: move them to")
        row("", "~/Bulk/steam with Steam closed: 'cst btrfs bulk steam plan', then 'bulk steam apply'")
        row("", "(btrfs/SNAPSHOTS.md, section 3)")


