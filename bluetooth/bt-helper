#!/usr/bin/python3 -I
"""bt-helper: the text work of bluetooth-setup.sh (CST), kept apart so the
tests can call it. It only reads files and standard input and prints to
standard output; it never writes a file, never needs root and never talks to
a service (the shell script runs busctl, pactl and pw-dump and pipes their
output in).

  general-apply PATH             main.conf with Experimental = true and
                                 KernelExperimental = <ISO socket UUID> in
                                 [General]; exit 0 = already so, 10 = changed
  general-show PATH              one line per key: KEY<TAB>ok|update<TAB>current value
  general-revert PATH BACKUP     main.conf with the two keys as BACKUP had
                                 them; exit 0 = already so, 10 = changed
  wp-render MAC QUALITY          the WirePlumber rule file for that headset
  wp-state PATH MAC QUALITY      ok | adopt | change | conflict | missing
  ldac-unit MAC RATE             the user unit of the LDAC rate watcher
                                 (cst-bt-ldac48.service)
  unit-state PATH MAC RATE       ok | change | conflict | missing, as wp-state
  le-render                      the WirePlumber drop-in that turns LE Audio
                                 off in PipeWire (LE_AUDIO=off)
  le-state PATH                  ok | adopt | change | conflict | missing, as
                                 wp-state, for that drop-in
  settings FILE...               DEVICE, LDAC_QUALITY, BEARER, LDAC_RATE and
                                 LE_AUDIO from the settings files (later
                                 files win), as KEY=value
  settings-keys FILE             the keys FILE itself sets (one per line;
                                 nothing when it does not exist)
  settings-set FILE KEY VALUE    FILE's text with KEY=VALUE (the line that
                                 counts replaced, else appended on a line of
                                 its own); exit 0 = already so, 10 = changed
  wp-roles                       bluez5.roles as WirePlumber resolves its
                                 config (libwireplumber, read-only): prints
                                 classic|le|default and the value as
                                 STATE|VALUE; exit 5 = libwireplumber or the
                                 config could not be read
  wp-others NAME DIR...          the other WirePlumber fragments (DIRs in
                                 priority order) that define
                                 monitor.bluez.properties: before|PATH or
                                 after|PATH, relative to the file NAME
  lw-failure                     stdin: journalctl -o short-iso of the LDAC
                                 rate watcher; when its last outcome was
                                 "failed:", prints TIME|REASON|DETAIL (exit
                                 0), else exit 1
  adapter-path                   stdin: busctl -j GetManagedObjects; prints
                                 the first object with org.bluez.Adapter1
  card-state DEV                 stdin: JSON [cards, short sources,
                                 source-outputs] from pactl -f json; prints
                                 PROFILE|A2DP_AVAILABLE(0/1)|MIC_IN_USE(0/1)
  pw-parse DEV                   stdin: pw-dump; prints
                                 PROFILES|RULE_QUALITY|NODE_CODEC|NODE_QUALITY|NODE_RATE

DEV is the MAC with "_" instead of ":" (as PipeWire names the headset).
Exit status: 0 fine, 10 see above, 1 the input could not be used, 2 usage,
3 pw-dump output unreadable, 4 the headset is not in PipeWire.
"""

import json
import re
import sys

# The kernel's experimental "ISO socket" feature: needed for LE Audio
# (connected isochronous streams, LC3). Naming only this UUID, rather than
# "true", leaves out the other experimental kernel features (codec offload,
# Bluetooth Quality Report) that "true" would also switch on.
ISO_UUID = "6fbaf188-05e0-496a-9885-d6ddfdb4e03e"
KEYS = ("Experimental", "KernelExperimental")
WANTED = {"Experimental": "true", "KernelExperimental": ISO_UUID}

MARKER = "# managed-by: bluetooth-setup.sh (CST)"
# What the standalone script this module replaces wrote into its file.
OLD_MARKERS = ("Gerado por apply-le-audio.sh",)
QUALITIES = ("auto", "hq", "sq", "mq")
# PipeWire's numeric LDAC quality on the node (Props) -> the rule's word.
QUALITY_NUM = {-1: "auto", 0: "hq", 1: "sq", 2: "mq"}
SETTING_KEYS = ("DEVICE", "LDAC_QUALITY", "BEARER", "LDAC_RATE", "LE_AUDIO")
# With LE_AUDIO=off PipeWire registers only these Bluetooth roles with BlueZ:
# the default list of PipeWire 1.6 (man pipewire-props, bluez5.roles) without
# the LE Audio ones (bap_sink, bap_source, bap_bcast_sink, bap_bcast_source).
CLASSIC_ROLES = ("a2dp_sink", "a2dp_source", "hfp_hf", "hfp_ag")
LE_CONF_NAME = "90-cst-le-audio-off.conf"
LE_SECTION = "monitor.bluez.properties"
# The LDAC rate watcher: its user unit, and where apply installs the program
# (unit-relative: %h is the home folder).
LDAC_UNIT = "cst-bt-ldac48.service"
LDAC_PROG = "%h/.local/lib/cst/bt-ldac-watch"


# ---- /etc/bluetooth/main.conf -------------------------------------------------------------
# bluetoothd reads it with GLib's key file parser: a [General] header that
# shows up again continues the same group, the last line of a key in the group
# wins, and '#' starts a comment line. Only [General] is touched; everything
# else, comments included, is kept as it is.
def split_lines(text):
    """(lines, newline, final) of TEXT: the lines without the empty string
    after the last newline, and whether TEXT ended with a newline."""
    nl = "\r\n" if "\r\n" in text else "\n"
    lines = re.split(r"\r?\n", text)
    final = lines[-1] == ""
    if final:
        lines.pop()
    return lines, nl, final


def join_lines(lines, nl, final=True):
    return nl.join(lines) + (nl if final else "") if lines else ""


def general_ranges(lines):
    """[(start, end), ...] of every [General] block, in file order: START is
    the header's index, END the index of the next section header (or
    len(lines)). Empty without one."""
    out = []
    start = None
    for i, line in enumerate(lines):
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            if start is not None:
                out.append((start, i))
                start = None
            if s == "[General]":
                start = i
    if start is not None:
        out.append((start, len(lines)))
    return out


def key_pattern(key):
    """Matches `KEY = value` and `#KEY = value`; group 1 is the '#'s, group 2 the value."""
    return re.compile(r"^\s*(#*)\s*" + re.escape(key) + r"\s*=\s*(.*?)\s*$")


def key_lines(lines, ranges, key):
    """(active, commented) line indexes of KEY in all the [General] blocks."""
    pat = key_pattern(key)
    active, commented = [], []
    for start, end in ranges:
        for i in range(start + 1, end):
            m = pat.match(lines[i])
            if m:
                (commented if m.group(1) else active).append(i)
    return active, commented


def satisfied(key, value):
    """Whether VALUE already does what we want. A KernelExperimental list
    that contains the ISO UUID among others is fine as it is."""
    v = value.strip()
    if key == "KernelExperimental":
        return ISO_UUID in v.lower()
    return v == "true"


def current_values(text):
    """{key: value of the line that counts, or None} for KEYS in [General]."""
    lines = split_lines(text)[0]
    ranges = general_ranges(lines)
    out = {k: None for k in KEYS}
    for key in KEYS:
        active, _ = key_lines(lines, ranges, key)
        if active:
            out[key] = key_pattern(key).match(lines[active[-1]]).group(2)
    return out


def edit_general(text):
    """(new text, changed). The line of a key that counts (the last active
    one, in any [General] block) gets our value (an old
    `KernelExperimental = true` becomes the ISO UUID); earlier active lines
    of the same key are commented out; without an active line, the last
    commented one (the vendor's `#Key = false` example) is replaced in place;
    without any, the key goes right under the first [General]. No [General]
    at all: one is put at the top."""
    lines, nl, final = split_lines(text)
    if not general_ranges(lines):
        lines = ["[General]"] + [f"{k} = {v}" for k, v in WANTED.items()] + [""] + lines
        return join_lines(lines, nl, final or not text), True
    changed = False
    for key, val in WANTED.items():
        ranges = general_ranges(lines)          # again: an insert moves the lines
        active, commented = key_lines(lines, ranges, key)
        if active and satisfied(key, key_pattern(key).match(lines[active[-1]]).group(2)):
            continue
        changed = True
        if active:
            lines[active[-1]] = f"{key} = {val}"
            for j in active[:-1]:
                lines[j] = "#" + lines[j].lstrip()
        elif commented:
            lines[commented[-1]] = f"{key} = {val}"
        else:
            lines.insert(ranges[0][0] + 1, f"{key} = {val}")
    return join_lines(lines, nl, final), changed


def revert_general(text, backup):
    """(new text, changed): the two keys back to what BACKUP had, everything
    else in TEXT kept (later edits by hand survive). The backup's line for a
    key is its active line, else its commented example; that line replaces
    the one that counts now. A key the backup did not have at all is
    commented out (bluetoothd's default, false). CHANGED compares lines, so
    a missing newline at the end of the file alone is no change."""
    lines, nl, final = split_lines(text)
    before = list(lines)
    blines = split_lines(backup)[0]
    if not general_ranges(lines):
        return text, False
    branges = general_ranges(blines)
    for key in KEYS:
        want = None
        bact, bcom = key_lines(blines, branges, key)
        if bact or bcom:
            want = blines[(bact or bcom)[-1]]
        ranges = general_ranges(lines)
        active, _ = key_lines(lines, ranges, key)
        if want is None:
            for j in active:
                lines[j] = "#" + lines[j].lstrip()
        elif active:
            lines[active[-1]] = want
            for j in active[:-1]:
                lines[j] = "#" + lines[j].lstrip()
        elif not key_pattern(key).match(want).group(1):
            # The backup had it on, the file has no active line now.
            lines.insert(ranges[0][0] + 1, want)
    if lines == before:
        return text, False
    return join_lines(lines, nl, final), True


# ---- the WirePlumber rule -----------------------------------------------------------------
def device_id(mac):
    return mac.upper().replace(":", "_")


def render_wp(mac, quality):
    """The rule file ~/.config/wireplumber/wireplumber.conf.d/50-bluez-<ID>.conf."""
    mac = mac.upper()
    return f"""\
{MARKER}: change the settings with `cst bluetooth apply`, not in this file.
# Headset {mac}: LDAC quality "{quality}" when it is connected over A2DP.
# "auto" = adaptive bitrate (990, 660 or 330 kbps, lower when the radio loses
# packets); a fixed "hq" (990 kbps) made the JBL Live Beam 4 stall and play in bursts.
# LE Audio (BAP/LC3) comes from BlueZ (Experimental/KernelExperimental in
# /etc/bluetooth/main.conf); the bap-* profiles show up when the headset connects over LE.
monitor.bluez.rules = [
  {{
    matches = [ {{ device.name = "bluez_card.{device_id(mac)}" }} ]
    actions = {{
      update-props = {{
        bluez5.a2dp.ldac.quality = "{quality}"
      }}
    }}
  }}
]
"""


def effective(text):
    """The lines WirePlumber reads (no comments, no blank lines, no trailing blanks)."""
    out = []
    for line in text.splitlines():
        s = line.rstrip()
        if s.strip() and not s.lstrip().startswith("#"):
            out.append(s)
    return out


def wp_state(existing, rendered):
    """ok (equal), adopt (only comments differ: apply renews them, no
    restart), change (ours or the old script's, settings differ), conflict
    (a file nobody of ours wrote, with other settings: apply refuses),
    missing (EXISTING is None)."""
    if existing is None:
        return "missing"
    if existing == rendered:
        return "ok"
    if effective(existing) == effective(rendered):
        return "adopt"
    if MARKER in existing or any(m in existing for m in OLD_MARKERS):
        return "change"
    return "conflict"


# ---- the LDAC rate watcher's user unit ------------------------------------------------------
def render_unit(mac, rate):
    """~/.config/systemd/user/cst-bt-ldac48.service."""
    mac = mac.upper()
    return f"""\
{MARKER}: change the settings with `cst bluetooth apply`, not in this file.
# Puts the LDAC stream of headset {mac} back to {rate} Hz when the headset
# itself configured another rate (96000 Hz) on reconnecting: one SBC <-> LDAC
# profile switch, the link stays up. Why and how: bluetooth/README.md in CST.
[Unit]
Description=CST: LDAC of headset {mac} at {rate} Hz
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I {LDAC_PROG} --device {mac} --rate {rate}
Restart=on-failure
RestartSec=30
# A stop during a profile switch waits for the switch back to LDAC (up to
# about 20 s): the stop signal goes to the program only, not to its pactl.
KillMode=mixed
TimeoutStopSec=60
NoNewPrivileges=yes

[Install]
WantedBy=default.target
"""


def unit_state(existing, rendered):
    """ok, change (ours, differs), conflict (not ours), missing."""
    if existing is None:
        return "missing"
    if existing == rendered:
        return "ok"
    return "change" if MARKER in existing else "conflict"


# ---- LE Audio off: the WirePlumber drop-in --------------------------------------------------
def render_le_off():
    """~/.config/wireplumber/wireplumber.conf.d/90-cst-le-audio-off.conf.
    The `override.` goes on the SECTION, with a plain key inside. WirePlumber
    0.5 (checked on 0.5.19 with its own libwireplumber) strips an `override.`
    prefix only while it merges into a section that an earlier file already
    defines; with no such file, `override.bluez5.roles` inside a plain section
    reaches the bluez5 monitor under that literal name, is ignored, and LE
    Audio stays on. `override.monitor.bluez.properties` always yields a plain
    `bluez5.roles`, and replaces the list instead of joining it with the
    lists of earlier files. The price: other monitor.bluez.properties keys
    of earlier files are dropped too (plan and status name such files)."""
    roles = " ".join(CLASSIC_ROLES)
    return f"""\
{MARKER}: change the settings with `cst bluetooth apply`, not in this file.
# LE Audio off (LE_AUDIO=off, the CST default). For ALL Bluetooth devices:
# PipeWire offers BlueZ only the classic roles, so headsets play over A2DP
# (LDAC, AAC, SBC) and HFP, never over LE Audio (no bap-* profiles).
# Why: the JBL Live Beam 4 connected over BR/EDR and LE at once, PipeWire
# picked LE (bap-duplex) and the audio dropped in a loop; LE stereo to
# true-wireless earbuds does not work on this Intel BE200 yet (upstream BlueZ
# is working on it). Turn LE Audio on: `cst bluetooth le-audio on`
# (or LE_AUDIO=on in ~/.config/cst/bluetooth.conf, then `cst bluetooth apply`).
# "override." replaces the whole section of earlier files. Details:
# bluetooth/README.md in CST, "LE Audio: off by default".
override.{LE_SECTION} = {{
  bluez5.roles = [ {roles} ]
}}
"""


# ---- LE Audio off: what WirePlumber really reads ------------------------------------------
# A section header of a WirePlumber config file: `monitor.bluez.properties = {`,
# also quoted, with `:` or without a separator, with or without `override.`.
SECTION_RE = re.compile(r'^\s*"?(override\.)?' + re.escape(LE_SECTION) + r'"?\s*[=:]?\s*(\{|$)')


def defines_section(text):
    """Whether TEXT (a WirePlumber config file) defines monitor.bluez.properties."""
    return any(SECTION_RE.match(line) for line in effective(text))


def other_fragments(ours, dirs):
    """[(before|after, path)] of the WirePlumber fragments other than OURS
    (a file name) that define monitor.bluez.properties, in the order
    WirePlumber reads them: by file name, over DIRS (highest priority
    first: a name found in an earlier dir hides the same name in later ones)."""
    import os
    found = {}
    for d in dirs:
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            if n.endswith(".conf") and n not in found:
                found[n] = os.path.join(d, n)
    out = []
    for n in sorted(found):
        if n == ours:
            continue
        try:
            text = read(found[n])
        except (OSError, UnicodeDecodeError):
            continue
        if defines_section(text):
            out.append(("before" if n < ours else "after", found[n]))
    return out


def roles_state(value):
    """classic | le | default for the effective bluez5.roles VALUE (None =
    not set: PipeWire's own default, which has the LE Audio roles)."""
    if value is None:
        return "default"
    roles = re.findall(r"[A-Za-z0-9_]+", value)
    return "le" if any(r.startswith("bap_") for r in roles) else "classic"


def wp_effective_roles():
    """bluez5.roles as WirePlumber resolves its config right now (all its
    files, merged by libwireplumber itself, read-only: nothing is started or
    connected), or None when not set. Raises OSError when libwireplumber
    cannot be loaded or the config cannot be opened."""
    import ctypes
    import os
    lib = ctypes.CDLL(os.environ.get("CST_BT_LIBWP") or "libwireplumber-0.5.so.0")
    lib.wp_init.argtypes = [ctypes.c_int]
    lib.wp_init(0)
    lib.wp_conf_new_open.restype = ctypes.c_void_p
    lib.wp_conf_new_open.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p)]
    lib.wp_properties_new_empty.restype = ctypes.c_void_p
    lib.wp_conf_section_update_props.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_void_p]
    lib.wp_properties_get.restype = ctypes.c_char_p
    lib.wp_properties_get.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
    err = ctypes.c_void_p()
    conf = lib.wp_conf_new_open(b"wireplumber.conf", None, ctypes.byref(err))
    if not conf:
        raise OSError("WirePlumber could not open wireplumber.conf")
    props = lib.wp_properties_new_empty()
    lib.wp_conf_section_update_props(conf, LE_SECTION.encode(), props)
    v = lib.wp_properties_get(props, b"bluez5.roles")
    return None if v is None else v.decode("utf-8", "replace")


# ---- settings -------------------------------------------------------------------------------
def parse_settings(text):
    """{KEY: value} from KEY=value lines. '#' starts a comment (also after a
    value, behind a blank); quotes around the value are dropped; unknown keys
    are ignored."""
    out = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        key, val = (p.strip() for p in s.split("=", 1))
        val = re.sub(r"\s+#.*$", "", val).strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
            val = val[1:-1]
        if key in SETTING_KEYS:
            out[key] = val
    return out


def set_keys(text):
    """The known keys TEXT sets, in file order, each once."""
    return list(dict.fromkeys(parse_settings_order(text)))


def parse_settings_order(text):
    for line in text.splitlines():
        s = line.strip()
        if s and not s.startswith("#") and "=" in s:
            key = s.split("=", 1)[0].strip()
            if key in SETTING_KEYS:
                yield key


def settings_set(text, key, value):
    """(new text, changed): KEY=VALUE in a settings file's TEXT (None = the
    file does not exist yet). The line that counts (the last active one) is
    replaced in place, earlier active lines of KEY are commented out; without
    one the line is appended, on a line of its own even when TEXT does not
    end with a newline. Everything else is kept."""
    want = f"{key}={value}"
    if text is None:
        return ("# CST bluetooth settings (override bluetooth/bluetooth.conf in the repo)\n"
                f"{want}\n"), True
    lines, nl, final = split_lines(text)
    idx = [i for i, line in enumerate(lines)
           if "=" in line and not line.strip().startswith("#") and line.split("=", 1)[0].strip() == key]
    before = list(lines)
    if idx:
        if parse_settings(lines[idx[-1]]).get(key) != value:
            lines[idx[-1]] = want
        for i in idx[:-1]:
            lines[i] = "# " + lines[i].lstrip()
    else:
        lines.append(want)
        final = True
    if lines == before:
        return text, False
    return join_lines(lines, nl, final), True


def merged_settings(texts):
    out = {k: "" for k in SETTING_KEYS}
    for t in texts:
        out.update(parse_settings(t))
    return out


# ---- live state (parsed from the output of busctl, pactl and pw-dump) ----------------------
def adapter_path(objects):
    """The first object path with org.bluez.Adapter1, or None."""
    data = objects.get("data") or [{}]
    for path, ifaces in sorted(data[0].items()):
        if "org.bluez.Adapter1" in ifaces:
            return path
    return None


def card_state(dev, cards, srcs, outs):
    """(active profile, a2dp-sink offered, headset mic in use), or None when
    the headset has no card in PipeWire."""
    card = next((c for c in cards if c.get("name") == "bluez_card." + dev), None)
    if card is None:
        return None
    a2dp = bool(card.get("profiles", {}).get("a2dp-sink", {}).get("available", False))
    bt_src = {s.get("index") for s in srcs if str(s.get("name", "")).startswith("bluez_input." + dev)}
    mic = any(o.get("source") in bt_src for o in outs)
    return card.get("active_profile") or "", a2dp, mic


def pw_state(dev, objs):
    """(profiles, rule quality, node codec, node quality, node rate) of the headset, or
    None when it is not in PipeWire. Missing parts are None."""
    prof = rule = codec = quality = rate = None
    found = False
    for o in objs:
        info = o.get("info") or {}
        p = info.get("props") or {}
        params = info.get("params") or {}
        kind = o.get("type", "")
        if kind.endswith("Device") and p.get("device.name") == "bluez_card." + dev:
            found = True
            prof = " ".join(pr.get("name", "?") for pr in params.get("Profile", []) or [])
            rule = p.get("bluez5.a2dp.ldac.quality")
        if (kind.endswith("Node") and str(p.get("node.name", "")).startswith("bluez_output." + dev)
                and p.get("api.bluez5.codec")):
            codec = p["api.bluez5.codec"]
            rate = node_rate(info)
            for pr in params.get("Props", []) or []:
                if "quality" in pr:
                    quality = QUALITY_NUM.get(pr["quality"], str(pr["quality"]))
    if not found:
        return None
    return prof or None, rule, codec, quality, None if rate is None else str(rate)


def node_rate(info):
    """The node's negotiated Format rate, else the rate its EnumFormat offers
    (a suspended node has an empty Format). Same as in bt-ldac-watch."""
    params = info.get("params") or {}
    for key in ("Format", "EnumFormat"):
        for fmt in params.get(key) or []:
            r = fmt.get("rate") if isinstance(fmt, dict) else None
            if isinstance(r, int):
                return r
    return None


# ---- the LDAC rate watcher's journal --------------------------------------------------------
# journalctl -o short-iso: "TIME HOST IDENT[PID]: MESSAGE". The watcher's
# outcome lines start with "fixed:" or "failed:"; its other lines with a word
# and a colon ("act:", "wait:", "none:", "cooldown:"); a line without such a
# word (from its bounce) says what went wrong.
JOURNAL_LINE = re.compile(r"^(\S+) \S+ ([^:\s]+): (.*)$")
KEYWORD = re.compile(r"^[a-z]+: ")


def lw_failure(text):
    """(time, reason, detail) of the watcher's last outcome when that was a
    failure, else None. DETAIL is the line of the same process just before
    it that is not a keyword line ("" if none)."""
    last = None
    prev_detail = {}
    for line in text.splitlines():
        m = JOURNAL_LINE.match(line)
        if not m:
            continue
        when, ident, msg = m.groups()
        if msg.startswith("fixed: "):
            last = None
        elif msg.startswith("failed: "):
            last = (when, msg[len("failed: "):], prev_detail.get(ident, ""))
        elif msg.startswith("act: "):
            prev_detail[ident] = ""
        elif not KEYWORD.match(msg) and ident.startswith("python3"):
            prev_detail[ident] = msg
    return last


# ---- command line -----------------------------------------------------------------------------
def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def read_or_none(path):
    try:
        return read(path)
    except FileNotFoundError:
        return None


def main(argv):
    if not argv:
        print(__doc__, end="")
        return 2
    cmd, args = argv[0], argv[1:]
    arity = {"general-apply": 1, "general-show": 1, "general-revert": 2, "wp-render": 2,
             "wp-state": 3, "ldac-unit": 2, "unit-state": 3, "adapter-path": 0, "card-state": 1, "pw-parse": 1,
             "le-render": 0, "le-state": 1, "settings-keys": 1, "lw-failure": 0, "wp-roles": 0,
             "settings-set": 3}
    if cmd == "wp-others":
        if not args:
            print(f"bt-helper: usage: see {sys.argv[0]} (no arguments)", file=sys.stderr)
            return 2
        for where, path in other_fragments(args[0], args[1:]):
            print(f"{where}|{path}")
        return 0
    if cmd == "settings":
        texts = [t for t in (read_or_none(a) for a in args) if t is not None]
        for k, v in merged_settings(texts).items():
            print(f"{k}={v}")
        return 0
    if cmd not in arity or len(args) != arity[cmd]:
        print(f"bt-helper: usage: see {sys.argv[0]} (no arguments)", file=sys.stderr)
        return 2
    if cmd == "general-apply":
        new, changed = edit_general(read(args[0]))
        sys.stdout.write(new)
        return 10 if changed else 0
    if cmd == "general-show":
        for key, val in current_values(read(args[0])).items():
            ok = val is not None and satisfied(key, val)
            print(f"{key}\t{'ok' if ok else 'update'}\t{'(not set)' if val is None else val}")
        return 0
    if cmd == "general-revert":
        new, changed = revert_general(read(args[0]), read(args[1]))
        sys.stdout.write(new)
        return 10 if changed else 0
    if cmd == "wp-render":
        sys.stdout.write(render_wp(args[0], args[1]))
        return 0
    if cmd == "wp-state":
        print(wp_state(read_or_none(args[0]), render_wp(args[1], args[2])))
        return 0
    if cmd == "le-render":
        sys.stdout.write(render_le_off())
        return 0
    if cmd == "le-state":
        print(wp_state(read_or_none(args[0]), render_le_off()))
        return 0
    if cmd == "wp-roles":
        try:
            value = wp_effective_roles()
        except (OSError, AttributeError) as e:
            print(f"bt-helper: {e}", file=sys.stderr)
            return 5
        print(f"{roles_state(value)}|{'' if value is None else value}")
        return 0
    if cmd == "settings-set":
        if args[1] not in SETTING_KEYS or not re.fullmatch(r"[A-Za-z0-9_.:-]*", args[2]):
            print(f"bt-helper: settings-set: unknown key or bad value: {args[1]}={args[2]}", file=sys.stderr)
            return 2
        new, changed = settings_set(read_or_none(args[0]), args[1], args[2])
        sys.stdout.write(new)
        return 10 if changed else 0
    if cmd == "settings-keys":
        text = read_or_none(args[0])
        for k in set_keys(text or ""):
            print(k)
        return 0
    if cmd == "lw-failure":
        st = lw_failure(sys.stdin.read())
        if st is None:
            return 1
        print("|".join(x.replace("|", "/") for x in st))
        return 0
    if cmd == "ldac-unit":
        sys.stdout.write(render_unit(args[0], args[1]))
        return 0
    if cmd == "unit-state":
        print(unit_state(read_or_none(args[0]), render_unit(args[1], args[2])))
        return 0
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return 3 if cmd == "pw-parse" else 1
    if cmd == "adapter-path":
        path = adapter_path(data)
        if path is None:
            return 1
        print(path)
        return 0
    if cmd == "card-state":
        st = card_state(args[0], *data)
        if st is None:
            return 1
        print(f"{st[0]}|{int(st[1])}|{int(st[2])}")
        return 0
    st = pw_state(args[0], data)          # pw-parse
    if st is None:
        return 4
    print("|".join(x or d for x, d in zip(st, ("?", "?", "-", "-", "-"))))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
