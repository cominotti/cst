class StepError(Exception):
    """A step that cannot go on: the message is printed and the exit status is 1."""


@dataclass(frozen=True, slots=True)
class Ran:
    """What one command did: its exit status, its output, the largest resident set of its process tree, its time."""

    returncode: int
    output: str
    max_rss_kb: int
    seconds: float


type Exec = Callable[[Sequence[str], str, Mapping[str, str]], Ran]


def execute(argv: Sequence[str], cwd: str, env: Mapping[str, str]) -> Ran:
    """Run argv to its end, its output (stdout and stderr) into a file of cwd; its exit status, output and
    largest RSS (wait4's: the largest of the process and of its waited-for descendants, the JVM included).
    Bytes of the output that are not UTF-8 become U+FFFD, as cst_core's runner reads them."""
    with tempfile.TemporaryFile(
        mode="w+", encoding="utf-8", errors="replace", prefix=".cst-quint-", suffix=".log", dir=cwd
    ) as log:
        t0 = time.monotonic()
        proc = subprocess.Popen(
            list(argv), cwd=cwd, env=dict(env), stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT
        )
        _pid, status, usage = os.wait4(proc.pid, 0)
        proc.returncode = os.waitstatus_to_exitcode(status)
        seconds = time.monotonic() - t0
        log.seek(0)
        output = log.read()
    return Ran(proc.returncode, output, usage.ru_maxrss, seconds)


def sha256_of(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def read_stamp(folder: str) -> str:
    try:
        with open(os.path.join(folder, STAMP), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def write_stamp(folder: str, digest: str) -> None:
    with open(os.path.join(folder, STAMP), "w", encoding="utf-8") as f:
        f.write(digest + "\n")


def ready(folder: str, digest: str, marker: str) -> bool:
    """The folder holds what was checked against digest: its stamp says so, and the marker is there."""
    return read_stamp(folder) == digest and os.path.exists(os.path.join(folder, marker))


def held_lock(path: str, timeout: float) -> int:
    """An open fd holding an exclusive flock on path (a 0600 file, created when absent): close it to unlock.
    StepError naming the lock when another run still holds it after timeout seconds.

    cst_core.adapters.locks.take_lock does the same, but this program runs on CI's runner Python (3.12), and
    importing it brings in cst_core's adapters and ports, newer Python than that: a few lines of flock here."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    deadline = time.monotonic() + timeout
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return fd
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise StepError(f"{path}: another run still holds this lock after {timeout:g} s") from None
                time.sleep(LOCK_POLL)
    except BaseException:
        os.close(fd)
        raise


def fetch(tool: Tool, home: str, run: Exec, env: Mapping[str, str]) -> str:
    """tool unpacked into home/tool.folder: downloaded and checked first, unless its stamp is there. Under a
    lock (home/.tool.folder.lock): runs that start together download it once, and the others use that copy."""
    dest = os.path.join(home, tool.folder)
    if ready(dest, tool.sha256, tool.marker):
        return dest
    os.makedirs(home, exist_ok=True)
    lock = held_lock(os.path.join(home, f".{tool.folder}.lock"), FETCH_TIMEOUT)
    try:
        if not ready(dest, tool.sha256, tool.marker):  # another run may have finished it while this one waited
            download_into(tool, home, dest, run, env)
    finally:
        os.close(lock)
    return dest


def download_into(tool: Tool, home: str, dest: str, run: Exec, env: Mapping[str, str]) -> None:
    """tool downloaded into home, checked against its hash, unpacked and stamped, then moved to dest."""
    fd, download = tempfile.mkstemp(prefix=".download-", dir=home)
    os.close(fd)
    try:
        got = run(["timeout", str(FETCH_TIMEOUT), "curl", "-sSLf", "--retry", "3", "-o", download, tool.url], home, env)
        if got.returncode != 0:
            raise StepError(f"{tool.url}: download failed (exit {got.returncode}): {got.output.strip()[-300:]}")
        digest = sha256_of(download)
        if digest != tool.sha256:
            raise StepError(f"{tool.url}: SHA-256 {digest}, want {tool.sha256}: the download was removed")
        unpacked = tempfile.mkdtemp(prefix=".unpack-", dir=home)
        try:
            with tarfile.open(download) as tar:
                tar.extractall(unpacked, filter="data")
            if not os.path.exists(os.path.join(unpacked, tool.marker)):
                raise StepError(f"{tool.url}: no {tool.marker} in the archive")
            write_stamp(unpacked, digest)
            shutil.rmtree(dest, ignore_errors=True)
            os.rename(unpacked, dest)
        finally:
            shutil.rmtree(unpacked, ignore_errors=True)
    finally:
        os.remove(download)


def install_quint(cache: str, pin: str, run: Exec, env: Mapping[str, str]) -> str:
    """quint from the lock in pin (npm ci --ignore-scripts, which checks every package's hash), in a folder
    of cache named after the lock's hash; the path of its program. Under a lock (cache/.npm-HASH.lock), as
    fetch: runs that start together install it once."""
    digest = sha256_of(os.path.join(pin, "package-lock.json"))
    prefix = npm_prefix(cache, digest)
    marker = os.path.join("node_modules", ".bin", "quint")
    if ready(prefix, digest, marker):
        return os.path.join(prefix, marker)
    os.makedirs(cache, exist_ok=True)
    lock = held_lock(os.path.join(cache, f".npm-{digest[:16]}.lock"), FETCH_TIMEOUT)
    try:
        if not ready(prefix, digest, marker):  # another run may have finished it while this one waited
            npm_ci_into(cache, pin, digest, run, env)
    finally:
        os.close(lock)
    return os.path.join(prefix, marker)


def npm_prefix(cache: str, digest: str) -> str:
    """The folder of cache that holds quint installed from the lock whose hash is digest."""
    return os.path.join(cache, f"npm-{digest[:16]}")


def npm_ci_into(cache: str, pin: str, digest: str, run: Exec, env: Mapping[str, str]) -> None:
    """npm ci of pin's lock in a staging folder of cache, stamped with digest, then moved to its npm_prefix."""
    prefix = npm_prefix(cache, digest)
    staging = tempfile.mkdtemp(prefix=".npm-", dir=cache)
    try:
        for name in ("package.json", "package-lock.json"):
            shutil.copyfile(os.path.join(pin, name), os.path.join(staging, name))
        npm_env = {**env, "npm_config_cache": os.path.join(cache, "npm-cache")}
        argv = ["timeout", str(FETCH_TIMEOUT), "npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"]
        got = run(argv, staging, npm_env)
        if got.returncode != 0:
            raise StepError(f"npm ci failed (exit {got.returncode}): {got.output.strip()[-500:]}")
        write_stamp(staging, digest)
        shutil.rmtree(prefix, ignore_errors=True)
        os.rename(staging, prefix)
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def quint_env(env: Mapping[str, str], home: str, work: str) -> dict[str, str]:
    """The environment quint, Apalache and TLC run in: the checked tools, a bounded heap, temporary files in work."""
    return {**env, "QUINT_HOME": home, "JVM_ARGS": JVM_ARGS, "TMPDIR": work}


def ephemeral_range(path: str = EPHEMERAL_RANGE) -> tuple[int, int]:
    """The first and last port of the kernel's ephemeral range; Linux's default when path cannot be read."""
    try:
        with open(path, encoding="ascii") as f:
            words = f.read().split()
        low, high = int(words[0]), int(words[1])
    except (OSError, ValueError, IndexError):
        return DEFAULT_EPHEMERAL
    return low, high


def server_ports(ephemeral: tuple[int, int]) -> list[int]:
    """The ports free_port picks from: none the kernel can hand to another socket while Apalache starts. IANA's
    dynamic ports outside the ephemeral range, else any port that needs no root outside it."""
    low, high = ephemeral
    for ports in (DYNAMIC_PORTS, UNPRIVILEGED_PORTS):
        outside = [port for port in ports if not low <= port <= high]
        if outside:
            return outside
    raise StepError(f"every port from 1024 up is in the kernel's ephemeral range {low}-{high} ({EPHEMERAL_RANGE})")


def port_is_free(port: int) -> bool:
    """Whether no TCP socket holds port on any address: a bind to the IPv4 wildcard and one to the IPv6 wildcard
    (IPv6 only) both work. A machine without IPv6 skips the second."""
    for family, wildcard in ((socket.AF_INET, ""), (socket.AF_INET6, "::")):
        try:
            with socket.socket(family, socket.SOCK_STREAM) as s:
                if family == socket.AF_INET6:
                    s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
                s.bind((wildcard, port))
        except OSError as e:
            if family == socket.AF_INET6 and e.errno in (errno.EAFNOSUPPORT, errno.EADDRNOTAVAIL):
                continue
            return False
    return True


def free_port(
    ephemeral: Callable[[], tuple[int, int]] = ephemeral_range,
    choose: Callable[[Sequence[int]], int] = secrets.choice,
) -> int:
    """A TCP port no socket holds right now, on IPv4 or IPv6, outside the kernel's ephemeral range: between this
    check and Apalache's bind (seconds later) no outgoing connection or bind to port 0 can be given it."""
    ports = server_ports(ephemeral())
    for _ in range(PORT_TRIES):
        port = choose(ports)
        if port_is_free(port):
            return port
    raise StepError(f"no free port for the Apalache server in {PORT_TRIES} tries")


def server_endpoint(port: int) -> str:
    """quint's --server-endpoint for an Apalache server on port: quint starts one there when none answers."""
    return f"{SERVER_HOST}:{port}"


def tlc_argv(quint: str, spec: str, check: Check, config: str, endpoint: str) -> list[str]:
    return [
        "timeout",
        str(TLC_TIMEOUT),
        *NICE,
        quint,
        "verify",
        spec,
        "--backend",
        "tlc",
        "--tlc-config",
        config,
        "--main",
        check.main,
        "--step",
        check.step,
        "--invariant",
        ",".join(check.invariants),
        "--server-endpoint",
        endpoint,
    ]


def trace_argv(quint: str, spec: str, job: TraceJob, out: str, endpoint: Callable[[], str]) -> list[str]:
    """The run that writes job's trace to out: the simulator with one thread (a seed then gives the same walk),
    or Apalache's bounded check of the negated witness, through its server at the endpoint endpoint() gives,
    called for that run only (`quint run` starts no server and has no such option)."""
    common = ["--main", job.main, "--step", job.step, "--max-steps", str(job.max_steps), "--out-itf", out]
    if job.backend == "simulator":
        argv = ["timeout", str(SIMULATOR_TIMEOUT), *NICE, quint, "run", spec, *common]
        argv += ["--max-samples", str(job.samples), "--n-traces", "1", "--n-threads", "1", "--seed", str(job.seed)]
    else:
        argv = ["timeout", str(APALACHE_TIMEOUT), *NICE, quint, "verify", spec, *common]
        argv += ["--server-endpoint", endpoint()]
    if job.invariant:
        argv += ["--invariant", job.invariant]
    return argv


@dataclass(frozen=True, slots=True)
class Verdict:
    """quint verify's answer for one instance."""

    result: str  # "ok", "violated", "timed out" or "failed"
    states: int | None
    depth: int | None


def last_number(pattern: str, text: str) -> int | None:
    """The number in pattern's one group at its last match in text, or None."""
    found = re.findall(pattern, text)
    return int(found[-1]) if found else None


def verdict(ran: Ran) -> Verdict:
    # TLC prints its progress as it goes ("Progress(N) at ...: X states generated, Y distinct states found"):
    # the last such line is the total.
    states = last_number(r"(\d+) distinct states found", ran.output)
    depth = last_number(r"depth of the complete state graph search is (\d+)", ran.output)
    if ran.returncode == ExitStatus.TIMED_OUT:
        result = "timed out"
    elif ran.returncode == 0 and "[ok] No violation found" in ran.output:
        result = "ok"
    elif ran.returncode != 0 and "[violation]" in ran.output:
        result = "violated"
    else:
        result = "failed"
    return Verdict(result, states, depth)


def trace_problem(job: TraceJob, ran: Ran) -> str | None:
    """Why the run of job gave no trace to keep, or None. A witness's run must end with a violation of
    its negated invariant (else the trace written is a walk that never reaches the witness); a walk's
    run must end with exit 0."""
    if job.invariant:
        if verdict(ran).result == "violated":
            return None
        return f"no trace reaches the witness ({job.invariant}): quint exit {ran.returncode}, no violation found"
    if ran.returncode == 0:
        return None
    return f"the walk failed (exit {ran.returncode})"


def _json_object(value: object) -> TypeGuard[dict[str, object]]:
    """A JSON object: a dict whose keys are all strings. cst_core.domain.shapes.json_object is the same check, but
    that module imports typing.TypeIs (Python 3.13), and this program runs on the CI runner's own Python 3.12 (the
    quint job of .github/workflows/ci.yml), so it reads JSON with the standard library."""
    return isinstance(value, dict) and all(isinstance(k, str) for k in value)


def normalize(text: str, description: str) -> str:
    """An ITF trace as it is checked in: "#meta" without the spec's absolute path or a timestamp (the
    description in their place), one state per line, sorted keys: the same bytes for the same trace."""
    doc = json.loads(text)
    if not _json_object(doc) or not isinstance(states_in := doc.get("states"), list):
        raise StepError("not an ITF trace")
    meta = doc.get("#meta")
    kept = {k: meta[k] for k in ("format", "format-description") if _json_object(meta) and k in meta}
    kept["description"] = description
    lines = ["{", f'"#meta": {json.dumps(kept, sort_keys=True)},']
    lines += [
        f"{json.dumps(k)}: {json.dumps(doc[k], sort_keys=True)}," for k in sorted(doc) if k not in {"#meta", "states"}
    ]
    states = [json.dumps(state, sort_keys=True) for state in states_in]
    lines.append('"states": [')
    lines += [state + ("," if i < len(states) - 1 else "") for i, state in enumerate(states)]
    lines += ["]", "}"]
    return "\n".join(lines) + "\n"


def rss(kb: int) -> str:
    """wait4's largest resident set (KiB) in binary IEC units, as CST's other output gives sizes."""
    return format_bytes_human(kb * 1024)


def known(value: int | None) -> str:
    return "?" if value is None else str(value)


@dataclass
class Session:
    """One run of cst-quint: where things are and how commands run."""

    checkout: str
    cache: str
    run: Exec
    env: Mapping[str, str]
    out: Callable[[str], None]
    # A free port for each quint verify, taken right before it runs: the window before Apalache binds it stays
    # one command long, and no run reuses a port a server that is shutting down may still hold.
    port: Callable[[], int] = free_port

    def tools(self, work: str) -> tuple[str, dict[str, str]]:
        """quint's program and its environment, every tool in place and checked."""
        home = os.path.join(self.cache, "quint-home")
        for tool in TOOLS:
            fetch(tool, home, self.run, self.env)
        quint = install_quint(self.cache, os.path.join(self.checkout, "tests", "quint"), self.run, self.env)
        env = quint_env(self.env, home, work)
        got = self.run([quint, "--version"], work, env)
        if got.returncode != 0 or got.output.strip() != QUINT_VERSION:
            raise StepError(f"{quint} --version: {got.output.strip()!r}, want {QUINT_VERSION}")
        return quint, env

    def check_all(
        self, work: str, quint: str, env: Mapping[str, str], checks: Sequence[Check], spec: str | None
    ) -> int:
        """TLC on each check, one line each; the exit status."""
        config = os.path.join(work, "tlc.json")
        with open(config, "w", encoding="utf-8") as f:
            json.dump(TLC_CONFIG, f)
        status, largest, total = 0, 0, 0.0
        for check in checks:
            path = spec if spec is not None else os.path.join(self.checkout, check.spec)
            ran = self.run(tlc_argv(quint, path, check, config, server_endpoint(self.port())), work, env)
            found = verdict(ran)
            largest, total = max(largest, ran.max_rss_kb), total + ran.seconds
            self.out(
                f"{check.main}: {found.result}, {known(found.states)} states, depth {known(found.depth)}, "
                f"{ran.seconds:.1f} s, largest RSS {rss(ran.max_rss_kb)} ({', '.join(check.invariants)})"
            )
            if found.result != "ok":
                status = EX_FAILED
                self.out(ran.output.strip()[-6000:])
        self.out(f"{len(checks)} instance(s) in {total:.1f} s, largest RSS of any run {rss(largest)}")
        return status

    def write_traces(self, work: str, quint: str, env: Mapping[str, str], jobs: Sequence[TraceJob]) -> int:
        """Each job's trace, normalized, into its spec's traces folder of the checkout; then the replays."""
        for job in jobs:
            raw = os.path.join(work, f"{job.name}.raw.itf.json")
            argv = trace_argv(
                quint, os.path.join(self.checkout, job.spec), job, raw, lambda: server_endpoint(self.port())
            )
            ran = self.run(argv, work, env)
            problem = trace_problem(job, ran)
            if problem is None and not os.path.exists(raw):
                problem = f"quint wrote no trace (exit {ran.returncode})"
            if problem is not None:
                self.out(ran.output.strip()[-3000:])
                raise StepError(f"{job.name}: {problem}")
            with open(raw, encoding="utf-8") as f:
                text = normalize(f.read(), f"{job.backend} trace {job.name} of {job.spec} ({job.main})")
            dest = os.path.join(self.checkout, TRACES_DIR[job.spec], f"{job.name}.itf.json")
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "w", encoding="utf-8") as f:
                f.write(text)
            self.out(f"{job.name}: {ran.seconds:.1f} s -> {os.path.relpath(dest, self.checkout)}")
        status = 0
        for module in sorted({REPLAYS[job.spec] for job in jobs}):
            argv = ["timeout", str(REPLAY_TIMEOUT), sys.executable, "-I", "-B", "tests/run_unit.py", module]
            ran = self.run(argv, self.checkout, self.env)
            self.out(f"replay {module}: exit {ran.returncode}")
            if ran.returncode != 0:
                self.out(ran.output.strip()[-6000:])
                status = EX_FAILED
        return status


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="cst-quint", description="TLC on CST's Quint specs, and their traces.")
    p.add_argument("--instance", help="only this instance (a module of the spec)")
    p.add_argument("--spec", help="check this file instead of the checked-in spec")
    p.add_argument("--traces", action="store_true", help="write the checked-in traces again, then run the replay")
    p.add_argument("--keep", action="store_true", help="keep the work folder")
    return p.parse_args(argv)


def cache_root(env: Mapping[str, str]) -> str | None:
    """The tool's folder under the user's cache folder (tests/xdg_cache.py), or None when there is none."""
    base = cache_base(env)
    return None if base is None else os.path.join(base, "cst-quint")


def checkout_root() -> str:
    return _CHECKOUT


@dataclass(frozen=True, slots=True)
class Seams:
    """What main takes from outside: the checkout, the environment, how commands run and what is on PATH,
    where lines go, the checks and trace jobs, and the free ports (the tests give fakes)."""

    checkout: str | None = None
    env: Mapping[str, str] | None = None
    run: Exec = execute
    which: Callable[[str], str | None] = shutil.which
    out: Callable[[str], None] = print
    checks: Sequence[Check] = CHECKS
    jobs: Sequence[TraceJob] = TRACE_JOBS
    port: Callable[[], int] = free_port


def usage_problem(args: argparse.Namespace, chosen: Sequence[Check]) -> str | None:
    """Why the command line cannot run (main exits 2 with it), or None; chosen: the checks --instance selects."""
    if args.traces and (args.spec or args.instance):
        return "cst-quint: --traces writes every trace of the checked-in specs: no --spec or --instance with it"
    if not chosen and not args.traces:
        return f"cst-quint: no instance {args.instance!r}" if args.instance else "cst-quint: no check is defined"
    # A planted copy stands for one spec: checks of several specs would all run against it.
    specs = sorted({c.spec for c in chosen})
    if args.spec and len(specs) > 1:
        return f"cst-quint: --spec needs --instance: the checks come from {', '.join(specs)}"
    return None


def main(argv: Sequence[str], seams: Seams | None = None) -> int:
    s = Seams() if seams is None else seams
    checkout, run, which, out, checks, jobs = s.checkout, s.run, s.which, s.out, s.checks, s.jobs
    args = parse_args(argv)
    env = dict(os.environ) if s.env is None else dict(s.env)
    missing = [tool for tool in REQUIRED if which(tool) is None]
    if missing:
        out(f"cst-quint: needs {', '.join(missing)} on PATH")
        return EX_USAGE
    chosen = [c for c in checks if args.instance is None or c.main == args.instance]
    problem = usage_problem(args, chosen)
    if problem is not None:
        out(problem)
        return EX_USAGE
    cache = cache_root(env)
    if cache is None:
        out(f"cst-quint: {NO_CACHE_BASE}")
        return EX_USAGE
    session = Session(checkout or checkout_root(), cache, run, env, out, s.port)
    os.makedirs(os.path.join(session.cache, "work"), exist_ok=True)
    work = tempfile.mkdtemp(prefix="run-", dir=os.path.join(session.cache, "work"))
    try:
        quint, qenv = session.tools(work)
        if args.traces:
            return session.write_traces(work, quint, qenv, jobs)
        return session.check_all(work, quint, qenv, chosen, os.path.abspath(args.spec) if args.spec else None)
    except StepError as e:
        out(f"cst-quint: {e}")
        return EX_FAILED
    finally:
        if args.keep:
            out(f"work folder kept: {work}")
        else:
            shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
