#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
#
# game-profile
#
# Installed by cpu-setup.sh (CST) as /usr/local/sbin/cpu-game-profile.
# Runs as root from cpu-game.service (started/stopped by GameMode's [custom]
# hooks, or by `cst cpu game on|off`), and from cpu-game-watchdog.timer.
#
#   on     while a game runs: VM and Docker containers off the P-cores and the
#          game's E-cores (CPUs 12-23) with a low weight, toolboxes idle-class,
#          the other boxes of the user manager that sit next to the game
#          (its top-level slices other than app/session/user.slice, and
#          `systemd-run --user` jobs straight in app.slice) idle-class too,
#          P-cores at EPP performance, the game's memory protected from
#          reclaim along the whole cgroup chain, and desktop apps' swapped
#          pages kept in zswap (no writeback to the NVMe swap).
#   off    exact revert: runtime overrides this script created are deleted
#          (then daemon-reload), so nothing masks /etc drop-ins afterwards;
#          ones that existed before get their previous value back. The
#          MemoryLow drop-ins (zz-cst-game.conf) go always, also without a
#          game.state.
#   tick   watchdog (every 30 s): 'off' if no GameMode client is left (unless
#          switched on by hand); 'on' if a client runs and the profile is off
#          (fallback if the GameMode hook could not start the unit), unless
#          switched off by hand during that game; new containers get pinned,
#          new Steam scopes (the game itself) get the memory protection, and
#          new boxes of the user manager next to the game get idle-class;
#          a setting that something undid meanwhile (a daemon-reload, or
#          uresourced resetting MemoryLow) is set again and logged. With the
#          profile off, it removes MemoryLow drop-ins left behind.
#   state  what is applied now, and which settings drifted from what 'on' set.
#
# Everything is runtime-only: a reboot clears it too. A runtime override is
# not permanent within a boot either: every daemon-reload re-reads the
# drop-ins, and a drop-in that sorts after it, or a same-named file in
# /etc/systemd/system.control (uresourced's 50-MemoryLow.conf), wins again.
# For the MemoryLow chain 'on' therefore also writes a drop-in named
# zz-cst-game.conf, which sorts after every other one (see write_game_dropins).
#
# For other projects: /run/cpu-setup/game.state exists exactly while the
# profile is on. Key on its existence only; its contents may change.
# Settings: /etc/cpu-setup/cpu-setup.conf.

set -Euo pipefail

CONF=/etc/cpu-setup/cpu-setup.conf
RUN=/run/cpu-setup
STATE="${RUN}/game.state"
MANUAL="${RUN}/manual"
# What 'on' set, as systemctl show reported it right after (16G reads back in
# bytes), for the drift repair of tick(). A separate file, so game.state keeps
# the format off() reads; a profile switched on by an older version has none.
INTENDED="${RUN}/game.intended"
SUPPRESS="${RUN}/suppress"   # 'game off' by hand: no automatic 'on' until the game ends
CGROOT=/sys/fs/cgroup
# Runtime unit folder of the system manager, and the name of the MemoryLow
# drop-ins 'on' writes there (write_game_dropins).
UNIT_RUNTIME=/run/systemd/system
GAME_DROPIN=zz-cst-game.conf

# Defaults; cpu-setup.conf overrides.
TARGET_USER=""
BUILD_CPUS="12-23"         # VM, Docker and nothing of the game while it runs
P_CORES="0-7"
VM_WEIGHT=10
GAME_MEMORY_LOW="16G"      # Dota 2 ~10 GB resident + steamwebhelper
GAME_ZSWAP_WRITEBACK="no"  # app.slice during games: "no" = swapped pages stay in zswap, "yes" = leave as is
# shellcheck source=/dev/null
[[ -r "${CONF}" ]] && . "${CONF}"

log() { echo "<$1>game-profile: $2"; }

expand_cpus() {   # "0-3,6" -> "0 1 2 3 6"
    local part out=() parts
    IFS=',' read -ra parts <<<"$1"
    for part in "${parts[@]}"; do
        if [[ "${part}" == *-* ]]; then
            mapfile -t -O "${#out[@]}" out < <(seq "${part%-*}" "${part#*-}")
        else
            out+=("${part}")
        fi
    done
    echo "${out[@]}"
}

uid() { id -u "${TARGET_USER}"; }
# mgr: "sys" (system manager) or "usr" (the user's manager).
ctl() {
    local mgr="$1"
    shift
    if [[ "${mgr}" == usr ]]; then
        systemctl --user -M "${TARGET_USER}@" "$@"
    else
        systemctl "$@"
    fi
}
# Transient units: scopes (Docker containers, Steam, apps) and the
# run-*.service of systemd-run. systemd made them at run time, from files in
# its transient folder.
transient_unit() {
    case "$1" in *.scope|run-*.service) return 0 ;; esac
    return 1
}
ctl_file() {   # mgr unit prop: where `set-property --runtime` writes
    # For a transient unit systemd writes the override next to the unit's own
    # file, in the transient folder, not in the control folder.
    local base=/run/systemd dir=system.control
    if [[ "$1" == usr ]]; then
        base="/run/user/$(uid)/systemd"
        dir=user.control
    fi
    transient_unit "$2" && dir=transient
    echo "${base}/${dir}/$2.d/50-$3.conf"
}
prop() { ctl "$1" show -P "$3" "$2" 2>/dev/null | sed 's/^\[not set\]$//'; }

# setp MGR UNIT PROP=VALUE...: record, per property, whether a runtime
# override already existed (and its value), then apply. For fixed units (not
# the transient ones: scopes and the run-*.service of systemd-run, which have
# no drop-in that could win over the override), also record the value as
# systemctl show reports it now, in INTENDED: "prop MGR UNIT PROP VALUE SHOWN".
setp() {
    local mgr="$1" unit="$2" kv p
    shift 2
    for kv in "$@"; do
        p="${kv%%=*}"
        if [[ -e "$(ctl_file "${mgr}" "${unit}" "${p}")" ]]; then
            printf 'prop %q %q %q existed %q\n' "${mgr}" "${unit}" "${p}" "$(prop "${mgr}" "${unit}" "${p}")" >>"${STATE}"
        else
            printf 'prop %q %q %q new -\n' "${mgr}" "${unit}" "${p}" >>"${STATE}"
        fi
    done
    if ! ctl "${mgr}" set-property --runtime "${unit}" "$@"; then
        log 4 "${unit}: could not set $*"
        return 0
    fi
    transient_unit "${unit}" && return 0
    for kv in "$@"; do
        p="${kv%%=*}"
        printf 'prop %q %q %q %q %q\n' "${mgr}" "${unit}" "${p}" "${kv#*=}" "$(prop "${mgr}" "${unit}" "${p}")" >>"${INTENDED}"
    done
}

# Every Steam scope: the client has one, and each game it starts gets its own
# (started after 'on' ran, so tick() picks those up).
steam_scopes() {
    ctl usr list-units --type=scope --state=running --plain --no-legend 'app-flatpak-com.valvesoftware.Steam-*' 2>/dev/null |
        awk '{print $1}'
}
# Docker containers outside builds.slice (no cgroup-parent yet, or started
# before dockerd was restarted with it).
loose_docker_scopes() {
    local s
    systemctl list-units --type=scope --state=running --plain --no-legend 'docker-*.scope' 2>/dev/null |
        awk '{print $1}' | while read -r s; do
            [[ "$(systemctl show -P Slice "${s}")" == builds.slice ]] || echo "${s}"
        done
}
uses_builds_slice() { systemctl -q is-active builds.slice 2>/dev/null; }
# A process with GameMode's client library loaded (gamemoderun /
# libgamemodeauto). grep -q: no pipe, so no SIGPIPE under pipefail.
gamemode_client() { grep -qsF libgamemode /proc/[0-9]*/maps; }

protect_steam() {
    local s
    for s in $(steam_scopes); do
        grep -qF " ${s} MemoryLow " "${STATE}" 2>/dev/null && continue
        setp usr "${s}" MemoryLow="${GAME_MEMORY_LOW}"
    done
}

# A user manager started before cpuset was delegated to it (cpu-setup install
# needs a new login for that) accepts AllowedCPUs but never writes cpuset.cpus.
# Then the cgroup file is written directly, and recorded for 'off'.
cpus_fallback() {   # usr UNIT
    local cg f old
    cg="$(ctl usr show -P ControlGroup "$1" 2>/dev/null)"
    f="/sys/fs/cgroup${cg}/cpuset.cpus"
    [[ -n "${cg}" && -w "${f}" ]] || return 0
    old="$(cat "${f}")"
    [[ "${old}" == "${BUILD_CPUS}" ]] && return 0
    printf 'cgw %q %q\n' "${f}" "${old}" >>"${STATE}"
    if echo "${BUILD_CPUS}" >"${f}" 2>/dev/null; then
        printf 'cgw %q %q %q\n' "${f}" "${BUILD_CPUS}" "$(cat "${f}")" >>"${INTENDED}"
    else
        log 4 "$1: could not write ${f}"
    fi
}

pin_docker() {
    local s
    for s in $(loose_docker_scopes); do
        grep -qF " ${s} AllowedCPUs " "${STATE}" 2>/dev/null && continue
        setp sys "${s}" AllowedCPUs="${BUILD_CPUS}"
    done
}

# The user manager's own cgroup folder.
user_cg() {
    echo "${CGROOT}/user.slice/user-$(uid).slice/user@$(uid).service"
}
# cpuset in use by the user manager (cpu-setup install, next login).
cpuset_delegated() {
    grep -qsw cpuset "$(user_cg)/cgroup.subtree_control"
}

# Boxes of the user manager that compete with the game but that no other rule
# covers, as cgroup folders: its top-level slices other than app.slice (the
# game and the desktop apps), session.slice (gnome-shell) and user.slice (the
# toolboxes, handled in 'on'), such as background.slice (GNOME's file
# indexer) or a slice a job made with `systemd-run --user --slice=NAME.slice`;
# and the transient units `systemd-run --user` puts straight into app.slice,
# next to the game. A slice named user-NAME.slice nests under the toolboxes'
# user.slice, and app-NAME.slice under app.slice: neither is listed here.
escaped_cgroups() {
    local cg d u
    cg="$(user_cg)"
    for d in "${cg}"/*.slice "${cg}"/app.slice/run-*.scope "${cg}"/app.slice/run-*.service; do
        [[ -d "${d}" ]] || continue   # also an unmatched pattern
        # systemd puts a '_' before a cgroup name that could clash with a
        # controller file (cpu.slice -> _cpu.slice).
        u="${d##*/}"
        case "${u#_}" in app.slice|session.slice|user.slice) continue ;; esac
        echo "${d}"
    done
}

gamemode_pid() {
    grep -qsF libgamemode "/proc/$1/maps"
}
# A GameMode client (the game itself) in cgroup folder DIR or below it.
gamemode_in() {
    local f pid
    while IFS= read -r f; do
        while read -r pid; do
            gamemode_pid "${pid}" && return 0
        done <"${f}"
    done < <(find "$1" -maxdepth 4 -name cgroup.procs -type f 2>/dev/null)
    return 1
}

# Idle-class (and off 8-11, with cpuset delegated) for each box of
# escaped_cgroups that is not handled yet. One already in game.state is
# skipped, so a tick adds nothing for it; the record is %q-quoted, and so is
# the name looked for. A box that holds a GameMode client is the game: it is
# left alone. A slice keeps the setting when it empties and comes back: the
# runtime override stays in /run/user/UID/systemd/user.control.
demote_escapes() {
    local d u q
    local -a settings=(CPUWeight=idle)
    cpuset_delegated && settings+=(AllowedCPUs="${BUILD_CPUS}")
    while IFS= read -r d; do
        u="${d##*/}"
        u="${u#_}"
        printf -v q '%q' "${u}"
        grep -qF "prop usr ${q} CPUWeight " "${STATE}" 2>/dev/null && continue
        gamemode_in "${d}" && continue
        log 5 "${u}: idle while the game runs (a box of the user manager next to the game)"
        setp usr "${u}" "${settings[@]}"
    done < <(escaped_cgroups)
}

# The memory chain on the system side as a drop-in too. uresourced keeps
# 50-MemoryLow.conf (MemoryLow=0) for these three units in
# /etc/systemd/system.control, which comes before /run/systemd/system.control:
# after each daemon-reload that file hides the runtime override of setp (same
# name), until the next tick repairs it. Drop-ins with different names are all
# applied, in file-name order whatever their folder, and the last one wins
# (systemd.unit(5)): zz- sorts after 50-, so this file holds across reloads.
# No reload is needed now: setp set the live value already.
game_dropin_units() {
    echo user.slice "user-$(uid).slice" "user@$(uid).service"
}
write_game_dropins() {
    local u sec d
    for u in $(game_dropin_units); do
        sec=Slice
        [[ "${u}" == *.service ]] && sec=Service
        d="${UNIT_RUNTIME}/${u}.d"
        if ! { mkdir -p "${d}" && printf '%s\n' \
                "# Written by cpu-game-profile (CST) while the game profile is on; 'off' removes it." \
                "[${sec}]" "MemoryLow=${GAME_MEMORY_LOW}" >"${d}/${GAME_DROPIN}"; } 2>/dev/null; then
            log 4 "${u}: could not write ${d}/${GAME_DROPIN}"
        fi
    done
}
# Removes every such drop-in, whatever unit and user it is for: one left
# behind (a profile whose game.state went missing) would keep the protection
# until the next reboot. Status 0 when one was removed: a daemon-reload is due.
remove_game_dropins() {
    local f rc=1
    for f in "${UNIT_RUNTIME}"/*.d/"${GAME_DROPIN}"; do
        [[ -e "${f}" ]] || continue
        rm -f "${f}"
        rmdir "${f%/*}" 2>/dev/null || true
        rc=0
    done
    return "${rc}"
}
# With the profile off ('off' without a game.state, or a tick): remove such
# drop-ins left behind and reload, so their MemoryLow goes too.
remove_leftover_dropins() {
    remove_game_dropins || return 0
    systemctl daemon-reload
    log 4 "profile off, but its MemoryLow drop-ins (${GAME_DROPIN}) were still there: removed them"
}

on() {
    if [[ -e "${STATE}" ]]; then
        log 6 "already on"; return 0
    fi
    [[ -n "${TARGET_USER}" ]] || { log 3 "TARGET_USER not set in ${CONF}"; return 1; }
    # Recorded before each change, straight into the state file: if 'on' dies
    # halfway, 'off' still undoes whatever was changed.
    : >"${STATE}"
    : >"${INTENDED}"
    local cpu f u vm_io_weight
    # 1. VM and Docker: off the P-cores and off 8-11 (the game's E-core
    #    workers), low weight.
    # systemd's IOWeight only accepts 1..10000 (not 'idle').
    vm_io_weight="${VM_WEIGHT}"
    if [[ ! "${vm_io_weight}" =~ ^[0-9]+$ ]] || (( 10#${vm_io_weight} < 1 || 10#${vm_io_weight} > 10000 )); then
        vm_io_weight=10
    fi
    setp sys machine.slice AllowedCPUs="${BUILD_CPUS}" CPUWeight="${VM_WEIGHT}" IOWeight="${vm_io_weight}"
    if uses_builds_slice; then
        setp sys builds.slice AllowedCPUs="${BUILD_CPUS}" CPUWeight=idle
    fi
    pin_docker
    # 2. Toolboxes (inner user.slice of the user manager, sibling of app.slice
    #    where the game runs): idle class, so any game thread wins.
    setp usr user.slice CPUWeight=idle
    # With cpuset delegated (cpu-setup install, next login): toolboxes and
    # their host commands also leave 8-11 to the game's E-core workers.
    if cpuset_delegated; then
        setp usr user.slice AllowedCPUs="${BUILD_CPUS}"
        setp usr flatpak-session-helper.service AllowedCPUs="${BUILD_CPUS}"
        cpus_fallback user.slice
        cpus_fallback flatpak-session-helper.service
    fi
    #    The other boxes next to the game: background.slice, slices of
    #    `systemd-run --user --slice=X`, and systemd-run jobs in app.slice.
    demote_escapes
    # 3. The game's memory: memory.low only counts up to every ancestor's
    #    protection, so the whole chain gets it.
    for u in $(game_dropin_units); do
        setp sys "${u}" MemoryLow="${GAME_MEMORY_LOW}"
    done
    write_game_dropins
    setp usr app.slice MemoryLow="${GAME_MEMORY_LOW}"
    protect_steam
    # 4. Desktop apps (game included): pages already reclaimed stay compressed
    #    in zswap instead of being written to the NVMe swap, so bringing them
    #    back costs microseconds, not disk reads. Costs RAM elsewhere; see
    #    cpu/README.md 7.1.
    if [[ "${GAME_ZSWAP_WRITEBACK}" == no ]] && [[ -n "$(prop usr app.slice MemoryZSwapWriteback)" ]]; then
        setp usr app.slice MemoryZSwapWriteback=no
    fi
    # 5. P-cores ramp up at once (E-cores keep their EPP for the builds).
    for cpu in $(expand_cpus "${P_CORES}"); do
        f="/sys/devices/system/cpu/cpu${cpu}/cpufreq/energy_performance_preference"
        [[ -w "${f}" ]] || continue
        printf 'epp %q %q\n' "${cpu}" "$(cat "${f}")" >>"${STATE}"
        echo performance >"${f}" 2>/dev/null || true
    done
    log 5 "on: VM/Docker on ${BUILD_CPUS}, toolboxes and other user boxes idle, game memory protected (${GAME_MEMORY_LOW}), app zswap writeback ${GAME_ZSWAP_WRITEBACK}, P-cores EPP performance"
}

off() {
    local line kind mgr unit p mode old cpu val f i reload_sys=0 reload_usr=0
    local -a rec lines
    # The MemoryLow drop-ins go also without a game.state.
    if [[ ! -e "${STATE}" ]]; then
        rm -f "${MANUAL}"
        remove_leftover_dropins
        return 0
    fi
    remove_game_dropins && reload_sys=1
    mapfile -t lines <"${STATE}"
    # Newest first, so a property touched twice ends at its oldest value.
    for (( i = ${#lines[@]} - 1; i >= 0; i-- )); do
        line="${lines[i]}"
        [[ -n "${line}" ]] || continue
        eval "rec=(${line})"   # fields were written with %q
        kind="${rec[0]}"
        if [[ "${kind}" == cgw ]]; then
            echo "${rec[2]}" >"${rec[1]}" 2>/dev/null || true
            continue
        fi
        if [[ "${kind}" == epp ]]; then
            cpu="${rec[1]}"; val="${rec[2]}"
            echo "${val}" >"/sys/devices/system/cpu/cpu${cpu}/cpufreq/energy_performance_preference" 2>/dev/null || true
            continue
        fi
        mgr="${rec[1]}"; unit="${rec[2]}"; p="${rec[3]}"; mode="${rec[4]}"; old="${rec[5]}"
        if [[ "${mode}" == new ]]; then
            f="$(ctl_file "${mgr}" "${unit}" "${p}")"
            rm -f "${f}"
            rmdir "$(dirname "${f}")" 2>/dev/null || true
            if [[ "${mgr}" == usr ]]; then reload_usr=1; else reload_sys=1; fi
        else
            ctl "${mgr}" set-property --runtime "${unit}" "${p}=${old}" 2>/dev/null || true
        fi
    done
    # Re-reads the units without the deleted overrides and re-applies their
    # cgroup settings (defaults, or the /etc drop-ins).
    if (( reload_sys )); then systemctl daemon-reload; fi
    if (( reload_usr )); then ctl usr daemon-reload; fi
    rm -f "${STATE}" "${INTENDED}" "${MANUAL}"
    log 5 "off: previous CPU, weight, memory, zswap writeback and EPP settings restored"
}

# drift: one line (fields quoted with %q) per setting in INTENDED that no
# longer holds: "prop MGR UNIT PROP VALUE SHOWN NOW" or "cgw FILE VALUE SHOWN
# NOW". One systemctl show per unit, so a tick stays cheap. Skipped, as
# nothing can be compared: a record with an empty SHOWN (systemd reported
# nothing), a unit systemd cannot be asked about or has not loaded (the
# user manager is gone after a logout, builds.slice was removed), and a
# cgroup file that is gone.
drift() {
    [[ -s "${INTENDED}" ]] || return 0
    local line key l mgr unit out
    local -a rec lines args
    local -A props=() now=() loaded=()
    mapfile -t lines <"${INTENDED}"
    for line in "${lines[@]}"; do
        [[ -n "${line}" ]] || continue
        eval "rec=(${line})"   # fields were written with %q
        [[ "${rec[0]}" == prop ]] || continue
        key="${rec[1]} ${rec[2]}"
        props[${key}]+=" ${rec[3]}"
    done
    for key in "${!props[@]}"; do
        mgr="${key%% *}"; unit="${key#* }"
        args=(-p LoadState)
        for l in ${props[${key}]}; do args+=(-p "${l}"); done
        out="$(ctl "${mgr}" show "${args[@]}" "${unit}" 2>/dev/null)" || continue
        while IFS= read -r l; do
            [[ "${l}" == *=* ]] || continue
            [[ "${l}" == *'=[not set]' ]] && l="${l%%=*}="
            now["${key} ${l%%=*}"]="${l#*=}"
        done <<<"${out}"
        [[ "${now["${key} LoadState"]:-}" == loaded ]] && loaded[${key}]=1
    done
    for line in "${lines[@]}"; do
        [[ -n "${line}" ]] || continue
        eval "rec=(${line})"
        case "${rec[0]}" in
            prop)
                [[ -n "${rec[5]:-}" && -n "${loaded["${rec[1]} ${rec[2]}"]:-}" ]] || continue
                l="${now["${rec[1]} ${rec[2]} ${rec[3]}"]:-}"
                [[ "${l}" == "${rec[5]}" ]] && continue
                printf '%q %q %q %q %q %q %q\n' "${rec[@]:0:6}" "${l}"
                ;;
            cgw)
                # A cgroup that is gone (its unit stopped) has nothing to compare.
                [[ -n "${rec[3]:-}" && -e "${rec[1]}" ]] || continue
                l="$(cat "${rec[1]}" 2>/dev/null)"
                [[ "${l}" == "${rec[3]}" ]] && continue
                printf '%q %q %q %q %q\n' "${rec[@]:0:4}" "${l}"
                ;;
        esac
    done
}

# Set again what drift() lists, straight with set-property: not with setp,
# which would add a second record to game.state and make 'off' restore the
# profile's own value instead of the one from before 'on'.
repair_drift() {
    local line
    local -a rec
    while IFS= read -r line; do
        eval "rec=(${line})"
        if [[ "${rec[0]}" == cgw ]]; then
            if echo "${rec[2]}" >"${rec[1]}" 2>/dev/null; then
                log 5 "drift: ${rec[1]} was '${rec[4]}', wrote ${rec[2]} again"
            else
                log 4 "drift: ${rec[1]} is '${rec[4]}', could not write ${rec[2]} again"
            fi
        elif ctl "${rec[1]}" set-property --runtime "${rec[2]}" "${rec[3]}=${rec[4]}" 2>/dev/null; then
            log 5 "drift: ${rec[2]} ${rec[3]} was '${rec[6]}' instead of '${rec[5]}' (daemon-reload or uresourced?): set ${rec[3]}=${rec[4]} again"
        else
            log 4 "drift: ${rec[2]} ${rec[3]} is '${rec[6]}' instead of '${rec[5]}': could not set it again"
        fi
    done < <(drift)
}

tick() {
    if [[ ! -e "${STATE}" ]]; then
        remove_leftover_dropins
        if ! gamemode_client; then
            rm -f "${SUPPRESS}"
        elif [[ ! -e "${SUPPRESS}" ]]; then
            log 5 "GameMode client running but profile off: switching on"
            systemctl start --no-block cpu-game.service
        fi
        return 0
    fi
    if [[ ! -e "${MANUAL}" ]] && ! gamemode_client; then
        log 5 "no GameMode client left: switching off"
        systemctl stop --no-block cpu-game.service
        return 0
    fi
    pin_docker      # containers started meanwhile
    protect_steam   # the game's own scope, started after 'on'
    demote_escapes  # boxes next to the game that appeared after 'on'
    repair_drift    # settings a daemon-reload or uresourced undid
}

state() {
    if [[ -e "${STATE}" ]]; then
        echo "game profile: ON$([[ -e "${MANUAL}" ]] && echo ' (by hand)')"
    else
        echo "game profile: off"
    fi
    printf '  machine.slice   cpus=%-8s weight=%-4s io=%s\n' \
        "$(prop sys machine.slice AllowedCPUs)" "$(prop sys machine.slice CPUWeight)" "$(prop sys machine.slice IOWeight)"
    if uses_builds_slice; then
        printf '  builds.slice    cpus=%-8s weight=%-4s io=%s\n' \
            "$(prop sys builds.slice AllowedCPUs)" "$(prop sys builds.slice CPUWeight)" "$(prop sys builds.slice IOWeight)"
    fi
    if [[ -n "${TARGET_USER}" ]]; then
        printf '  toolboxes       weight=%s\n' "$(prop usr user.slice CPUWeight)"
        printf '  app.slice       zswap writeback=%s\n' "$(prop usr app.slice MemoryZSwapWriteback)"
        printf '  toolboxes       cpus effective=%s\n' \
            "$(cat "/sys/fs/cgroup$(ctl usr show -P ControlGroup user.slice 2>/dev/null)/cpuset.cpus.effective" 2>/dev/null)"
        if [[ -e "${STATE}" ]]; then
            printf '  other boxes     idle: %s\n' "$(escapes_in_state)"
        fi
    fi
    printf '  EPP cpu0 %s, cpu%s %s\n' \
        "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null)" \
        "${BUILD_CPUS%%-*}" "$(cat "/sys/devices/system/cpu/cpu${BUILD_CPUS%%-*}/cpufreq/energy_performance_preference" 2>/dev/null)"
    [[ -e "${STATE}" ]] && state_drift
    return 0
}

# The boxes demote_escapes handled, from game.state ("none" if none).
escapes_in_state() {
    local line out=()
    local -a rec
    while IFS= read -r line; do
        eval "rec=(${line})"
        [[ "${rec[0]:-}" == prop && "${rec[1]:-}" == usr && "${rec[3]:-}" == CPUWeight && "${rec[2]:-}" != user.slice ]] &&
            out+=("${rec[2]}")
    done <"${STATE}"
    if (( ${#out[@]} )); then echo "${out[*]}"; else echo none; fi
}

# The command that switches the profile off and on again in the same mode:
# off() drops the by-hand mark, so a restart of the unit alone would let the
# watchdog switch a by-hand profile off at the next tick when no game runs.
again_cmd() {
    if [[ -e "${MANUAL}" ]]; then
        echo "cst cpu game off && cst cpu game on"
    else
        echo "sudo systemctl restart cpu-game.service"
    fi
}

# The drift part of 'state': each setting that no longer holds, or that none
# drifted.
state_drift() {
    if [[ ! -e "${INTENDED}" ]]; then
        echo "  drift: not checked (switched on by an older version, which kept no record of its values;"
        echo "         $(again_cmd) switches it off and on again with one)"
        return 0
    fi
    local line n=0
    local -a rec
    while IFS= read -r line; do
        eval "rec=(${line})"
        n=$((n + 1))
        if [[ "${rec[0]}" == cgw ]]; then
            printf '  DRIFT: %s is %s, the profile wrote %s\n' "${rec[1]}" "'${rec[4]}'" "'${rec[3]}'"
        else
            printf '  DRIFT: %s %s is %s, the profile set %s\n' "${rec[2]}" "${rec[3]}" "'${rec[6]}'" "'${rec[5]}'"
        fi
    done < <(drift)
    if (( n )); then
        echo "  (a daemon-reload or uresourced undid these; the watchdog sets them again within 30 s;"
        echo "   if they stay: $(again_cmd))"
    else
        echo "  drift: none (every setting the profile made still holds)"
    fi
}

# on/off/tick never interleave (e.g. a tick re-pinning containers after 'off').
locked() {
    install -d -m 0755 "${RUN}"
    exec 9>"${RUN}/lock"
    flock -w 60 9 || { log 3 "lock busy"; exit 1; }
    "$@"
}

case "${1:-}" in
    on) locked on ;;
    off) locked off ;;
    tick) locked tick ;;
    state) state ;;
    *) echo "usage: game-profile on|off|tick|state" >&2; exit 2 ;;
esac
