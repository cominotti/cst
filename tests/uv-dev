#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# uv-dev: run a developer tool (ruff, ty) from the locked "dev" group of
# pyproject.toml, through uv.
#
#   tests/uv-dev ruff check            # `invowk cmd test pylint` runs this,
#   tests/uv-dev ruff format --check   # then this
#   tests/uv-dev ty check              # part of `invowk cmd test types`
#   tests/uv-dev ruff check --fix      # anything else, by hand
#   tests/uv-dev --group mutation cosmic-ray --help
#
# `--group NAME` before the tool adds that dependency group of
# pyproject.toml (such as "mutation", which has cosmic-ray) to "dev". It can
# be given more than once. Everything after the groups goes to the tool
# unchanged.
#
# The tools' virtual environment never goes inside the checkout (it would
# land in the snapshots of ~/Workspace): it lives under
# ${XDG_CACHE_HOME:-~/.cache}/cst-dev-venv/<key>, one per checkout or
# worktree, where <key> is the first 12 hex digits of the SHA-1 of the
# checkout's physical path. ruff's cache goes next to it. `--locked` makes uv
# refuse to run when uv.lock does not match pyproject.toml, and installs
# exactly the locked versions (hashes checked). See docs/dev-tools.md.
set -euo pipefail

groups=(--group dev)
while [[ $# -gt 0 && "$1" == --group ]]; do
    if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        echo "uv-dev: --group needs the name of a dependency group of pyproject.toml" >&2
        exit 2
    fi
    groups+=(--group "$2")
    shift 2
done

if ! command -v uv >/dev/null 2>&1; then
    echo "uv-dev: uv is not installed (see docs/dev-tools.md)" >&2
    exit 127
fi

repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
key="$(printf '%s' "${repo}" | sha1sum | cut -c1-12)"
cache="${XDG_CACHE_HOME:-${HOME}/.cache}"
export UV_PROJECT_ENVIRONMENT="${cache}/cst-dev-venv/${key}"
export RUFF_CACHE_DIR="${cache}/cst-dev-ruff/${key}"

cd "${repo}"
exec uv run --locked --project "${repo}" "${groups[@]}" "$@"
