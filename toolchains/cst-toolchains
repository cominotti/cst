def render_timer():
    return f"""\
{MARKER}: installed by `cst toolchains auto on` (or snapshots setup); not edited by hand.
[Unit]
Description=CST: prune old toolchain caches, hourly

[Timer]
OnCalendar=hourly
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
"""


UNITS = {SERVICE: render_service, TIMER: render_timer}


def file_state(path, wanted, marker=MARKER):
    """ok | change (ours, differs) | conflict (not ours, or a symlink) | missing."""
    try:
        if stat.S_ISLNK(os.lstat(path).st_mode):
            return "conflict"
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except FileNotFoundError:
        return "missing"
    except OSError:
        return "conflict"
    if wanted is not None and text == wanted:
        return "ok"
    return "change" if marker in text else "conflict"


def read_text(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def copies():
    """{installed path (relative to home): source text}: this program and
    its defaults, as the timer runs them."""
    return {PROG_REL: read_text(os.path.realpath(__file__)), DEFAULTS_REL: read_text(defaults_path())}


def unit_states(home):
    out = {rel: file_state(os.path.join(home, rel), text) for rel, text in copies().items()}
    for name, render in UNITS.items():
        out[name] = file_state(os.path.join(home, UNIT_DIR_REL, name), render())
    return out


def label(key):
    return f"~/{key}" if "/" in key else f"~/{UNIT_DIR_REL}/{key}"


def write_atomic(path, text, mode):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def turned_off(home):
    return os.path.lexists(os.path.join(home, OFF_REL))


def stale_files(home):
    """[(path, ours)] of what `cst btrfs cargo-gc enable|disable` left
    (the first version of this cleanup)."""
    out = []
    for rel in [f"{UNIT_DIR_REL}/{u}" for u in OLD_UNITS] + list(OLD_FILES):
        path = os.path.join(home, rel)
        st = file_state(path, None, OLD_MARKER)
        if st != "missing":
            out.append((path, st == "change"))
    for rel in OLD_DATA:
        path = os.path.join(home, rel)
        if os.path.lexists(path):
            out.append((path, not os.path.islink(path)))
    return out


def remove_stale(home):
    found = stale_files(home)
    if not found:
        return
    timer = os.path.join(home, UNIT_DIR_REL, OLD_TIMER)
    if (timer, True) in found:
        systemctl("disable", "--now", OLD_TIMER)
    reload = False
    for path, ours in found:
        if not ours:
            say(f"left alone: {tilde(path, home)} (not written by CST)", 4, err=True)
            continue
        os.unlink(path)
        say(f"removed:   {tilde(path, home)} (left by the earlier `cst btrfs cargo-gc`)")
        reload = reload or path.startswith(os.path.join(home, UNIT_DIR_REL) + "/")
    if reload:
        systemctl("daemon-reload")


def old_conf_note(home):
    if os.path.lexists(os.path.join(home, OLD_CONF_REL)):
        say(f"note: ~/{OLD_CONF_REL} is no longer read: put its settings into ~/{CONF_REL} "
            "with the RUST_BUILD_ prefix (e.g. RUST_BUILD_MAX_IDLE=48h), then remove it", 4, err=True)


def cmd_auto_on(home, now, unless_off=False):
    remove_stale(home)
    if unless_off and turned_off(home):
        say(f"left off: you turned the automatic pruning off ({PROG} auto off left ~/{OFF_REL}); "
            f"'{PROG} auto on' turns it on again")
        return 0
    settings = Settings(home)
    enabled = [cls for tid, cls in TARGETS.items() if settings.enabled[tid]]
    if not enabled:
        raise Refused(f"no target is enabled in the settings ({settings.source}): the timer would do nothing")
    # Checked as the timer will run: programs are looked for in the PATH of
    # the user manager (the service's PATH), not in this command's (run by
    # snapshots setup through runuser, it is root's). If no target would run,
    # no timer.
    mpath, asked = None, False
    refused = []
    for cls in enabled:
        t = cls(home, now, settings.policy[cls.ID])
        if cls.USES_PATH:
            if not asked:
                mpath, asked = manager_path(), True
            t.path = mpath
        try:
            t.check()
        except Refused as e:
            refused.append(f"{cls.ID}: {e}")
    if len(refused) == len(enabled):
        raise Refused("; ".join(refused))
    where = ("in the PATH of your user manager, which the timer uses" if mpath is not None else
             "in the PATH of this command; the timer uses your user manager's PATH (systemctl --user "
             "show-environment), which could not be read")
    for r in refused:
        say(f"note: {r} (looked for {where}): each timer run tries it and reports it as refused (an error) "
            f"until it is fixed; or set its _ENABLED=no in ~/{CONF_REL}", 4, err=True)
    st = unit_states(home)
    conflicts = [k for k, v in st.items() if v == "conflict"]
    if conflicts:
        raise Refused("not written by CST (or a symlink), left alone: " + ", ".join(label(k) for k in conflicts))
    changed = False
    for rel, text in copies().items():
        if st[rel] != "ok":
            write_atomic(os.path.join(home, rel), text, 0o755 if rel == PROG_REL else 0o644)
            say(f"written:   ~/{rel}")
        else:
            say(f"unchanged: ~/{rel}")
    for name, render in UNITS.items():
        if st[name] != "ok":
            write_atomic(os.path.join(home, UNIT_DIR_REL, name), render(), 0o644)
            say(f"written:   {label(name)}")
            changed = True
        else:
            say(f"unchanged: {label(name)}")
    if changed:
        systemctl("daemon-reload", check=True)
    systemctl("enable", "--now", TIMER, check=True)
    say(f"enabled:   {TIMER} (hourly; logs: journalctl --user -u {SERVICE})")
    if turned_off(home):
        os.unlink(os.path.join(home, OFF_REL))
        say(f"removed:   ~/{OFF_REL} (snapshots setup keeps it enabled again)")
    old_conf_note(home)
    return 0


def cmd_auto_off(home, now):
    remove_stale(home)
    st = unit_states(home)
    if st[TIMER] in ("ok", "change"):
        systemctl("disable", "--now", TIMER)
    removed = False
    for name in UNITS:
        if st[name] in ("ok", "change"):
            os.unlink(os.path.join(home, UNIT_DIR_REL, name))
            say(f"removed:   {label(name)}")
            removed = True
        elif st[name] == "conflict":
            say(f"left alone: {label(name)} (not written by CST)", 4, err=True)
    if removed:
        systemctl("daemon-reload")
    for rel in copies():
        if st[rel] in ("ok", "change"):
            os.unlink(os.path.join(home, rel))
            say(f"removed:   ~/{rel}")
        elif st[rel] == "conflict":
            say(f"left alone: ~/{rel} (not written by CST)", 4, err=True)
    try:
        os.rmdir(os.path.join(home, LIB_REL))       # only when empty (bluetooth keeps its watcher there)
    except OSError:
        pass
    for tid in TARGETS:
        try:
            os.unlink(state_path(home, tid))
        except OSError:
            pass
    if not turned_off(home):
        write_atomic(os.path.join(home, OFF_REL),
                     f"{MARKER}: written by `cst toolchains auto off`.\n"
                     "# While this file exists, `cst btrfs snapshots setup` does not turn the hourly\n"
                     "# pruning of toolchain caches back on. `cst toolchains auto on` removes it.\n", 0o644)
        say(f"written:   ~/{OFF_REL} (snapshots setup leaves the pruning off)")
    say(f"toolchain caches are no longer pruned automatically (settings in ~/{CONF_REL} kept, if any)")
    return 0


def timer_text(home):
    if file_state(os.path.join(home, UNIT_DIR_REL, TIMER), render_timer()) == "missing":
        if turned_off(home):
            return (f"timer {TIMER}: turned off by you ({PROG} auto off; "
                    f"snapshots setup leaves it off; {PROG} auto on turns it on)")
        return f"timer {TIMER}: not installed ({PROG} auto on)"
    en = systemctl("is-enabled", TIMER)
    ac = systemctl("is-active", TIMER)
    txt = f"timer {TIMER}: {en or 'unknown'}, {ac or 'unknown'}"
    if ac == "active":
        nxt = systemctl("show", "-p", "NextElapseUSecRealtime", "--value", TIMER)
        if nxt and nxt not in ("n/a", "0"):
            txt += f", next {nxt}"
    return txt


# ---- config: the toolchain settings in your home ---------------------------------------------
# Exactly what `cst btrfs snapshots setup` always wrote (same lines, same
# comments, same rules): a setting already there is never changed.
CARGO_CFG_REL = ".cargo/config.toml"
UV_CFG_REL = ".config/uv/uv.toml"
_WS = r"[^\S\n]"      # a blank that is not a line break (grep's [[:space:]] within a line)
CARGO_HAS_BUILD_DIR = re.compile(rf"^{_WS}*build-dir{_WS}*=|^{_WS}*build\.build-dir", re.M)
CARGO_HAS_BUILD = re.compile(rf"^{_WS}*\[{_WS}*build{_WS}*\]|^{_WS}*build\.", re.M)
UV_HAS_LINK_MODE = re.compile(rf"^{_WS}*link-mode{_WS}*=", re.M)
UV_HAS_TABLE = re.compile(rf"^{_WS}*\[", re.M)


def cargo_text(home):
    return ("\n# Added by btrfs-setup.sh (CST): intermediate build artifacts live in\n"
            "# ~/.cache (a subvolume excluded from /home snapshots); final ones stay in target/.\n"
            f"[build]\nbuild-dir = \"{home}/{ROOT_REL}/{HASH_VAR}\"\n")


UV_TEXT = ("# Added by btrfs-setup.sh (CST): ~/.cache is its own subvolume and\n"
           "# hardlinks cannot cross subvolumes; reflink clones can.\n"
           "link-mode = \"clone\"\n")


def read_cfg(path):
    """Text of a config file; '' when missing; None when it cannot be read."""
    try:
        with open(path, "rb") as f:
            return f.read().decode("utf-8", "replace")
    except FileNotFoundError:
        return ""
    except OSError:
        return None


def config_items(home):
    """[(name, path, state, text to append)]; state: set | by-hand | write |
    unreadable."""
    out = []
    path = os.path.join(home, CARGO_CFG_REL)
    text = read_cfg(path)
    if text is None:
        st = "unreadable"
    elif CARGO_HAS_BUILD_DIR.search(text):
        st = "set"
    elif CARGO_HAS_BUILD.search(text):
        st = "by-hand"
    else:
        st = "write"
    out.append(("cargo", path, st, cargo_text(home)))
    path = os.path.join(home, UV_CFG_REL)
    text = read_cfg(path)
    if text is None:
        st = "unreadable"
    elif UV_HAS_LINK_MODE.search(text):
        st = "set"
    elif UV_HAS_TABLE.search(text):
        st = "by-hand"
    else:
        st = "write"
    out.append(("uv", path, st, UV_TEXT))
    return out


def cargo_build_dir_is_csts(home):
    try:
        with open(os.path.join(home, CARGO_CFG_REL), "rb") as f:
            build = tomllib.load(f).get("build")
    except (OSError, tomllib.TOMLDecodeError):
        return False
    return isinstance(build, dict) and build.get("build-dir") == expected_template(home)


# The opt-in item: lean debug info for dev builds. Off unless
# RUST_LEAN_DEBUGINFO=yes (or config apply --lean-debuginfo); `cst btrfs
# snapshots setup` passes --no-lean-debuginfo, so it never turns it on.
# Changing debug info changes every dev build's fingerprint: the first build of
# each workspace afterwards compiles everything again.
LEAN_HEAD = ("\n# Added by toolchains-setup.sh (CST) for RUST_LEAN_DEBUGINFO=yes: smaller dev builds.\n"
             "# Your own crates keep line tables (backtraces show file:line); dependencies get no\n"
             "# debug info. These lines take precedence over [profile.dev] in each project's Cargo.toml.\n")
LEAN_KEYS = (
    ("profile.dev", ("profile", "dev"), "line-tables-only", '[profile.dev]\ndebug = "line-tables-only"\n'),
    ('profile.dev.package."*"', ("profile", "dev", "package", "*"), False,
     '[profile.dev.package."*"]\ndebug = false\n'),
)
LEAN_REBUILD = ("turning it on makes the next dev build of every workspace compile everything once "
                "(all at once if many worktrees build together): apply it while builds are quiet")


def dig(data, path):
    for k in path:
        if not isinstance(data, dict) or k not in data:
            return None
        data = data[k]
    return data


def same_debug(value, want):
    if want is False:
        return value is False or value == "none" or (type(value) is int and value == 0)
    return value == want


def lean_state(home):
    """{path, text, add: [(label, block)], have: [label], conflicts: [text],
    append: text or '' (when appending is safe), error: ''}."""
    path = os.path.join(home, CARGO_CFG_REL)
    st = {"path": path, "add": [], "have": [], "conflicts": [], "append": "", "error": ""}
    text = read_cfg(path)
    if text is None:
        st["error"] = "cannot be read"
        return st
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        st["error"] = f"is not valid TOML ({e})"
        return st
    for label_, tpath, want, block in LEAN_KEYS:
        table = dig(data, tpath)
        if isinstance(table, dict) and "debug" in table:
            if same_debug(table["debug"], want):
                st["have"].append(label_)
            else:
                st["conflicts"].append(f"[{label_}] debug = {json.dumps(table['debug'])} is yours: left as it is")
        else:
            st["add"].append((label_, block))
    if st["add"]:
        extra = LEAN_HEAD + "\n".join(b for _, b in st["add"])
        new = text + ("" if not text or text.endswith("\n") else "\n") + extra
        # Appended tables must not clash with the file's (TOML forbids a
        # table twice): parse the result and compare.
        try:
            nd = tomllib.loads(new)
        except tomllib.TOMLDecodeError:
            nd = None
        expect = json.loads(json.dumps(data))
        for label_, tpath, want, _ in LEAN_KEYS:
            if any(label_ == a for a, _ in st["add"]):
                d = expect
                for k in tpath:
                    d = d.setdefault(k, {})
                d["debug"] = want
        if nd is not None and json.loads(json.dumps(nd)) == expect:
            st["append"] = extra
    return st


def lean_wanted(settings, lean):
    if lean is not None:
        return lean, ("--lean-debuginfo" if lean else "--no-lean-debuginfo")
    if settings is None:
        return False, "bad settings"
    return settings.options["RUST_LEAN_DEBUGINFO"], "RUST_LEAN_DEBUGINFO=" + (
        "yes" if settings.options["RUST_LEAN_DEBUGINFO"] else "no")


def lean_lines(home, verb, settings, lean):
    st = lean_state(home)
    shown = tilde(st["path"], home)
    want, why = lean_wanted(settings, lean)
    if st["error"]:
        return [("?", shown, f"lean debug info: the file {st['error']}")]
    if not want:
        if not st["add"] and not st["conflicts"]:
            return [("on", shown, f"lean debug info is set ({why} does not remove it: delete the lines by hand)")]
        return [("off", shown, "lean debug info: off (opt-in; RUST_LEAN_DEBUGINFO=yes in ~/" + CONF_REL
                 + f", or config apply --lean-debuginfo); {LEAN_REBUILD}")]
    out = [("keep", shown, c) for c in st["conflicts"]]
    if not st["add"]:
        if not st["conflicts"]:
            out.append(("ok", shown, f"lean debug info set ({why})"))
        return out
    what = "; ".join(b.replace("\n", " ").strip() for _, b in st["add"])
    if st["append"]:
        out.append(("write", shown, f"lean debug info ({why}): {what}; {LEAN_REBUILD}"
                    + ("" if verb == "plan" else f" (missing: {PROG} config apply)")))
    else:
        out.append(("BY HAND", shown, f"lean debug info ({why}): the file already has these tables: add "
                                      f"yourself: {what}"))
    return out


def lean_apply(home, settings, lean):
    want, why = lean_wanted(settings, lean)
    if not want:
        return 0
    st = lean_state(home)
    path = st["path"]
    if st["error"]:
        say(f"{NAME}: lean debug info: {path} {st['error']}: left as it is", 3, err=True)
        return 1
    for c in st["conflicts"]:
        say(f"NOTE: lean debug info: {path}: {c}", 5, err=True)
    if not st["add"]:
        if not st["conflicts"]:
            say(f"kept:      {path} (lean debug info already set)")
        return 0
    if not st["append"]:
        say(f"NOTE: lean debug info: {path} already has these tables: add by hand:", 5, err=True)
        for _, block in st["add"]:
            for line in block.splitlines():
                say(f"      {line}", 5, err=True)
        return 0
    err = append_text(path, st["append"])
    if err:
        say(f"{NAME}: cannot write {path}: {err}: left as it is", 3, err=True)
        return 1
    say(f"written:   {path} (lean debug info, {why}; the next dev build of each workspace compiles everything once)")
    return 0


# The opt-in sccache item. Off unless RUST_SCCACHE=yes (or config apply
# --sccache): a small wrapper (toolchains/rustc-wrapper, copied to
# ~/.local/libexec/cst/) named as rustc-wrapper in [build] of
# ~/.cargo/config.toml hands rustc to sccache. Unlike lean debug info,
# --no-sccache removes CST's line again: a wrapper left behind is riskier
# than a debug setting. RUST_SCCACHE=no alone never removes it.
WRAPPER_NAME = "rustc-wrapper"
WRAPPER_REL = ".local/libexec/cst/rustc-wrapper"
SCCACHE_DIR_REL = ".cache/sccache"
SCCACHE_DEFAULT_SIZE = "25G"
SCCACHE_HEAD = ("# Added by toolchains-setup.sh (CST) for RUST_SCCACHE=yes: rustc goes through "
                "sccache (~/.cache/sccache).")
SCCACHE_SIZE_LINE = re.compile(r"(?m)^cache_size=\S*(?= # cst: RUST_SCCACHE_CACHE_SIZE)")
SCCACHE_REBUILD = ("turning it on rebuilds nothing: the cache fills as crates are compiled anew "
                   "(a new worktree, cargo update, a new toolchain)")
BUILD_HEADER = re.compile(rf"^{_WS}*\[{_WS}*build{_WS}*\]{_WS}*(?:#.*)?$", re.M)
KEY_LINE = re.compile(rf"^{_WS}*[A-Za-z0-9_.\"'-]+{_WS}*=", re.M)
ANY_HEADER = re.compile(rf"^{_WS}*\[", re.M)
SCCACHE_STATS = re.compile(r"^(Compile requests|Cache hits|Cache misses|Cache size|Max cache size)\s{2,}(\S.*?)\s*$",
                           re.M)


def wrapper_path(home):
    return os.path.join(home, WRAPPER_REL)


def wrapper_text(size):
    """The wrapper as installed (the cache size written in), or None when its
    source is not next to this program (the timer's copy has none)."""
    try:
        text = read_text(os.path.join(os.path.dirname(os.path.realpath(__file__)), WRAPPER_NAME))
    except OSError:
        return None
    new, n = SCCACHE_SIZE_LINE.subn(f"cache_size={size}", text, count=1)
    return new if n == 1 else None


def wrapper_state(home, text):
    """ok | change | missing | conflict (not CST's, or a symlink)."""
    path = wrapper_path(home)
    st = file_state(path, text)
    if st == "ok":
        try:
            if stat.S_IMODE(os.stat(path).st_mode) != 0o755:
                st = "change"
        except OSError:
            st = "change"
    return st


def sccache_size(settings):
    return settings.options["RUST_SCCACHE_CACHE_SIZE"] if settings else SCCACHE_DEFAULT_SIZE


def plain(data):
    return json.loads(json.dumps(data))


def parses_as(text, expect):
    try:
        return plain(tomllib.loads(text)) == expect
    except tomllib.TOMLDecodeError:
        return False


def sccache_state(home):
    """{path, error, value (build.rustc-wrapper now, or None), ours, add,
    remove}: add / remove are the whole new file text, '' when CST cannot
    make that change safely (each candidate is parsed again and must equal
    the file with only that one key added or removed)."""
    path = os.path.join(home, CARGO_CFG_REL)
    st = {"path": path, "error": "", "value": None, "ours": False, "add": "", "remove": ""}
    text = read_cfg(path)
    if text is None:
        st["error"] = "cannot be read"
        return st
    try:
        data = plain(tomllib.loads(text))
    except tomllib.TOMLDecodeError as e:
        st["error"] = f"is not valid TOML ({e})"
        return st
    want = wrapper_path(home)
    build = data.get("build")
    if build is not None and not isinstance(build, dict):
        return st                                   # build = 1: no add, no remove
    value = (build or {}).get("rustc-wrapper")
    st["value"], st["ours"] = value, value == want
    keyline = f"rustc-wrapper = {json.dumps(want)}"
    if value is None:
        expect = plain(data)
        expect.setdefault("build", {})["rustc-wrapper"] = want
        headers = list(BUILD_HEADER.finditer(text))
        cands = []
        if len(headers) == 1:
            h = headers[0]
            nxt = ANY_HEADER.search(text, h.end())
            section_end = nxt.start() if nxt else len(text)
            keys = list(KEY_LINE.finditer(text, h.end(), section_end))
            # After the table's last key (the build-dir line CST writes),
            # else right after the header.
            spots = ([text.find("\n", keys[-1].start())] if keys else []) + [h.end()]
            for pos in spots:
                if pos < 0:
                    pos = len(text)
                rest = text[pos:]
                cands.append(text[:pos] + "\n" + SCCACHE_HEAD + "\n" + keyline + (rest if rest else "\n"))
        elif not headers:
            sep = "" if not text or text.endswith("\n") else "\n"
            cands.append(text + sep + ("\n" if text else "") + SCCACHE_HEAD + "\n[build]\n" + keyline + "\n")
        st["add"] = next((c for c in cands if parses_as(c, expect)), "")
    elif st["ours"]:
        lines = text.splitlines(keepends=True)
        pat = re.compile(rf"{_WS}*rustc-wrapper{_WS}*={_WS}*{re.escape(json.dumps(want))}{_WS}*(?:#.*)?\n?\Z")
        idx = [i for i, ln in enumerate(lines) if pat.match(ln)]
        if len(idx) == 1:
            i = idx[0]
            drop = {i}
            if i > 0 and lines[i - 1].startswith(SCCACHE_HEAD[:48]):
                drop.add(i - 1)
            # CST's own appended block (a [build] header whose own section
            # holds only this key; [build.x] subtables may follow): all of it.
            after = []
            for ln in lines[i + 1:]:
                if ANY_HEADER.match(ln):
                    break
                after.append(ln)
            if (i > 1 and BUILD_HEADER.match(lines[i - 1].rstrip("\r\n")) and lines[i - 2].startswith(SCCACHE_HEAD[:48])
                    and not any(KEY_LINE.match(ln) for ln in after)):
                drop |= {i - 1, i - 2}
                if i > 2 and not lines[i - 3].strip():
                    drop.add(i - 3)
            new = "".join(ln for n, ln in enumerate(lines) if n not in drop)
            expect = plain(data)
            del expect["build"]["rustc-wrapper"]
            alt = {k: v for k, v in expect.items() if not (k == "build" and v == {})}
            if parses_as(new, expect) or parses_as(new, alt):
                st["remove"] = new
    return st


def sccache_wanted(settings, flag):
    if flag is not None:
        return flag, ("--sccache" if flag else "--no-sccache")
    if settings is None:
        return False, "bad settings"
    return settings.options["RUST_SCCACHE"], "RUST_SCCACHE=" + ("yes" if settings.options["RUST_SCCACHE"] else "no")


def wrapper_lines(home, verb, text, size):
    shown = tilde(wrapper_path(home), home)
    if text is None:
        return [("?", shown, f"sccache wrapper: its source ({WRAPPER_NAME} next to this program) is missing: "
                             f"run {PROG} config apply from CST")]
    st = wrapper_state(home, text)
    if st == "ok":
        return [("ok", shown, f"sccache wrapper up to date (cache size {size})")]
    if st == "conflict":
        return [("keep", shown, "not CST's file (or a symlink): left alone, so CST writes no rustc-wrapper line")]
    return [("write", shown, f"sccache wrapper ({'missing' if st == 'missing' else 'outdated'}; cache size {size})"
             + ("" if verb == "plan" else f" (fix: {PROG} config apply)"))]


def sccache_lines(home, verb, settings, flag):
    st = sccache_state(home)
    shown = tilde(st["path"], home)
    want, why = sccache_wanted(settings, flag)
    size = sccache_size(settings)
    off = (f"sccache: off (opt-in; RUST_SCCACHE=yes in ~/{CONF_REL}, or config apply --sccache); "
           f"{SCCACHE_REBUILD}")
    if st["error"]:
        return [("?", shown, f"sccache: the file {st['error']}")]
    foreign = st["value"] is not None and not st["ours"]
    yours = f"rustc-wrapper = {json.dumps(st['value'])} is yours: left as it is"
    if flag is False:
        if st["ours"]:
            if st["remove"]:
                return [("remove", shown, f"sccache: CST's rustc-wrapper line ({why}); {SCCACHE_REBUILD}; "
                                          f"~/{WRAPPER_REL} stays (unused, harmless)")]
            return [("BY HAND", shown, f"sccache ({why}): CST cannot remove its rustc-wrapper line safely: "
                                       f"delete it yourself")]
        return [("keep", shown, f"sccache ({why}): {yours}")] if foreign else [("off", shown, "sccache: off")]
    text = wrapper_text(size)
    if not want:
        if st["ours"]:
            out = [("on", shown, f"sccache is on (CST's rustc-wrapper; {why} does not remove it: "
                                 f"{PROG} config apply --no-sccache does)")]
            return out + [ln for ln in wrapper_lines(home, verb, text, size) if ln[0] != "ok"]
        return [("off", shown, off + (f"; {yours}" if foreign else ""))]
    if foreign:
        return [("keep", shown, f"sccache ({why}): {yours} (CST never overwrites it)")]
    out = wrapper_lines(home, verb, text, size)
    if st["ours"]:
        out.append(("ok", shown, f"sccache: rustc-wrapper set ({why})"))
    elif st["add"]:
        out.append(("write", shown, f"sccache ({why}): [build] rustc-wrapper = \"~/{WRAPPER_REL}\"; {SCCACHE_REBUILD}"
                    + ("" if verb == "plan" else f" (missing: {PROG} config apply)")))
    else:
        out.append(("BY HAND", shown, f"sccache ({why}): CST cannot add the key safely here: put "
                                      f"rustc-wrapper = \"{wrapper_path(home)}\" into [build] yourself"))
    return out


def write_cfg(path, text):
    """Replace a config file's text (atomic, same mode). '' or the error."""
    real = os.path.realpath(path)
    try:
        mode = stat.S_IMODE(os.stat(real).st_mode)
    except OSError:
        mode = 0o644
    try:
        write_atomic(real, text, mode)
    except OSError as e:
        return str(e.strerror or e)
    return ""


def install_wrapper(home, size):
    """0 when the wrapper is in place (written or unchanged), else 1."""
    text = wrapper_text(size)
    path = wrapper_path(home)
    if text is None:
        say(f"{NAME}: sccache: {WRAPPER_NAME} is missing next to this program: run {PROG} config apply from CST",
            3, err=True)
        return 1
    st = wrapper_state(home, text)
    if st == "conflict":
        say(f"{NAME}: sccache: {path} is not CST's file (or a symlink): left alone", 3, err=True)
        return 1
    if st == "ok":
        say(f"kept:      {path} (sccache wrapper)")
        return 0
    try:
        write_atomic(path, text, 0o755)
    except OSError as e:
        say(f"{NAME}: cannot write {path}: {e.strerror or e}", 3, err=True)
        return 1
    say(f"written:   {path} (sccache wrapper, cache size {size})")
    return 0


def sccache_apply(home, settings, flag):
    want, why = sccache_wanted(settings, flag)
    st = sccache_state(home)
    path = st["path"]
    if st["error"]:
        if want or flag is False or st["ours"]:
            say(f"{NAME}: sccache: {path} {st['error']}: left as it is", 3, err=True)
            return 1
        return 0
    if flag is False:
        if not st["ours"]:
            return 0
        if not st["remove"]:
            say(f"NOTE: sccache: {path}: CST cannot remove its rustc-wrapper line safely: delete it yourself",
                5, err=True)
            return 0
        err = write_cfg(path, st["remove"])
        if err:
            say(f"{NAME}: cannot write {path}: {err}: left as it is", 3, err=True)
            return 1
        say(f"removed:   {path} (CST's rustc-wrapper line, {why}; ~/{WRAPPER_REL} stays, unused)")
        return 0
    if not want:
        # The line is there (set earlier): keep its wrapper current, so cargo
        # never names a missing program.
        return install_wrapper(home, sccache_size(settings)) if st["ours"] else 0
    if st["value"] is not None and not st["ours"]:
        say(f"NOTE: sccache: {path}: rustc-wrapper = {json.dumps(st['value'])} is yours: left as it is "
            f"(sccache not set up)", 5, err=True)
        return 0
    # The wrapper first: the line must never name a missing program.
    if install_wrapper(home, sccache_size(settings)):
        return 1
    if st["ours"]:
        say(f"kept:      {path} (rustc-wrapper already set)")
        return 0
    if not st["add"]:
        say(f"NOTE: sccache: {path}: CST cannot add the key safely: put this into [build] by hand:", 5, err=True)
        say(f"      rustc-wrapper = {json.dumps(wrapper_path(home))}", 5, err=True)
        return 0
    err = write_cfg(path, st["add"])
    if err:
        say(f"{NAME}: cannot write {path}: {err}: left as it is", 3, err=True)
        return 1
    say(f"written:   {path} (rustc-wrapper, {why}: rustc goes through sccache where it is on PATH)")
    return 0


def sccache_sockets(home):
    """The per-environment server sockets the wrapper names (all
    environments share $XDG_RUNTIME_DIR, or the fallback folder)."""
    dirs = []
    xdg = os.environ.get("XDG_RUNTIME_DIR", "")
    if xdg and os.path.isdir(xdg):
        dirs.append(xdg)
    dirs.append(os.path.join(home, SCCACHE_DIR_REL, "run"))
    out = []
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        out += [os.path.join(d, n) for n in names if n.startswith("cst-sccache-") and n.endswith(".sock")]
    return out


def socket_answers(path):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1)
    try:
        s.connect(path)
        return True
    except OSError:
        return False
    finally:
        s.close()


def sccache_status_lines(home):
    """The cache's size and, with sccache on this PATH, one line of stats
    per running server (status runs on the host: its PATH)."""
    cache = os.path.join(home, SCCACHE_DIR_REL)
    out = []
    if os.path.isdir(cache):
        out.append(f"sccache cache: {where_text(cache, home)} {gib(tree_size(cache))} (sccache keeps it under "
                   f"its size cap itself, least recently used first; ~/.cache is not in /home snapshots)")
    else:
        out.append(f"sccache cache: ~/{SCCACHE_DIR_REL} not there yet")
    exe = shutil.which("sccache") or ""
    if not exe:
        # `cargo install sccache` lands in ~/.cargo/bin, which a PATH may lack.
        ch = os.environ.get("CARGO_HOME", "")
        c = os.path.join(ch if os.path.isabs(ch) else os.path.join(home, ".cargo"), "bin", "sccache")
        exe = c if os.access(c, os.X_OK) else ""
    socks = [p for p in sccache_sockets(home) if socket_answers(p)]
    if not exe:
        if socks:
            out.append(f"sccache servers running: {len(socks)} (no sccache on the host's PATH to ask them)")
        return out
    if not socks:
        out.append("sccache: no server running (each environment starts its own on its first build)")
    for sock in socks:
        env_id = os.path.basename(sock)[len("cst-sccache-"):-len(".sock")]
        env = {k: v for k, v in os.environ.items() if not k.startswith("SCCACHE_")}
        env.update(SCCACHE_SERVER_UDS=sock, NO_COLOR="1")
        try:
            r = subprocess.run([exe, "--show-stats"], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, text=True, timeout=5)
            stats = dict(SCCACHE_STATS.findall(r.stdout)) if r.returncode == 0 else {}
        except (OSError, subprocess.TimeoutExpired):
            stats = {}
        if not stats:
            out.append(f"sccache server {env_id}: no answer")
            continue
        shown = ", ".join(f"{k.lower()} {stats[k]}" for k in
                          ("Compile requests", "Cache hits", "Cache misses", "Cache size", "Max cache size")
                          if k in stats)
        out.append(f"sccache server {env_id}: {shown}")
    return out


def config_lines(home, verb, settings=None, lean=None, sccache=None):
    """The plan or status lines of the settings (lean, sccache: the explicit
    flags)."""
    out = []
    for name, path, st, _ in config_items(home):
        shown = tilde(path, home)
        if name == "cargo":
            if st == "set":
                if cargo_build_dir_is_csts(home):
                    out.append(("ok", shown, "build-dir = CST's line (rust:build prunes that folder)"))
                else:
                    out.append(("keep", shown, "build-dir set to your own value: left as it is "
                                               "(rust:build then prunes nothing)"))
            elif st == "by-hand":
                out.append(("BY HAND", shown, f"has a [build] table: add build-dir = "
                                              f"\"{home}/{ROOT_REL}/{HASH_VAR}\" there yourself"))
            elif st == "write":
                out.append(("write", shown, f"[build] build-dir = \"~/{ROOT_REL}/{HASH_VAR}\"" +
                            ("" if verb == "plan" else f" (missing: {PROG} config apply)")))
            else:
                out.append(("?", shown, "cannot be read"))
        else:
            if st == "set":
                out.append(("ok", shown, "link-mode already set"))
            elif st == "by-hand":
                out.append(("BY HAND", shown, "has tables: add link-mode = \"clone\" at its top yourself"))
            elif st == "write":
                out.append(("write", shown, "link-mode = \"clone\" (hardlinks cannot cross subvolumes)" +
                            ("" if verb == "plan" else f" (missing: {PROG} config apply)")))
            else:
                out.append(("?", shown, "cannot be read"))
    out += lean_lines(home, verb, settings, lean)
    out += sccache_lines(home, verb, settings, sccache)
    return out


def append_text(path, text):
    """Append TEXT to PATH (made if missing); a file not ending in a newline
    gets one first. Returns '' or the error."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "ab") as f:
            # A file not ending in a newline would glue the comment onto its last line.
            if f.tell() > 0:
                with open(path, "rb") as r:
                    r.seek(-1, os.SEEK_END)
                    if r.read(1) != b"\n":
                        f.write(b"\n")
            f.write(text.encode("utf-8"))
    except OSError as e:
        return str(e.strerror or e)
    return ""


def cmd_config(home, action, lean=None, sccache=None):
    try:
        settings = Settings(home)
    except ConfigError as e:
        settings = None
        off = [w for w, flag in (("lean debug info", lean), ("sccache", sccache)) if flag is None]
        if off:
            say(f"note: BAD SETTINGS ({e}): {' and '.join(off)} treated as off", 4, err=True)
    if action == "plan":
        lines = config_lines(home, "plan", settings, lean, sccache)
        for st, shown, note in lines:
            say(f"  {st:<8} {shown:<24} {note}")
        if any(st in ("write", "remove") for st, _, _ in lines):
            flags = {True: " --lean-debuginfo", False: " --no-lean-debuginfo"}.get(lean, "")
            flags += {True: " --sccache", False: " --no-sccache"}.get(sccache, "")
            say(f"Apply with: {PROG} config apply" + flags)
        return 0
    rc = 0
    for name, path, st, text in config_items(home):
        if st == "unreadable":
            say(f"{NAME}: cannot read {path}: left as it is", 3, err=True)
            rc = 1
        elif name == "cargo" and st == "set":
            say(f"kept:      {path} (build-dir already set)")
        elif name == "cargo" and st == "by-hand":
            say(f"NOTE: {path} already configures [build]: add there by hand:", 5, err=True)
            say(f"      build-dir = \"{home}/{ROOT_REL}/{HASH_VAR}\"", 5, err=True)
        elif name == "uv" and st == "set":
            say(f"kept:      {path} (link-mode already set)")
        elif name == "uv" and st == "by-hand":
            say(f"NOTE: {path} has tables: add link-mode = \"clone\" at its top by hand", 5, err=True)
        else:
            err = append_text(path, text)
            if err:
                # For example a ~/.cargo owned by root after a `sudo cargo`:
                # report it and go on with the other setting.
                say(f"{NAME}: cannot write {path}: {err}: left as it is", 3, err=True)
                rc = 1
                continue
            say(f"written:   {path}")
    rc = max(rc, lean_apply(home, settings, lean))
    return max(rc, sccache_apply(home, settings, sccache))


# ---- status ---------------------------------------------------------------------------------
def cmd_status(home, now, brief):
    say(f"auto: {timer_text(home)}")
    try:
        settings = Settings(home)
    except ConfigError as e:
        settings = None
        say(f"BAD SETTINGS: {e} (prune and the timer do nothing until it is fixed)")
    for tid, cls in TARGETS.items():
        s = read_state(home, tid)
        last = cls.last_run_text(s) if s else "none recorded"
        if brief:
            say(f"{tid}: last prune: {last}")
            continue
        say(f"== {tid}: {cls.WHAT}")
        t = cls(home, now, settings.policy[tid] if settings else None)
        say(f"  where:    {where_text(t.location(), home)}")
        if settings:
            state = "enabled" if settings.enabled[tid] else "disabled (prune runs it only when named)"
            say(f"  policy:   {state}; {cls.policy_text(settings.policy[tid])} ({settings.source_of(cls)})")
        else:
            say("  policy:   BAD SETTINGS (see above)")
        say(f"  last prune: {last}")
        for line in t.status_lines():
            say(f"  {line}")
    if brief:
        return 0
    say("== not implemented yet (nothing pruned there by CST):")
    for tid, (where, how) in PLANNED.items():
        shown = ", ".join(where_text(os.path.join(home, p.strip()[2:]), home) for p in where.split(","))
        say(f"  {tid:<14} {shown} ({how})")
    say("== rust toolchains (a report: CST never removes one)")
    for line in toolchain_lines(home):
        say(f"  {line}")
    say(f"== toolchain settings ({PROG} config)")
    for st, shown, note in config_lines(home, "status", settings):
        say(f"  {st:<8} {shown:<24} {note}")
    for line in sccache_status_lines(home):
        say(f"  {line}")
    st = unit_states(home)
    say("== files of auto on: " + ", ".join(f"{label(k)} {v}" for k, v in st.items()))
    for path, ours in stale_files(home):
        say(f"  stale: {tilde(path, home)} (of the earlier `cst btrfs cargo-gc`"
            + ("; auto on or auto off removes it)" if ours else "; not CST's: left alone)"))
    old_conf_note(home)
    return 0


# ---- main -----------------------------------------------------------------------------------
def run_locked(home, fn):
    """One run at a time (the timer and a manual apply, auto on/off)."""
    path = os.path.join(home, STATE_DIR_REL, "toolchains.lock")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            say("another run is in progress: nothing done", 5)
            return 0
        return fn()
    finally:
        os.close(fd)


USAGE = """\
usage: cst-toolchains status [--brief]
       cst-toolchains prune plan|apply [TARGET...]
       cst-toolchains auto on [--unless-off] | auto off
       cst-toolchains config plan|apply [--lean-debuginfo | --no-lean-debuginfo] [--sccache | --no-sccache]
       (each also takes --home DIR; help: cst-toolchains help)"""


def parse_args(argv):
    """{cmd, action, targets, brief, unless_off, home}; raises Usage."""
    args, home = [], None
    it = iter(argv)
    for a in it:
        if a == "--home":
            home = next(it, None)
            if not home:
                raise Usage("--home needs a folder")
        elif a.startswith("--home="):
            home = a.split("=", 1)[1]
            if not home:      # an empty value must never mean "your real home"
                raise Usage("--home needs a folder")
        else:
            args.append(a)
    out = {"cmd": "help", "action": None, "targets": [], "brief": False, "unless_off": False, "home": home,
           "lean": None, "sccache": None}
    if not args or args[0] in ("help", "-h", "--help"):
        return out
    cmd, rest = args[0], args[1:]
    out["cmd"] = cmd
    if cmd == "status":
        for a in rest:
            if a != "--brief":
                raise Usage(f"status: unknown argument '{a}' (only --brief)")
            out["brief"] = True
    elif cmd == "prune":
        if not rest or rest[0] not in ("plan", "apply"):
            raise Usage("prune: plan or apply, then the targets (none: every enabled one)")
        out["action"] = rest[0]
        for a in rest[1:]:
            if a.startswith("-"):
                raise Usage(f"prune: unknown option '{a}'")
            out["targets"].append(a)
    elif cmd == "auto":
        if not rest or rest[0] not in ("on", "off"):
            raise Usage("auto: on or off")
        out["action"] = rest[0]
        for a in rest[1:]:
            if a == "--unless-off" and rest[0] == "on":
                out["unless_off"] = True
            else:
                raise Usage(f"auto {rest[0]}: unknown argument '{a}'")
    elif cmd == "config":
        if not rest or rest[0] not in ("plan", "apply"):
            raise Usage("config: plan or apply [--lean-debuginfo | --no-lean-debuginfo] [--sccache | --no-sccache]")
        out["action"] = rest[0]
        for a in rest[1:]:
            if a in ("--lean-debuginfo", "--no-lean-debuginfo") and out["lean"] is None:
                out["lean"] = a == "--lean-debuginfo"
            elif a in ("--sccache", "--no-sccache") and out["sccache"] is None:
                out["sccache"] = a == "--sccache"
            else:
                raise Usage(f"config {rest[0]}: unknown argument '{a}'")
    else:
        raise Usage(f"unknown command '{cmd}'")
    return out


def main(argv):
    try:
        a = parse_args(argv)
    except Usage as e:
        print(f"{NAME}: {e}\n{USAGE}", file=sys.stderr)
        return 2
    if a["cmd"] == "help":
        print(__doc__)
        return 0
    if os.getuid() == 0:
        print(f"{NAME}: run as your user, not as root", file=sys.stderr)
        return 1
    if in_container() and not os.environ.get("CST_TOOLCHAINS_HERE"):
        # From a toolbox, the processes of other containers cannot be
        # inspected: the same program runs on the host (same home path).
        me = os.path.realpath(__file__)
        try:
            os.execvp("flatpak-spawn", ["flatpak-spawn", "--host", f"--env=CST_PROG={PROG}",
                                        "/usr/bin/python3", "-I", me, *argv])
        except OSError as e:
            print(f"{NAME}: cannot run on the host (flatpak-spawn: {e.strerror}); "
                  f"run it on the host", file=sys.stderr)
            return 1
    home = os.path.abspath(pwd.getpwuid(os.getuid()).pw_dir if a["home"] is None else a["home"])
    now = float(os.environ.get("CST_TOOLCHAINS_NOW") or time.time())   # override: tests
    cmd, action = a["cmd"], a["action"]
    try:
        if cmd == "status":
            return cmd_status(home, now, a["brief"])
        if cmd == "config":
            return cmd_config(home, action, a["lean"], a["sccache"])
        if cmd == "prune" and action == "plan":
            return cmd_prune(home, now, "plan", a["targets"])
        if cmd == "prune":
            return run_locked(home, lambda: cmd_prune(home, now, "apply", a["targets"]))
        if action == "on":
            return run_locked(home, lambda: cmd_auto_on(home, now, a["unless_off"]))
        return run_locked(home, lambda: cmd_auto_off(home, now))
    except Usage as e:
        print(f"{NAME}: {e}\n{USAGE}", file=sys.stderr)
        return 2
    except (Refused, ConfigError) as e:
        say(f"{NAME}: {e}", 3, err=True)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
