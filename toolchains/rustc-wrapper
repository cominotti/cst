#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# managed-by: toolchains-setup.sh (CST): cargo's rustc-wrapper for RUST_SCCACHE=yes.
#
# `cst toolchains config apply --sccache` copies this file to
# ~/.local/libexec/cst/rustc-wrapper and names it in ~/.cargo/config.toml
# ([build] rustc-wrapper). Cargo then runs every compiler call as
#     rustc-wrapper <compiler> <arguments...>
# It hands rustc to sccache, so crates already compiled in another worktree
# (mostly registry dependencies) come from ~/.cache/sccache instead of being
# compiled again. Edits here are overwritten by the next config apply.
#
# Straight to the compiler (no sccache), always:
#   - sccache is not on PATH (this toolbox lacks it): never a failed build;
#   - the compiler is not named rustc (kani-compiler, clippy-driver as
#     RUSTC_WORKSPACE_WRAPPER, anything else);
#   - CST_SCCACHE=0 (for one build: CST_SCCACHE=0 cargo build);
#   - a local crate (a workspace member or a path dependency) when
#     RUST_SCCACHE_WORKSPACE=no is written in below, or CST_SCCACHE_WORKSPACE=0
#     is set (1 sends them through again). Cargo passes --cap-lints to every
#     dependency from a registry or git (vendored ones too) and never to a
#     path package, so "no --cap-lints" is a local crate. Their sccache keys
#     hold the worktree's own paths, so other worktrees never hit them;
#   - an incremental compile (-C incremental=...): sccache cannot cache it.
#
# Stable, for build scripts that rely on it: a first argument not named rustc
# always runs directly (RUSTC_WORKSPACE_WRAPPER as a passthrough keeps working).
#
# Set only when unset (yours win): SCCACHE_DIR=~/.cache/sccache,
# SCCACHE_CACHE_SIZE (RUST_SCCACHE_CACHE_SIZE, written in below),
# SCCACHE_IGNORE_SERVER_IO_ERROR=1 (a broken server: compile locally), and
# the server's address. The host and every toolbox share $HOME and the
# network: one sccache server on 127.0.0.1:4226 would run the compilers of
# another environment. So each environment gets its own unix socket,
# $XDG_RUNTIME_DIR/cst-sccache-<toolbox name or host>.sock.
#
# Always set for sccache (not only when unset): TMPDIR=/tmp, the value a caller
# without TMPDIR already gets. When no server answers, the sccache client
# starts one, and that server keeps the client's TMPDIR for its own temporary
# folders for as long as it runs. A build run with a private TMPDIR that is
# deleted afterwards (a temporary scope, a test harness) would leave a server
# whose every later compile fails with "Failed to create temp dir"; a TMPDIR
# too long for a unix socket path would fail the first compile ("path must be
# shorter than SUN_LEN"). This holds with your own SCCACHE_SERVER_UDS or port
# too. sccache hands the client's environment to rustc, so rustc's own
# temporary files go to /tmp too. Compiles that go straight to the compiler
# (the list above) keep the caller's TMPDIR. A server started by an older copy
# of this wrapper keeps its TMPDIR until it stops (after 10 minutes without
# work, or `sccache --stop-server` with the same SCCACHE_SERVER_UDS).
#
# The server in a scope of its own. A server the sccache client starts stays in
# the cgroup of the compile that started it, and runs every later compile of
# the environment there: in a temporary scope with a memory cap, the shared
# server and every build that uses it share that cap (an OOM kill, reclaim, the
# memory counted against that build) until the server stops. So when the
# wrapper picked the socket itself (above) and the server's scope is missing,
# it starts the server first, under the user manager, in
# cst-sccache-<toolbox name or host>.scope: in the inner user.slice inside a
# toolbox (next to the toolboxes, with their CPUs and weight), in app.slice on
# the host. A lock file next to the socket makes parallel compiles start one
# server; the socket is removed first, so "the scope's folder and the socket
# exist" means a server has started there. Each compile checks that with shell
# builtins only (the folder comes from /proc/self/cgroup); only a missing
# server costs flock and systemd-run. Without a user manager above the compile
# (an ssh session, docker exec), without the user manager's socket
# ($XDG_RUNTIME_DIR/systemd/private, what systemd-run --user connects to),
# systemd-run or flock, with your own SCCACHE_SERVER_UDS or port, or when the
# start fails, the client starts the server as before.

cache_size=25G # cst: RUST_SCCACHE_CACHE_SIZE (config apply writes the setting here)
workspace=yes # cst: RUST_SCCACHE_WORKSPACE (config apply writes the setting here)

case "${1##*/}" in
    rustc) ;;
    *) exec "$@" ;;
esac
[ "${CST_SCCACHE:-}" = 0 ] && exec "$@"
case "${CST_SCCACHE_WORKSPACE:-}" in
    0) workspace=no ;;
    1) workspace=yes ;;
esac
local_crate=yes
for a in "$@"; do
    case "$a" in
        incremental=* | -Cincremental=*) exec "$@" ;;
        --cap-lints | --cap-lints=*) local_crate=no ;;
    esac
done
[ "$workspace" = no ] && [ "$local_crate" = yes ] && exec "$@"
command -v sccache >/dev/null 2>&1 || exec "$@"

[ -n "${HOME:-}" ] || exec "$@"
export SCCACHE_DIR="${SCCACHE_DIR:-${HOME}/.cache/sccache}"
export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-${cache_size}}"
export SCCACHE_IGNORE_SERVER_IO_ERROR="${SCCACHE_IGNORE_SERVER_IO_ERROR:-1}"

# sccache up to 0.19 stops with an error when CARGO_INCREMENTAL=1 (or
# CARGO_BUILD_INCREMENTAL=1) is set, even for crates cargo compiles without
# incremental; later releases accept SCCACHE_ALLOW_INCREMENTAL=1. rustc
# itself never reads these variables (cargo turns them into -C incremental,
# handled above), so they are dropped for sccache.
if [ "${CARGO_INCREMENTAL:-}" = 1 ] || [ "${CARGO_BUILD_INCREMENTAL:-}" = 1 ]; then
    export SCCACHE_ALLOW_INCREMENTAL=1
    unset CARGO_INCREMENTAL CARGO_BUILD_INCREMENTAL
fi

own_address=no
if [ -z "${SCCACHE_SERVER_UDS:-}" ] && [ -z "${SCCACHE_SERVER_PORT:-}" ]; then
    own_address=yes
    env_id=host
    containerenv="${CST_SCCACHE_CONTAINERENV:-/run/.containerenv}"
    if [ -f "$containerenv" ]; then
        env_id=container
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                name=*)
                    line="${line#name=}"
                    line="${line#\"}"
                    line="${line%\"}"
                    [ -n "$line" ] && env_id="$line"
                    break
                    ;;
            esac
        done <"$containerenv"
        # Only letters, digits, dot, dash and underscore in a file name.
        case "$env_id" in
            *[!A-Za-z0-9._-]*) env_id=container ;;
        esac
    fi
    run_dir="${XDG_RUNTIME_DIR:-}"
    if [ -z "$run_dir" ] || [ ! -d "$run_dir" ] || [ ! -w "$run_dir" ]; then
        run_dir="${SCCACHE_DIR}/run"
        if [ ! -d "$run_dir" ]; then
            { mkdir -p "$run_dir" && chmod 700 "$run_dir"; } 2>/dev/null || exec "$@"
        fi
    fi
    export SCCACHE_SERVER_UDS="${run_dir}/cst-sccache-${env_id}.sock"
fi

# A server this client starts must not keep the caller's TMPDIR (see the top).
export TMPDIR=/tmp

# The server in its own scope (see the top). Builtins only, up to the cold start.
if [ "$own_address" = yes ]; then
    cgroup=
    proc_cgroup="${CST_SCCACHE_PROC_CGROUP:-/proc/self/cgroup}"
    if [ -r "$proc_cgroup" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                0::/*)
                    cgroup="${line#0::}"
                    break
                    ;;
            esac
        done <"$proc_cgroup"
    fi
    # /user.slice/user-1000.slice/user@1000.service/<anything>: the folder of
    # the user manager is everything up to its user@<uid>.service segment.
    above="${cgroup%%/user@*}"
    manager="${cgroup#"$above"/}"
    manager="${manager%%/*}"
    uid="${manager#user@}"
    uid="${uid%.service}"
    case "$manager:$uid" in
        user@*.service:*[!0-9]* | *:) ;;
        user@*.service:*)
            slice=user.slice
            [ "$env_id" = host ] && slice=app.slice
            scope="cst-sccache-${env_id}.scope"
            manager_dir="${CST_SCCACHE_CGROUP_FS:-/sys/fs/cgroup}${above}/${manager}"
            scope_dir="${manager_dir}/${slice}/${scope}"
            if [ -d "$manager_dir" ] && { [ ! -d "$scope_dir" ] || [ ! -S "$SCCACHE_SERVER_UDS" ]; } &&
                [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/systemd/private" ] &&
                command -v systemd-run >/dev/null 2>&1 && command -v flock >/dev/null 2>&1; then
                # The lock is held until --start-server returns (the server
                # listens); the server never gets its descriptor (9>&-).
                {
                    if flock -w 15 9 && { [ ! -d "$scope_dir" ] || [ ! -S "$SCCACHE_SERVER_UDS" ]; }; then
                        rm -f "$SCCACHE_SERVER_UDS"
                        systemd-run --user --scope --quiet --collect --unit="$scope" --slice="$slice" \
                            --description="CST: the shared sccache server ($env_id)" \
                            sccache --start-server 9>&-
                    fi
                } 9>>"${SCCACHE_SERVER_UDS}.lock" </dev/null >/dev/null 2>&1
            fi
            ;;
    esac
fi
exec sccache "$@"
